---
/**
 * One of the form's four numbered sections: `01` beside a title, a supporting
 * line, and the controls beneath.
 *
 *   <QuoteSection id="need" number="01">…controls…</QuoteSection>
 *
 * It exists because all four steps want the same three things — the number,
 * the rhythm and the hairline between them — and because below 900px this
 * element is what becomes a *step*: `data-section` is the handle
 * `scripts/quote/form.ts` will show and hide one at a time, and having it in
 * one place is what stops four step components each growing their own.
 *
 * Not in the file tree §15.2 planned; it turned up the moment step 01 was
 * assembled, the same way `ui/Dropdown.astro` did in slice 1.
 *
 * The number is a prop rather than derived, because the order of the four
 * steps is `QuoteForm`'s decision and no step should be able to contradict it
 * (docs/site-expansion/14 §15.6).
 */
import { SECTIONS } from "@/lib/quote/options";
import { scopedId } from "@/lib/forms";
import type { SectionId } from "@/lib/quote/schema";

interface Props {
  id: SectionId;
  /** Per-instance id prefix — two forms on one page must not collide. */
  instance: string;
  /** `01`–`04`, as the form orders them. */
  number: string;
  class?: string;
}

const { id, instance, number, class: extra = "" } = Astro.props;

const { title, hint } = SECTIONS[id];
const titleId = scopedId(instance, "section", id);
---

<section
  class:list={["q-section", extra]}
  data-section={id}
  aria-labelledby={titleId}
>
  {
    /* Number and title pin to the top of the scroll area while the section is
      on screen, so the customer always knows which part they are filling in.
      The next section's head pushes this one out: sticky is scoped to the
      section that contains it. The hint scrolls away; it has been read. */
  }
  <div class="q-head" data-section-head>
    {
      /* The number is set at the title's size, not as a small superscript —
        `01` and `WHAT YOU NEED` are one line of a spec sheet, which is the
        same structural rung `h1`/`h4` occupy everywhere else on the site
        (mono, uppercase, tracked tight). See docs 14 §14.1b. */
    }
    <span class="q-number" aria-hidden="true">{number}</span>
    <h3 id={titleId} class="q-title">{title}</h3>
  </div>
  <p class="q-hint">{hint}</p>

  {
    /* Everything in this section that stops the send, listed at its top. A
      group's own message sits beside the group, but a picker is taller than
      the screen and its message used to land out of sight. Filled by
      `scripts/quote/form.ts`; each row jumps to its field. */
  }
  <div class="q-errors" data-section-errors hidden>
    <p class="q-errors-title" data-section-errors-title></p>
    <ul class="q-errors-list" data-section-errors-list></ul>
  </div>

  <div class="mt-12 max-cmp:mt-9">
    <slot />
  </div>
</section>

<style>
  /* The site's roomy section rhythm rather than a compressed form's, and the
     hairline that separates one step from the next. Padding is on the section
     and the rule is its border, so the rule runs edge to edge of the panel
     while the content stays inset (docs 14 §14.1e). */
  .q-section {
    /* The horizontal gutter is the panel's, inherited — head, sections and
       foot line up down the whole dialog from one number. The fallback is
       what the inline variant on /contact will use, where there is no panel
       (docs 14 §6). */
    padding: clamp(48px, 5vw, 88px) var(--dlg-gutter, 36px);
  }
  /* The number's fixed width, so the hint below lines up with the title.
     Two mono digits at -0.03em tracking come to about 1.15em. */
  .q-section {
    --q-num-w: calc(var(--text-h3) * 1.25);
  }
  .q-section + .q-section {
    border-top: 1px solid var(--color-line);
  }

  .q-head {
    position: sticky;
    /* `--q-head-top` clears the summary bar between 900 and 1240, where it
       is pinned across the top too (QuoteForm). */
    top: var(--q-head-top, var(--q-sticky-top, 0px));
    z-index: 5;
    display: flex;
    align-items: baseline;
    gap: 24px;
    /* Full bleed to the panel edge, so the white band hides what scrolls
       under it. The negative top margin keeps the resting position where the
       title always sat. */
    margin: -16px calc(-1 * var(--dlg-gutter, 36px)) 0;
    padding: 16px var(--dlg-gutter, 36px);
    background: #ffffff;
    transition: box-shadow 200ms var(--ease-out-expo);
  }
  /* Set by form.ts once the head is pinned: the hairline says "this sits on
     top of something" only when it does. */
  .q-head[data-stuck] {
    box-shadow: 0 1px 0 0 var(--color-line);
  }

  .q-hint {
    margin: 4px 0 0 calc(var(--q-num-w) + 24px);
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: 1.625;
    color: var(--color-muted);
  }

  .q-number {
    flex-shrink: 0;
    width: var(--q-num-w);
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-brand);
  }
  .q-title {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }

  /* ── The error box ──────────────────────────────────────────── */
  .q-errors {
    margin-top: 28px;
    padding: 16px 20px 18px;
    border-left: 2px solid var(--color-error);
    background: color-mix(in srgb, var(--color-error) 6%, #ffffff);
  }
  .q-errors[hidden] {
    display: none;
  }
  .q-errors-title {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: var(--text-note);
    font-weight: 500;
    color: var(--color-error);
  }
  .q-errors-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Built at runtime, so these carry no scope class — hence `:global`. */
  .q-errors-list :global(button) {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 4px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-size: var(--text-note);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .q-errors-list :global(button:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .q-errors-list :global(.q-errors-field) {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .q-section {
      padding: 34px var(--dlg-gutter, 20px) 44px;
    }
    /* A phone shows one section at a time and the step bar already pins its
       name, so a second pinned title would only eat the screen. */
    .q-head {
      position: static;
      margin: 0;
      padding: 0;
      gap: 16px;
      background: none;
    }
    .q-hint {
      margin-left: 0;
      margin-top: 12px;
    }
  }
</style>
