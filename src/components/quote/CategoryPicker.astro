---
/**
 * "Which machine?": one line in the form, and a photo viewer behind it.
 *
 *   <CategoryPicker instance={id} categories={categories} required />
 *
 * **The field is a button, not a control.** It shows the machine picked so
 * far (photo, name, size range) or a prompt, and opens `MachineViewer`, which
 * holds the actual radios. The radios stay inside this `<form>` even though
 * the viewer is a nested `<dialog>`, so the form reads `category` the way it
 * always has (scripts/quote/form.ts needs no special case).
 *
 * Why a viewer: the 4-across photo grid it replaced was the tallest thing in
 * section 01, and below 600px it dropped its photos and became fourteen text
 * rows. The viewer gives the photos the whole panel, and section 01 shrinks
 * to one line (decided 2026-11-22, `/lab/machine-picker` direction A).
 *
 * The names under the field are quick picks for someone who already knows
 * what they want. They tick the same radios; they are not a second group.
 *
 * Every state change after load is `scripts/quote/picker.ts`'s. Nothing here
 * is filled at runtime except through the hooks named `data-picker-*`.
 */
import Icon from "@/components/ui/Icon.astro";
import MachineViewer from "@/components/quote/MachineViewer.astro";
import { scopedId } from "@/lib/forms";
import { FIELD_COPY, PICKER } from "@/lib/quote/options";
import type { QuoteCategory } from "@/lib/quote/schema";

interface Props {
  /** Per-instance id prefix — two forms on one page must not collide. */
  instance: string;
  /** The machines, in catalogue order. Shaped by the composition layer. */
  categories: QuoteCategory[];
  /** The radio group's `name`. */
  name?: string;
  /** The selected category id, or `OTHER_CATEGORY`. */
  value?: string | null;
  legend?: string;
  required?: boolean;
  class?: string;
}

const {
  instance,
  categories,
  name = "category",
  value = null,
  legend = FIELD_COPY.category.label,
  required = false,
  class: extra = "",
} = Astro.props;

const legendId = scopedId(instance, name, "legend");
const errorId = `${legendId}-error`;
const viewerId = scopedId(instance, name, "viewer");

/* The empty field's picture: four machines from the catalogue, so the field
   says "photos inside" before it is opened. The first four with a photo, in
   catalogue order. */
const mosaic = categories.filter((category) => category.heroImage).slice(0, 4);
---

<fieldset class:list={["min-w-0 border-0 p-0", extra]} data-category-picker>
  <legend id={legendId} class="mb-[10px] p-0 text-note font-medium text-ink">
    {legend}{required && " *"}
  </legend>

  {/* Always rendered, filled at runtime — see ui/Field.astro for why. */}
  <p
    id={errorId}
    data-error-for={name}
    hidden
    class="mt-0 mb-[10px] text-caption text-error"
  >
  </p>

  {
    /* `data-field` makes this the control form.ts focuses and marks when the
      question is unanswered. */
  }
  <button
    type="button"
    class="pk-field"
    data-field={name}
    data-picker-open
    aria-haspopup="dialog"
    aria-controls={viewerId}
    aria-describedby={errorId}
  >
    <span class="pk-thumb">
      {
        /* One per machine, all hidden until picked. A hidden lazy image is
          never fetched, so this costs nothing until it is shown. */
        categories.map(
          (category) =>
            category.heroImage && (
              <img
                src={category.heroImage}
                alt=""
                loading="lazy"
                decoding="async"
                data-picker-thumb={category.id}
                hidden
              />
            ),
        )
      }
      <span class="pk-mosaic" data-picker-thumb-empty aria-hidden="true">
        {
          mosaic.map((category) => (
            <img
              src={category.heroImage}
              alt=""
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </span>
    </span>

    <span class="flex min-w-0 flex-1 flex-col">
      <span class="pk-name" data-picker-name data-empty={PICKER.placeholder}>
        {PICKER.placeholder}
      </span>
      <span
        class="pk-meta"
        data-picker-meta
        data-empty={PICKER.meta(categories.length)}
      >
        {PICKER.meta(categories.length)}
      </span>
    </span>

    <span class="pk-cta">
      <span
        data-picker-cta
        data-browse={PICKER.browse}
        data-change={PICKER.change}
      >
        {PICKER.browse}
      </span>
      <Icon name="arrow-right" size={16} />
    </span>
  </button>

  {
    /* The label on its own line and the names as chips: run together on one
      line, the label read as one more option. */
  }
  <div class="pk-quick" role="group" aria-labelledby={`${legendId}-quick`}>
    <p class="pk-quick-label" id={`${legendId}-quick`}>{PICKER.quick}</p>
    <div class="pk-quick-names">
      {
        categories.map((category) => (
          <button
            type="button"
            class="pk-quick-name"
            data-picker-quick={category.id}
            aria-pressed="false"
          >
            {category.name}
          </button>
        ))
      }
    </div>
  </div>

  <MachineViewer
    id={viewerId}
    instance={instance}
    categories={categories}
    name={name}
    value={value}
    legend={legend}
    required={required}
  />
</fieldset>

<style>
  /* Drawn like every other field in the form: no box, one rule beneath. */
  .pk-field {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 14px 0;
    border: 0;
    border-bottom: 1px solid var(--color-line-strong);
    background: none;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 200ms var(--ease-out-expo),
      box-shadow 200ms var(--ease-out-expo);
  }
  .pk-field:hover,
  .pk-field:focus-visible {
    outline: none;
    border-color: var(--color-brand-bright);
    box-shadow: 0 1px 0 0 var(--color-brand-bright);
  }
  /* Set by form.ts on an unanswered submit. */
  .pk-field.ctl-error {
    border-color: var(--color-error);
    box-shadow: none;
  }

  .pk-thumb {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    aspect-ratio: 4 / 3;
    overflow: clip;
    background: var(--color-surface-2);
    color: var(--color-faint);
  }
  .pk-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Nothing picked yet: a 2x2 contact sheet of the catalogue. Static
     position, so it fills the thumb rather than stacking with the picked
     photo's absolute layer. Grey until the field is pointed at, the same
     rule every machine photo in the form follows. */
  .pk-mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    width: 100%;
    height: 100%;
    background: #ffffff;
  }
  .pk-thumb .pk-mosaic img {
    position: static;
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 300ms var(--ease-out-expo),
      opacity 300ms var(--ease-out-expo);
  }
  .pk-field:hover .pk-mosaic img,
  .pk-field:focus-visible .pk-mosaic img {
    filter: none;
    opacity: 1;
  }

  .pk-mosaic[hidden],
  .pk-thumb img[hidden] {
    display: none;
  }

  .pk-name {
    font-size: var(--text-intro);
    line-height: 1.3;
    color: var(--color-faint);
  }
  .pk-field[data-picked] .pk-name {
    color: var(--color-ink);
  }
  .pk-meta {
    margin-top: 3px;
    font-size: var(--text-note);
    line-height: 1.4;
    color: var(--color-muted);
  }
  .pk-cta {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-brand);
  }

  .pk-quick {
    margin-top: 22px;
  }
  .pk-quick-label {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .pk-quick-names {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Square chips with a hairline, the form's pressed-thing language: each
     name reads as its own control. Picked = brand tint and brand rule, as a
     picked tile is. */
  .pk-quick-name {
    padding: 7px 12px;
    border: 1px solid var(--color-line-strong);
    background: #ffffff;
    cursor: pointer;
    font-size: var(--text-note);
    line-height: 1.3;
    color: var(--color-body);
    transition:
      color 200ms var(--ease-out-expo),
      border-color 200ms var(--ease-out-expo),
      background-color 200ms var(--ease-out-expo),
      transform 160ms var(--ease-out-expo);
  }
  @media (hover: hover) and (pointer: fine) {
    .pk-quick-name:hover {
      color: var(--color-ink);
      border-color: var(--color-ink);
    }
  }
  .pk-quick-name:active {
    transform: scale(0.97);
  }
  .pk-quick-name:focus-visible {
    outline: 2px solid var(--color-brand-bright);
    outline-offset: 2px;
  }
  .pk-quick-name[aria-pressed="true"] {
    color: var(--color-brand);
    border-color: var(--color-brand);
    background: var(--color-brand-tint);
  }

  /* A phone gets a smaller photo and loses the word, keeping the arrow. */
  @media (max-width: 600px) {
    .pk-field {
      gap: 14px;
    }
    .pk-thumb {
      width: 72px;
    }
    .pk-cta span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pk-thumb .pk-mosaic img,
    .pk-quick-name {
      transition-duration: 1ms;
    }
    .pk-quick-name:active {
      transform: none;
    }
  }
</style>
