---
/**
 * Section header: eyebrow + heading on the left, optional intro on the right.
 * `title` may be a string or an array of lines (rendered on separate lines).
 * Sentence-case, airy — the premium editorial pattern.
 */
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string | string[];
  intro?: string;
  tone?: "light" | "dark";
  align?: "split" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  intro,
  tone = "light",
  align = "split",
  class: extra = "",
} = Astro.props;

const lines = Array.isArray(title) ? title : [title];
const h2Color = tone === "dark" ? "text-white" : "";
const introColor = tone === "dark" ? "text-[#aab2c0]" : "text-muted";
const centered = align === "center";
---

<div
  class:list={[
    "mb-[60px] gap-8 max-mob:mb-[40px]",
    centered
      ? "mx-auto flex max-w-[640px] flex-col items-center text-center"
      : "flex flex-wrap items-end justify-between max-mob:gap-4",
    extra,
  ]}
>
  <div class:list={[centered && "flex flex-col items-center"]}>
    <Eyebrow
      tone={tone === "dark" ? "brand-bright" : "brand"}
      class={centered ? "mb-[16px] justify-center" : "mb-[16px]"}
    >
      {eyebrow}
    </Eyebrow>
    <h2
      class:list={["text-h2 leading-[1.06] max-mob:mb-[4px]", h2Color]}
      set:html={lines.join("<br>")}
    />
  </div>
  {
    intro && (
      <p
        class:list={[
          "text-lead leading-relaxed",
          centered ? "max-w-[560px]" : "max-w-[430px]",
          introColor,
        ]}
      >
        {intro}
      </p>
    )
  }
</div>
