---
/**
 * Button / CTA. Renders an <a> when `href` is set, otherwise a <button>.
 * All button styling in the design lives here — pick a `variant`.
 *
 * Style: sentence-case pill buttons (rounded-full), medium weight — the calm,
 * premium look. Blue is the primary action; everything else is quiet.
 */
interface Props {
  href?: string;
  variant?: "primary" | "outline" | "outline-white";
  size?: "md" | "lg";
  type?: "button" | "submit";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: extra = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-semibold whitespace-nowrap rounded-full transition-all duration-200 cursor-pointer";

const sizes: Record<NonNullable<Props["size"]>, string> = {
  md: "px-[24px] py-[12px] text-sm",
  lg: "px-[30px] py-[15px] text-base",
};

const variants: Record<NonNullable<Props["variant"]>, string> = {
  primary:
    "bg-brand-bright text-white shadow-[0_1px_2px_rgba(10,14,23,0.10)] hover:bg-brand-hover hover:shadow-[0_6px_18px_rgba(47,111,255,0.28)]",
  outline:
    "bg-white border border-line-strong text-ink hover:border-ink hover:bg-surface",
  "outline-white":
    "bg-transparent border border-white/40 text-white hover:bg-white hover:text-ink hover:border-white",
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${extra}`;
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}
