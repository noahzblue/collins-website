---
/**
 * Decorative full-cover background layer. Photos that are pure art direction
 * (banners, tiles, tab panels) ride on a background-image rather than an <img>
 * so they can crop freely — this wraps that one repeated pattern.
 *
 * Pass positioning/animation classes through `class`; the element is always
 * hidden from assistive tech, so anything meaningful needs real alt text.
 */
interface Props {
  src: string;
  class?: string;
}

const { src, class: extra = "" } = Astro.props;
---

<div
  class:list={["absolute inset-0 bg-cover bg-center", extra]}
  style={`background-image:url('${src}')`}
  aria-hidden="true"
>
</div>
