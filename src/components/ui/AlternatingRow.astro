---
/**
 * A full-width row: photograph one side, the pitch on the other, sides
 * alternating down the page. The unit /equipment and /services are both built
 * from — twelve category rows on one, six capability blocks on the other.
 *
 *   <AlternatingRow id={slug} title="Generators" image={hero} href={url} flip={i % 2 === 1}>
 *     <Fragment slot="meta">…number, family, icon…</Fragment>
 *     …the body: spec line, list, paragraph…
 *     <Fragment slot="actions">…buttons…</Fragment>
 *   </AlternatingRow>
 *
 * It owns three things and no more: the two-column grid, the photograph's crop
 * and the heading. Everything that differs between the two pages — a family
 * label against an icon tile, four capability lines against a points grid, one
 * link against two buttons — arrives through a slot. That is deliberate: the
 * moment this file starts taking `badges` and `points` and `icon` props it has
 * stopped being a layout and started being both pages at once.
 *
 * `href` makes the photograph and the heading a link to the same place. The
 * photo copy is `aria-hidden` and untabbable so the pair is one stop in the tab
 * order, not two identical ones.
 */
import ParallaxImage from "@/components/ui/ParallaxImage.astro";

interface Props {
  /** Anchor target — must match the id the index rail points at. */
  id?: string;
  /** The heading. Rendered as an h2; the row is a section of the page. */
  title: string;
  image?: string;
  /** Decorative by default: the heading beside it already names the subject. */
  imageAlt?: string;
  /** Links both the photograph and the heading. Omit for a row that is copy. */
  href?: string;
  /** Media to the right instead of the left. Set by position in the list. */
  flip?: boolean;
  class?: string;
}

const {
  id,
  title,
  image,
  imageAlt = "",
  href,
  flip = false,
  class: extra = "",
} = Astro.props;

/* Sources are 4:3 landscape; the 4:5 crop is what gives the row its editorial
   column, so the photos are centred rather than fitted. Below the nav
   breakpoint the row stacks and the photo goes back to landscape. */
const mediaClass = [
  "aspect-[4/5] w-full max-nav:aspect-[16/10]",
  href && "transition-transform duration-500 ease-out group-hover:scale-[1.03]",
];
---

<article
  id={id}
  class:list={[
    "group grid grid-cols-2 items-center gap-[72px] max-nav:grid-cols-1 max-nav:gap-9",
    extra,
  ]}
>
  {
    image &&
      (href ? (
        <a
          href={href}
          aria-hidden="true"
          tabindex="-1"
          class:list={[
            "block overflow-clip rounded-md bg-surface-2",
            flip && "order-2 max-nav:order-none",
          ]}
        >
          <ParallaxImage src={image} alt={imageAlt} class:list={mediaClass} />
        </a>
      ) : (
        <ParallaxImage
          src={image}
          alt={imageAlt}
          shift="4%"
          zoom={1.1}
          class:list={[
            "rounded-md",
            ...mediaClass,
            flip && "order-2 max-nav:order-none",
          ]}
        />
      ))
  }

  <div class="max-w-[460px] max-nav:max-w-none">
    <slot name="meta" />

    <h2 class="mt-[18px] text-[clamp(28px,3.2vw,38px)] leading-[1.06]">
      {
        href ? (
          <a href={href} class="transition-colors hover:text-brand">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h2>

    <slot />

    <div class="mt-8 flex flex-wrap items-center gap-3 empty:hidden">
      <slot name="actions" />
    </div>
  </div>
</article>
