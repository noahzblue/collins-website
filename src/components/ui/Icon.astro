---
/**
 * Reusable inline SVG icon. Renders a glyph from the shared `icons` registry.
 *
 *   <Icon name="phone" size={18} class="text-brand" />
 *
 * Colour is inherited via `currentColor` — set it with a `text-*` class on the
 * icon or any parent. Decorative by default (aria-hidden); pass `label` to
 * expose it to assistive tech as an image.
 */
import { icons, type IconDef, type IconName } from "./icons";

interface Props {
  name: IconName;
  /** Width & height in px (or any CSS length). */
  size?: number | string;
  class?: string;
  /** Accessible name. Omit for decorative icons. */
  label?: string;
}

const { name, size = 20, class: extra = "", label } = Astro.props;
const def: IconDef = icons[name];
const stroke = def.mode === "stroke";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={def.viewBox ?? "0 0 24 24"}
  fill={stroke ? "none" : "currentColor"}
  stroke={stroke ? "currentColor" : undefined}
  stroke-width={stroke ? (def.strokeWidth ?? 2) : undefined}
  stroke-linecap={stroke ? "round" : undefined}
  stroke-linejoin={stroke ? "round" : undefined}
  class:list={["inline-block shrink-0", extra]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={def.body}
/>
