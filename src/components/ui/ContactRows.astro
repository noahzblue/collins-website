---
/**
 * Vertical list of icon + line contact details (address, hours, phone).
 * Rows with an `href` render as links; the rest are plain text.
 */
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

export interface ContactRow {
  icon: IconName;
  text: string;
  href?: string;
}

interface Props {
  rows: ContactRow[];
  /** Colour for rows without a link. Linked rows are always body + hover. */
  tone?: "body" | "muted";
  class?: string;
}

const { rows, tone = "body", class: extra = "" } = Astro.props;

const line = "flex items-center gap-3 text-base";
const plain = tone === "muted" ? "text-muted" : "text-body";
---

<div class:list={["flex flex-col gap-3", extra]}>
  {
    rows.map((row) =>
      row.href ? (
        <a
          href={row.href}
          class:list={[line, "text-body transition-colors hover:text-brand"]}
        >
          <Icon name={row.icon} size={17} class="shrink-0 text-brand" />
          {row.text}
        </a>
      ) : (
        <span class:list={[line, plain]}>
          <Icon name={row.icon} size={17} class="shrink-0 text-brand" />
          {row.text}
        </span>
      ),
    )
  }
</div>
