---
/**
 * Sticky numbered index beside a column of long sections — the thing that
 * keeps a twelve-row catalogue or a six-block services page navigable, and
 * tells you how much page is left.
 *
 *   <IndexRail items={blocks.map((b, i) => ({ id: b.slug, label: b.title }))}
 *              ariaLabel="Services" />
 *
 * Each item's `id` must match the `id` of the section it points at; the
 * scroll-spy observes those sections directly.
 *
 * Two renderings of the same list:
 *   - desktop: a vertical rail that sticks under the header
 *   - below `nav`: a horizontally scrolling chip strip pinned under the header,
 *     which auto-centres the active chip. Hiding it on mobile — what we used to
 *     do — loses the "how much is left" signal on the device that needs it most.
 */
interface Props {
  items: { id: string; label: string }[];
  ariaLabel: string;
  class?: string;
}

const { items, ariaLabel, class: extra = "" } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, "0");
---

{
  /* On desktop the outer div is the grid cell and stretches to the full height
   of the blocks beside it; the vertical rail's `sticky` only has room to
   travel because of that.

   `contents` below the nav breakpoint is load-bearing, not tidiness: a
   sticky element can only travel inside its containing block, and as a grid
   item this wrapper is only as tall as the chip strip itself — the strip would
   scroll away instead of pinning. Generating no box hands the strip the tall
   block container that holds the page's sections. The pages that use the rail
   switch that container from `grid` to `block` at the same breakpoint. */
}
<div class:list={["index-rail max-nav:contents", extra]} data-index-rail>
  <nav class="sticky top-header-gap max-nav:hidden" aria-label={ariaLabel}>
    <ul class="flex flex-col border-l border-line">
      {
        items.map((item, i) => (
          <li>
            <a
              href={`#${item.id}`}
              data-index-link={item.id}
              class="idx -ml-px flex items-center gap-[10px] border-l border-transparent py-[6px] pl-[13px] transition-colors duration-200"
            >
              <span class="idx-num font-mono text-micro tracking-[0.5px] text-faint transition-colors duration-200">
                {num(i)}
              </span>
              <span class="idx-label text-note leading-[1.3] text-muted transition-colors duration-200">
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Mobile chip strip -->
  <div
    class="chip-strip sticky top-[calc(var(--spacing-header)+6px)] z-20 mb-8 hidden overflow-x-auto rounded-full border border-line bg-white/92 px-[10px] py-[8px] backdrop-blur-md max-nav:block"
    data-lenis-prevent
  >
    <ul class="flex w-max items-center gap-2" aria-label={ariaLabel}>
      {
        items.map((item, i) => (
          <li>
            <a
              href={`#${item.id}`}
              data-index-link={item.id}
              class="chip flex items-center gap-[7px] rounded-full border border-line-strong px-[12px] py-[6px] whitespace-nowrap transition-colors duration-200"
            >
              <span class="font-mono text-micro tracking-[0.5px] text-faint">
                {num(i)}
              </span>
              <span class="text-note text-muted">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* The strip is its own scroller (hence `data-lenis-prevent`); its scrollbar
     would sit across the chips, so it is hidden and the overflow itself is the
     affordance. */
  .chip-strip {
    scrollbar-width: none;
  }
  .chip-strip::-webkit-scrollbar {
    display: none;
  }

  .idx:hover .idx-label,
  .idx:hover .idx-num {
    color: var(--color-ink);
  }
  .idx.is-active {
    border-left-color: var(--color-brand);
  }
  .idx.is-active .idx-num {
    color: var(--color-brand);
  }
  .idx.is-active .idx-label {
    color: var(--color-ink);
    font-weight: 600;
  }

  .chip.is-active {
    border-color: var(--color-brand);
    background: var(--color-brand-tint);
  }
  .chip.is-active :global(span) {
    color: var(--color-brand);
  }
</style>

<script>
  import { untilPageSwap } from "@/scripts/untilPageSwap";

  // Re-runs after every client-router navigation as well as on first load,
  // so the swapped-in DOM gets wired up.
  document.addEventListener("astro:page-load", () => {
    const rail = document.querySelector<HTMLElement>("[data-index-rail]");
    if (!rail) return;

    const gone = untilPageSwap();
    const links = [
      ...rail.querySelectorAll<HTMLAnchorElement>("[data-index-link]"),
    ];
    if (links.length === 0) return;

    const strip = rail.querySelector<HTMLElement>(".chip-strip");
    let active = "";

    const setActive = (id: string) => {
      if (id === active) return;
      active = id;
      for (const link of links) {
        link.classList.toggle("is-active", link.dataset.indexLink === id);
      }
      // Keep the active chip in view on mobile — the strip is the only
      // progress signal there, and a chip off the edge is no signal at all.
      const chip = strip?.querySelector<HTMLElement>(
        `.chip[data-index-link="${CSS.escape(id)}"]`,
      );
      if (strip && chip) {
        strip.scrollTo({
          left: chip.offsetLeft + chip.offsetWidth / 2 - strip.offsetWidth / 2,
          behavior: "smooth",
        });
      }
    };

    /* Highlight whichever block is crossing the middle of the viewport. The
       rootMargin collapses the observation area to a thin band there, so only
       one block is intersecting at a time and the rail can't flicker between
       two. A fast scroll can leave nothing in the band — the last active link
       stays lit rather than the rail going blank. */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    gone.addEventListener("abort", () => observer.disconnect(), { once: true });

    for (const link of links) {
      const block = document.getElementById(link.dataset.indexLink!);
      if (block) observer.observe(block);
    }

    setActive(links[0].dataset.indexLink!);
  });
</script>
