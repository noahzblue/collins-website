---
/**
 * Collins brand wordmark. The SVG is imported raw and inlined so its colour
 * follows `currentColor` — `variant` recolours it for the light header
 * (brand blue) or the dark footer (white). `tagline` toggles the small
 * "EQUIPMENTS LLC" line beneath it; text comes from the site config.
 */
import { site } from "../../config/site";
import wordmark from "../../assets/collins-logo.svg?raw";

interface Props {
  variant?: "header" | "footer";
  tagline?: boolean;
  class?: string;
}

const { variant = "header", tagline = true, class: extra = "" } = Astro.props;
const isFooter = variant === "footer";

const wordmarkColor = isFooter ? "text-white" : "text-brand";
const taglineColor = isFooter ? "text-[#999]" : "text-navy";
---

<a
  href="/"
  class:list={["inline-flex flex-col leading-none", extra]}
  aria-label={`${site.name} — home`}
>
  <span
    class:list={[
      wordmarkColor,
      "[&>svg]:h-[35px] [&>svg]:w-auto [&>svg]:block max-mob:[&>svg]:h-[24px]",
    ]}
    set:html={wordmark}
  />
</a>
