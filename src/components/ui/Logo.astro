---
/**
 * Collins brand wordmark. The SVG is imported raw and inlined so its colour
 * follows `currentColor` — it renders brand blue by default, and the header
 * flips it to white while it sits over the hero video (see Header.astro).
 */
import { site } from "@/config/site";
import wordmark from "@/assets/collins-logo.svg?raw";

interface Props {
  class?: string;
}

const { class: extra = "" } = Astro.props;
---

<a
  href="/"
  class:list={["inline-flex flex-col leading-none", extra]}
  aria-label={`${site.name} — home`}
>
  <span
    class="text-brand [&>svg]:block [&>svg]:h-[35px] [&>svg]:w-auto max-mob:[&>svg]:h-[24px]"
    set:html={wordmark}
  />
</a>
