---
/**
 * The "view all N …" link that closes a teaser section.
 *
 * It used to be a small centred text link three times over (equipment,
 * services, industries) — a 140px target at the bottom of a 1200px section,
 * which is the one place on the page where the reader has just decided they
 * want more. This is the same link as a full-width rule: it spans the block it
 * belongs to, it has real height, and it tints on hover so the whole bar
 * acknowledges the pointer rather than four words in the middle of it.
 *
 *   <ViewAllBar href="/equipment" label="View all 12 categories" />
 *
 * It is deliberately NOT `ui/Button.astro`. A button is an object sitting on
 * the page; this is a rule the block ends on — full width, hairline top and
 * bottom, no fill and no radius. What it does borrow from Button is the
 * *scale*: on a phone it sits at the same 12.5px label and ~40px height as a
 * small button, so the two read as the same size of control even though they
 * are not the same shape.
 */
import Icon from "@/components/ui/Icon.astro";

interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: extra = "" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "view-all press group flex w-full items-center justify-center gap-3 border-y border-line px-6 py-[30px] font-mono text-sm font-medium tracking-[1.6px] text-ink uppercase transition-colors duration-300 max-mob:py-[22px] max-cmp:gap-[6px] max-cmp:px-4 max-cmp:py-[11px] max-cmp:text-note max-cmp:tracking-[1px]",
    extra,
  ]}
>
  {label}
  <Icon
    name="arrow-right"
    size={17}
    class="transition-transform duration-300 ease-out group-hover:translate-x-[6px] max-cmp:h-[13px] max-cmp:w-[13px]"
  />
</a>

<style>
  /* The quietest surface the palette has that still reads as "on". */
  .view-all:hover,
  .view-all:focus-visible {
    background: var(--color-brand-tint);
    border-color: var(--color-brand-tint);
    color: var(--color-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .view-all,
    .view-all :global(svg) {
      transition: none;
    }
  }
</style>
