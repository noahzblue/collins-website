---
/**
 * One equipment category as a full-width alternating row — the hub's primary
 * unit, replacing the card grid.
 *
 * The layout, the photograph's crop and the heading belong to
 * `ui/AlternatingRow`, which /services builds its six blocks from too. What is
 * left here is what only a category has: the number-and-family line, the spec
 * line, four scannable capability lines, the summary, and the link through with
 * its availability badges.
 */
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import Pill from "@/components/ui/Pill.astro";
import AlternatingRow from "@/components/ui/AlternatingRow.astro";
import { availabilityBadges } from "@/lib/equipment";

interface Props {
  category: CollectionEntry<"equipment">;
  /** Media to the right instead of the left. Set by position in the list. */
  flip?: boolean;
}

const { category, flip = false } = Astro.props;
const { name, family, rangeLabel, summary, highlights, heroImage, sortOrder } =
  category.data;

const badges = availabilityBadges(category.data);

const href = `/equipment/${category.id}`;
---

<AlternatingRow
  id={category.id}
  title={name}
  image={heroImage}
  href={href}
  flip={flip}
>
  <Fragment slot="meta">
    <div class="flex items-center gap-[14px]">
      <span class="font-mono text-caption tracking-[0.5px] text-brand">
        {String(sortOrder).padStart(2, "0")}
      </span>
      <span class="h-px w-[22px] bg-line-strong" aria-hidden="true"></span>
      <span class="text-tag font-medium tracking-[1.6px] text-faint uppercase">
        {family}
      </span>
    </div>
  </Fragment>

  <p class="mt-[10px] text-base text-muted">{rangeLabel}</p>

  <ul class="mt-7 flex flex-col gap-[9px]">
    {
      highlights.map((line) => (
        <li class="flex gap-[11px] text-detail leading-[1.45] font-medium text-body">
          <Icon
            name="arrow-right"
            size={15}
            class="mt-[4px] shrink-0 text-brand"
          />
          <span>{line}</span>
        </li>
      ))
    }
  </ul>

  <p class="mt-7 text-lead leading-relaxed text-muted">{summary}</p>

  <Fragment slot="actions">
    <Button variant="outline" href={href} class="press">
      View {name.toLowerCase()}
      <Icon
        name="arrow-right"
        size={16}
        class="transition-transform duration-200 group-hover:translate-x-[3px]"
      />
    </Button>
    <div class="flex items-center gap-2">
      {badges.map((badge) => <Pill size="md">{badge}</Pill>)}
    </div>
  </Fragment>
</AlternatingRow>
