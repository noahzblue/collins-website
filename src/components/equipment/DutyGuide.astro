---
/**
 * Sizing advice for a category — "which one do I actually need".
 * Renders nothing until the copy lands in categories.json, so eleven of the
 * twelve pages simply skip it at launch.
 */
import type { CollectionEntry } from "astro:content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { singular } from "@/lib/equipment";

interface Props {
  scenarios: CollectionEntry<"equipment">["data"]["dutyGuide"];
  name: string;
}

const { scenarios, name } = Astro.props;
---

{
  scenarios.length > 0 && (
    <div>
      <Eyebrow class="mb-4">Sizing guide</Eyebrow>
      <h2 class="mb-10 max-w-[620px] text-h3 leading-[1.1]">
        Picking the right {singular(name)} for the job
      </h2>

      <div class="grid grid-cols-3 gap-5 max-nav:grid-cols-1">
        {scenarios.map((scenario, i) => (
          <div class="card flex flex-col p-7 max-xs:p-6">
            <span class="mb-4 font-mono text-label tracking-[0.5px] text-brand">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mb-3 text-subhead leading-[1.25] font-semibold">
              {scenario.situation}
            </h3>
            <p class="text-detail leading-relaxed text-muted">
              {scenario.advice}
            </p>
          </div>
        ))}
      </div>
    </div>
  )
}
