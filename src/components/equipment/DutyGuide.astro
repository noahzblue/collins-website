---
/**
 * Sizing advice for a category — "which one do I actually need".
 * Renders nothing until the copy lands in categories.json, so eleven of the
 * twelve pages simply skip it at launch.
 *
 * The page-level wrapper only: the eyebrow, the heading and the width. The
 * scenarios themselves are `DutyGuideList`, so the quote form can render the
 * same cells inside a `<details>` without this heading (docs 14 §15.5).
 */
import type { CollectionEntry } from "astro:content";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import DutyGuideList from "@/components/equipment/DutyGuideList.astro";
import { singular } from "@/lib/equipment";

interface Props {
  scenarios: CollectionEntry<"equipment">["data"]["dutyGuide"];
  name: string;
}

const { scenarios, name } = Astro.props;
---

{
  scenarios.length > 0 && (
    <div>
      <Eyebrow class="mb-4">Sizing guide</Eyebrow>
      <h2 class="mb-10 max-w-[620px] text-h3 leading-[1.1]">
        Picking the right {singular(name)} for the job
      </h2>

      <DutyGuideList scenarios={scenarios} />
    </div>
  )
}
