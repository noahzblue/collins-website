---
/**
 * One equipment category as a card — photo tile, name, range line and the
 * buy/hire badges. Used by the hub grid and by the "related" row on a
 * category page.
 */
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import Pill from "@/components/ui/Pill.astro";
import BgImage from "@/components/ui/BgImage.astro";
import { availabilityBadges } from "@/lib/equipment";

interface Props {
  category: CollectionEntry<"equipment">;
  /** Two-digit index in the corner of the tile. Omit to hide it. */
  index?: number;
  /** Hub cards carry the extra sentence; related cards stay compact. */
  showCardLine?: boolean;
}

const { category, index, showCardLine = true } = Astro.props;
const { name, rangeLabel, cardLine, heroImage } = category.data;
const badges = availabilityBadges(category.data);
---

<a
  href={`/equipment/${category.id}`}
  class="group card relative flex flex-col overflow-hidden transition-all duration-200 hover:-translate-y-[3px] hover:border-line-strong hover:shadow-[0_20px_50px_-28px_rgba(10,14,23,0.32)]"
>
  {
    /* Light neutral behind the photo: the six categories still waiting on a
      hero image read as a quiet empty tile rather than a black hole. */
  }
  <div class="relative aspect-[4/3] overflow-hidden bg-surface-2">
    {
      heroImage && (
        <BgImage
          src={heroImage}
          class="transition-transform duration-500 ease-out group-hover:scale-[1.05]"
        />
      )
    }
    {
      index !== undefined && (
        <span class="absolute top-4 right-4 rounded-full bg-ink/35 px-[10px] py-[5px] font-mono text-tag tracking-[0.5px] text-white/90 backdrop-blur-sm">
          {String(index).padStart(2, "0")}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-7 max-xs:p-6">
    <h3 class="text-[21px] font-semibold">{name}</h3>
    <p class="mt-1 text-sm text-muted">{rangeLabel}</p>
    {
      showCardLine && (
        <p class="mt-3 text-detail leading-relaxed text-muted">{cardLine}</p>
      )
    }

    <div class="mt-5 flex items-center gap-2">
      {badges.map((badge) => <Pill>{badge}</Pill>)}
      <span
        class="ml-auto inline-flex items-center gap-[6px] text-meta font-semibold text-brand"
      >
        View
        <Icon
          name="arrow-up-right"
          size={15}
          class="transition-transform duration-200 group-hover:translate-x-[3px] group-hover:-translate-y-[3px]"
        />
      </span>
    </div>
  </div>
</a>
