---
/**
 * The equipment hub's index rail. Maps the collection onto the shared
 * `ui/IndexRail` — the numbering comes from list position, which is already
 * `sortOrder` because the hub sorts before it renders.
 */
import type { CollectionEntry } from "astro:content";
import IndexRail from "@/components/ui/IndexRail.astro";

interface Props {
  categories: CollectionEntry<"equipment">[];
}

const { categories } = Astro.props;
---

<IndexRail
  items={categories.map((c) => ({ id: c.id, label: c.data.name }))}
  ariaLabel="Equipment categories"
/>
