---
/**
 * The sizes/ratings table for one category, with a per-row enquiry link.
 *
 * Rendered per `mode` and tagged `data-mode-panel` so the buy/hire toggle can
 * be dropped in later by emitting both panels and hiding one with CSS — no
 * re-render, no hrefs rewritten in JS.
 *
 * Below 600px the rows stack: rating + type on one line, duty beneath,
 * availability and the enquiry link on the last line.
 */
import type { CollectionEntry } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import Pill from "@/components/ui/Pill.astro";
import {
  AVAILABILITY_LABEL,
  AVAILABILITY_TONE,
  enquireHref,
  type Mode,
} from "@/lib/equipment";

type Ranges = CollectionEntry<"equipment">["data"]["ranges"];

interface Props {
  ranges: Ranges;
  /** Category name — words the enquiry message ("a 250 kVA generator"). */
  name: string;
  mode?: Mode;
}

const { ranges, name, mode = "hire" } = Astro.props;

/* Columns only appear when the data fills them — crawler cranes and
   compressors carry no power type, so that column would sit empty. */
const hasPowerType = ranges.some((r) => r.powerType);
const hasDuty = ranges.some((r) => r.typicalDuty);

const th =
  "px-6 py-[13px] text-tag font-semibold uppercase tracking-[1.4px] text-faint max-xs:px-5";
const td = "px-6 py-[17px] align-middle max-cmp:p-0 max-xs:px-5";
---

<div data-mode-panel={mode} class="card overflow-hidden">
  <table class="w-full border-collapse text-left max-cmp:block">
    <thead class="max-cmp:hidden">
      <tr class="border-b border-line bg-surface">
        <th scope="col" class={th}>Size / rating</th>
        {
          hasPowerType && (
            <th scope="col" class={th}>
              Type
            </th>
          )
        }
        {
          hasDuty && (
            <th scope="col" class={`${th} w-full`}>
              Typical duty
            </th>
          )
        }
        <th scope="col" class={th}>Availability</th>
        <th scope="col" class={`${th} text-right`}>
          <span class="sr-only">Enquire</span>
        </th>
      </tr>
    </thead>
    <tbody class="max-cmp:block">
      {
        ranges.map((range) => (
          <tr class="border-b border-line transition-colors last:border-0 hover:bg-surface max-cmp:block max-cmp:px-5 max-cmp:py-5">
            <td
              class={`${td} text-cell font-semibold whitespace-nowrap text-ink max-cmp:inline-flex max-cmp:text-intro`}
            >
              {range.label}
            </td>

            {hasPowerType && (
              <td
                class={`${td} whitespace-nowrap max-cmp:ml-3 max-cmp:inline-flex`}
              >
                {range.powerType && <Pill>{range.powerType}</Pill>}
              </td>
            )}

            {hasDuty && (
              <td
                class={`${td} text-detail leading-relaxed text-muted max-cmp:mt-[10px] max-cmp:block`}
              >
                {range.typicalDuty}
              </td>
            )}

            <td
              class={`${td} whitespace-nowrap max-cmp:mt-[14px] max-cmp:inline-flex`}
            >
              <span class="inline-flex items-center gap-[7px] text-meta font-medium text-body">
                <span
                  class:list={[
                    "h-[6px] w-[6px] rounded-full",
                    AVAILABILITY_TONE[range.availability],
                  ]}
                  aria-hidden="true"
                />
                {AVAILABILITY_LABEL[mode][range.availability]}
              </span>
            </td>

            <td
              class={`${td} text-right whitespace-nowrap max-cmp:mt-[14px] max-cmp:ml-5 max-cmp:inline-flex`}
            >
              <a
                href={enquireHref(name, mode, range.label)}
                target="_blank"
                rel="noopener"
                class="group inline-flex items-center gap-[5px] text-note font-semibold text-brand transition-colors hover:text-brand-hover"
              >
                Enquire
                <Icon
                  name="arrow-up-right"
                  size={14}
                  class="transition-transform duration-200 group-hover:translate-x-[2px] group-hover:-translate-y-[2px]"
                />
              </a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
