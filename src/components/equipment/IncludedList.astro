---
/**
 * What the rate (or the purchase) covers. Rendered per `mode` and tagged
 * `data-mode-panel` so the buy/hire toggle can hide one panel with CSS.
 */
import Icon from "../ui/Icon.astro";
import { INCLUDED, INCLUDED_HEADING, type Mode } from "../../lib/equipment";

interface Props {
  mode?: Mode;
  class?: string;
}

const { mode = "hire", class: extra = "" } = Astro.props;
---

<div data-mode-panel={mode} class:list={[extra]}>
  <h2 class="text-[clamp(24px,2.6vw,32px)] leading-[1.1] mb-7">
    {INCLUDED_HEADING[mode]}
  </h2>
  <ul class="flex flex-col gap-[14px]">
    {
      INCLUDED[mode].map((item) => (
        <li class="flex items-start gap-3 text-[15.5px] leading-relaxed text-body">
          <span class="flex items-center justify-center w-[22px] h-[22px] mt-[2px] rounded-full bg-brand-tint text-brand shrink-0">
            <Icon name="check" size={13} />
          </span>
          {item}
        </li>
      ))
    }
  </ul>
</div>
