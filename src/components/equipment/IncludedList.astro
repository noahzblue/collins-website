---
/**
 * What the rate (or the purchase) covers. Rendered per `mode` and tagged
 * `data-mode-panel` so the buy/hire toggle can hide one panel with CSS.
 */
import Icon from "@/components/ui/Icon.astro";
import {
  EXCLUDED,
  INCLUDED,
  INCLUDED_HEADING,
  type Mode,
} from "@/lib/equipment";

interface Props {
  mode?: Mode;
  class?: string;
}

const { mode = "hire", class: extra = "" } = Astro.props;
---

<div data-mode-panel={mode} class:list={[extra]}>
  <h2 class="mb-7 text-[clamp(24px,2.6vw,32px)] leading-[1.1]">
    {INCLUDED_HEADING[mode]}
  </h2>
  <ul class="flex flex-col gap-[14px]">
    {
      INCLUDED[mode].map((item) => (
        <li class="flex items-start gap-3 text-cell leading-relaxed text-body">
          <span class="mt-[2px] flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-brand-tint text-brand">
            <Icon name="check" size={13} />
          </span>
          {item}
        </li>
      ))
    }
  </ul>

  {
    EXCLUDED[mode].length > 0 && (
      <p class="mt-7 mb-0 max-w-[46ch] border-l-2 border-line-strong pl-4 text-note leading-relaxed text-muted">
        {EXCLUDED[mode].join(" ")}
      </p>
    )
  }
</div>
