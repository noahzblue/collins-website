---
/**
 * Floating glass header — a pill bar inset from the viewport edges.
 * Smoked glass over dark bands and photo banners, frosted white over light
 * ones. Tone lives on `data-tone` and is driven by whichever section is under
 * the bar (scripts/themeFlip.ts), not by any one page's hero height.
 *
 * Three of the six items have somewhere deeper to go, so they carry a
 * sub-menu: twelve equipment categories, six services, eight industries. On
 * the bar that is a panel on hover or focus; in the mobile sheet it is a
 * `<details>` accordion, which is the same information with no second
 * implementation and no JavaScript at all.
 *
 * Below the nav breakpoint the bar carries the logo and the hamburger and
 * nothing else — "Get a quote" moves into the panel, where it gets a full
 * width row instead of competing with the menu button for a phone's worth of
 * space.
 */
import { getCollection } from "astro:content";
import Logo from "@/components/ui/Logo.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { mainNav, navChildren, type NavLink } from "@/data/navigation";

/* The twelve, in catalogue order. The rest of the sub-menus are derived in
   `data/navigation.ts`; this one cannot be, because only an `.astro` file can
   read a content collection. */
const categories = (await getCollection("equipment")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

const childrenFor = (href: string): NavLink[] | undefined => {
  if (href === "/equipment") {
    return categories.map((category) => ({
      label: category.data.name,
      href: `/equipment/${category.id}`,
    }));
  }
  return navChildren[href];
};

const nav = mainNav.map((link) => ({
  ...link,
  children: childrenFor(link.href),
}));

/* "Current" matches by prefix so /equipment/generators lights Equipment.
   "/" is exact — otherwise it would light on every page. */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header
  id="site-header"
  data-tone="glass"
  class="fixed inset-x-4 top-4 z-50 mx-auto max-w-[1200px] rounded-md border max-mob:inset-x-3 max-mob:top-3"
>
  <div
    class="flex h-[64px] items-center justify-between px-7 max-mob:h-[56px] max-mob:px-4"
  >
    <Logo />

    <nav class="flex items-center gap-[30px] max-nav:hidden">
      {
        nav.map((link) => (
          <div class="nav-item relative">
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              aria-haspopup={link.children ? "true" : undefined}
              class="nav-link flex items-center gap-[5px] py-[21px] font-mono text-detail font-medium transition-colors duration-150"
            >
              {link.label}
              {link.children && (
                <Icon name="chevron-down" size={13} class="nav-caret" />
              )}
            </a>

            {link.children && (
              <div class="nav-panel-desktop absolute top-full left-1/2 pt-[10px]">
                <div class="card grid w-max grid-cols-2 gap-x-7 gap-y-[2px] p-[14px] shadow-[0_28px_60px_-30px_rgba(10,14,23,0.4)] max-cmp:grid-cols-1">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="sub-link rounded-sm px-[10px] py-[7px] text-note whitespace-nowrap text-muted transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        /* Opens the quote dialog. The `href` is the no-JS fallback and the
          middle-click destination — /contact renders the same form inline
          (docs/site-expansion/14 §2, §9a). Hidden below the nav breakpoint,
          where the same button lives at the foot of the menu panel. */
      }
      <Button
        size="xs"
        variant="primary"
        href="/contact"
        data-quote-open
        class="press max-nav:hidden"
      >
        Get a quote
      </Button>
      <button
        type="button"
        id="nav-toggle"
        class="hidden h-[38px] w-[38px] cursor-pointer items-center justify-center rounded-md border transition-colors max-nav:flex"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Open menu"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  {
    /* Below the nav breakpoint the six links live here. It shares the header's
     glass so it reads as the bar growing rather than a second surface. The
     panel scrolls on a short phone, hence its own `data-lenis-prevent` — Lenis
     is stopped while the menu is open (body overflow), and without the
     attribute it would swallow the wheel rather than let the panel move. */
  }
  <div
    id="nav-panel"
    class="nav-panel grid max-nav:border-t nav:hidden"
    data-lenis-prevent
    inert
  >
    <div class="overflow-hidden">
      <nav
        class="flex max-h-[calc(100dvh-var(--spacing-header)-32px)] flex-col overflow-y-auto px-7 py-4 max-mob:px-4"
        aria-label="Main"
      >
        {
          nav.map((link) =>
            link.children ? (
              <details class="nav-acc border-b">
                <summary class="nav-link flex cursor-pointer items-center justify-between py-[13px] font-mono text-base font-medium transition-colors">
                  {link.label}
                  <Icon name="chevron-down" size={15} class="nav-caret" />
                </summary>
                <div class="flex flex-col pb-3">
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? "page" : undefined}
                    class="sub-link py-[9px] pl-4 text-note font-medium"
                  >
                    All {link.label.toLowerCase()}
                  </a>
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="sub-link py-[9px] pl-4 text-note"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                class="nav-link border-b py-[13px] font-mono text-base font-medium transition-colors"
              >
                {link.label}
              </a>
            ),
          )
        }

        <Button
          size="md"
          variant="primary"
          href="/contact"
          data-quote-open
          class="press mt-5 mb-2 w-full"
        >
          Get a quote
        </Button>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Liquid glass: heavy blur + a saturation boost so whatever passes behind
     stays vivid, plus a 1px inner highlight reading as the "lit edge". */
  #site-header {
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    backdrop-filter: blur(20px) saturate(1.7);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  #site-header[data-tone="glass"] {
    background: rgba(10, 14, 23, 0.3);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 16px 48px -24px rgba(6, 10, 20, 0.55);
  }
  #site-header[data-tone="solid"] {
    background: rgba(255, 255, 255, 0.75);
    border-color: var(--color-line);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 16px 40px -28px rgba(10, 14, 23, 0.25);
  }

  #site-header[data-tone="glass"] .nav-link {
    color: rgba(255, 255, 255, 0.82);
    border-color: rgba(255, 255, 255, 0.12);
  }
  #site-header[data-tone="glass"] .nav-link:hover,
  #site-header[data-tone="glass"] .nav-link[aria-current="page"] {
    color: #fff;
  }
  #site-header[data-tone="solid"] .nav-link {
    color: var(--color-muted);
    border-color: var(--color-line);
  }
  #site-header[data-tone="solid"] .nav-link:hover {
    color: var(--color-ink);
  }
  #site-header[data-tone="solid"] .nav-link[aria-current="page"] {
    color: var(--color-brand);
  }

  /* ── The desktop sub-menus ──────────────────────────────────────
     Hover OR focus-within, so a keyboard reaches them without a line of
     JavaScript. The `pt-[10px]` on the positioner is a deliberate bridge: the
     panel has to start under the bar with no gap the pointer can fall through
     on its way down, or the menu closes while you are travelling to it. */
  .nav-panel-desktop {
    transform: translateX(-50%) translateY(-4px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.18s ease,
      transform 0.18s var(--ease-out-expo),
      visibility 0.18s;
  }
  .nav-item:hover .nav-panel-desktop,
  .nav-item:focus-within .nav-panel-desktop {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .nav-item:hover .nav-caret,
  .nav-item:focus-within .nav-caret {
    transform: rotate(180deg);
  }
  .nav-caret {
    transition: transform 0.2s var(--ease-out-expo);
  }

  .sub-link:hover,
  .sub-link:focus-visible {
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .sub-link[aria-current="page"] {
    color: var(--color-brand);
  }

  /* ── The mobile accordion ──────────────────────────────────────── */
  .nav-acc {
    border-color: inherit;
  }
  .nav-acc summary::-webkit-details-marker {
    display: none;
  }
  .nav-acc summary {
    list-style: none;
  }
  .nav-acc[open] .nav-caret {
    transform: rotate(180deg);
  }
  #site-header[data-tone="glass"] .sub-link {
    color: rgba(255, 255, 255, 0.62);
  }
  #site-header[data-tone="solid"] .sub-link {
    color: var(--color-muted);
  }
  /* The desktop panel is its own white surface in both tones — it sits over
     the page, not over whatever the bar is floating on. */
  .nav-panel-desktop .sub-link {
    color: var(--color-muted) !important;
  }

  #nav-toggle {
    border-color: currentColor;
  }
  #site-header[data-tone="glass"] #nav-toggle {
    color: rgba(255, 255, 255, 0.75);
  }
  #site-header[data-tone="solid"] #nav-toggle {
    color: var(--color-muted);
  }

  /* 0fr -> 1fr: the panel opens to its own height with no measuring and no
     inline styles — the same idiom the services accordion uses. */
  .nav-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s var(--ease-out-expo);
    border-color: inherit;
  }
  .nav-panel[data-open] {
    grid-template-rows: 1fr;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-panel,
    .nav-panel-desktop,
    .nav-caret {
      transition: none;
    }
  }

  /* The wordmark inherits currentColor — flip it white while over a photo. */
  #site-header :global(.text-brand) {
    transition: color 0.35s ease;
  }
  #site-header[data-tone="glass"] :global(.text-brand) {
    color: #fff;
  }
</style>

<script>
  import { untilPageSwap } from "@/scripts/untilPageSwap";
  import { initThemeFlip } from "@/scripts/themeFlip";
  import { initReveal } from "@/scripts/reveal";

  // Re-runs after every client-router navigation as well as on first load,
  // so the swapped-in DOM gets wired up.
  document.addEventListener("astro:page-load", () => {
    const gone = untilPageSwap();
    const header = document.getElementById("site-header")!;

    initThemeFlip(header, gone);
    // The header is on every page, so it is the one script guaranteed to run —
    // which makes it the right place to arm the page's reveals.
    initReveal();

    const toggle = document.getElementById("nav-toggle");
    const panel = document.getElementById("nav-panel");
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.toggleAttribute("data-open", open);
      // Collapsed to 0fr the links are invisible but still tabbable — `inert`
      // is what actually takes them out of the tab order and the a11y tree.
      panel.toggleAttribute("inert", !open);
      // `autoToggle` on Lenis reads this and stands down while the menu is up.
      document.body.style.overflow = open ? "hidden" : "";
      // Every accordion shuts with the sheet, so it reopens as a list of six
      // rather than wherever it was left.
      if (!open) {
        for (const acc of panel.querySelectorAll("details[open]")) {
          acc.removeAttribute("open");
        }
      }
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    // The router swaps the page under an open menu — close it on the way out.
    document.addEventListener("astro:before-swap", () => setOpen(false), {
      once: true,
    });
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key !== "Escape") return;
        setOpen(false);
        // A desktop sub-menu is held open by :focus-within, so Escape has to
        // move the focus out of it — there is no state to clear.
        const active = document.activeElement;
        if (active instanceof HTMLElement && active.closest(".nav-item")) {
          active.blur();
        }
      },
      { signal: gone },
    );
  });
</script>
