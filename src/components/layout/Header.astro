---
/**
 * Floating glass header — a pill bar inset from the viewport edges.
 * Smoked glass over the hero (the video reads through it), switching to
 * frosted white once scrolled past the hero. Tone lives on `data-tone`.
 */
import Logo from "@/components/ui/Logo.astro";
import Button from "@/components/ui/Button.astro";
import { mainNav } from "@/data/navigation";
---

<header
  id="site-header"
  data-tone="glass"
  class="fixed inset-x-4 top-4 z-50 mx-auto max-w-[1200px] rounded-2xl border max-mob:inset-x-3 max-mob:top-3"
>
  <div
    class="flex h-[64px] items-center justify-between px-7 max-mob:h-[56px] max-mob:px-4"
  >
    <Logo />

    <nav class="flex items-center gap-[36px] max-nav:hidden">
      {
        mainNav.map((link) => (
          <a
            href={link.href}
            class="nav-link text-detail font-medium transition-colors duration-150"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <Button variant="primary" href="/#contact" class="max-xs:px-4">
        Get a quote
      </Button>
    </div>
  </div>
</header>

<style>
  /* Liquid glass: heavy blur + a saturation boost so whatever passes behind
     stays vivid, plus a 1px inner highlight reading as the "lit edge". */
  #site-header {
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    backdrop-filter: blur(20px) saturate(1.7);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }
  #site-header[data-tone="glass"] {
    background: rgba(10, 14, 23, 0.3);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 16px 48px -24px rgba(6, 10, 20, 0.55);
  }
  #site-header[data-tone="solid"] {
    background: rgba(255, 255, 255, 0.75);
    border-color: var(--color-line);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 16px 40px -28px rgba(10, 14, 23, 0.25);
  }

  #site-header[data-tone="glass"] .nav-link {
    color: rgba(255, 255, 255, 0.82);
  }
  #site-header[data-tone="glass"] .nav-link:hover {
    color: #fff;
  }
  #site-header[data-tone="solid"] .nav-link {
    color: var(--color-muted);
  }
  #site-header[data-tone="solid"] .nav-link:hover {
    color: var(--color-ink);
  }

  /* The wordmark inherits currentColor — flip it white while over the video. */
  #site-header :global(.text-brand) {
    transition: color 0.35s ease;
  }
  #site-header[data-tone="glass"] :global(.text-brand) {
    color: #fff;
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const hero = document.querySelector<HTMLElement>(".hero");
  let ticking = false;

  // Pages without a hero have light backgrounds — frosted white from the start.
  const apply = () => {
    const limit = hero ? hero.offsetHeight - 84 : -1;
    header.dataset.tone = window.scrollY > limit ? "solid" : "glass";
    ticking = false;
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(apply);
    }
  };

  apply();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
