---
/** Fixed call + WhatsApp quick-contact buttons. */
import { site } from "@/config/site";
import Icon from "@/components/ui/Icon.astro";

const btnBase =
  "w-14 h-14 rounded-md flex items-center justify-center text-white shadow-[0_8px_22px_rgba(0,0,0,0.25)] transition-transform duration-150 hover:scale-[1.08] max-xs:w-[46px] max-xs:h-[46px]";
---

{
  /* The id is what global.css pulls out of the page transition — fixed chrome
    that slides with the content makes a swap read as a lurch. */
}
<div
  id="floating-buttons"
  class="fixed right-[26px] bottom-[26px] z-[60] flex flex-col gap-3 max-xs:right-[14px] max-xs:bottom-[14px] max-xs:gap-2"
>
  <a
    href={site.phone.href}
    class:list={[btnBase, "bg-brand"]}
    aria-label={`Call ${site.name}`}
  >
    <Icon name="phone" size={22} class="max-xs:h-[18px] max-xs:w-[18px]" />
  </a>
  <a
    href={site.whatsapp.href}
    target="_blank"
    rel="noopener"
    class:list={[btnBase, "bg-whatsapp"]}
    aria-label={`WhatsApp ${site.name}`}
  >
    <Icon name="whatsapp" size={24} class="max-xs:h-[20px] max-xs:w-[20px]" />
  </a>
</div>
