---
/** Site-wide footer — light surface matching the blue/white system. */
import Logo from "@/components/ui/Logo.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
import { footerColumns } from "@/data/navigation";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface pt-24 text-muted max-mob:pt-16">
  <div class="wrap">
    <div
      class="grid grid-cols-[1.4fr_0.9fr_0.9fr_1fr] gap-12 border-b border-line pb-16 max-nav:grid-cols-2 max-nav:gap-10 max-cmp:grid-cols-1"
    >
      <!-- Brand -->
      <div>
        <Logo />
        <p class="mt-5 mb-6 max-w-[280px] text-sm leading-relaxed text-muted">
          {site.blurb}
        </p>
        <div class="flex gap-[10px]">
          {
            site.social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-line-strong text-muted transition-colors hover:border-brand hover:text-brand"
              >
                <Icon name={s.icon} size={15} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Link columns -->
      {
        footerColumns.map((col) => (
          <div>
            <h5 class="mb-5 text-meta font-semibold tracking-[1.5px] text-ink uppercase">
              {col.title}
            </h5>
            <ul class="flex flex-col gap-[11px]">
              {col.links.map((link) => (
                <li class="text-sm">
                  <a href={link.href} class="transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Contact -->
      <div>
        <h5
          class="mb-5 text-meta font-semibold tracking-[1.5px] text-ink uppercase"
        >
          Contact
        </h5>
        <ul class="flex flex-col gap-[11px] text-sm">
          <li>{site.address}</li>
          <li>
            <a href={site.phone.href} class="transition-colors hover:text-ink">
              {site.phone.display}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.email}`}
              class="transition-colors hover:text-ink"
            >
              {site.email}
            </a>
          </li>
          <li class="text-faint">{site.hours}</li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-wrap justify-between gap-[10px] py-7 text-meta text-faint max-xs:flex-col max-xs:items-start max-xs:gap-2"
    >
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span>{site.credit}</span>
    </div>
  </div>
</footer>
