---
/** Site-wide footer — light surface matching the blue/white system. */
import Logo from "./ui/Logo.astro";
import Icon from "./ui/Icon.astro";
import { site } from "../config/site";
import { footerColumns } from "../data/navigation";

const year = new Date().getFullYear();
---

<footer class="bg-surface border-t border-line text-muted pt-24 max-mob:pt-16">
  <div class="wrap">
    <div
      class="grid grid-cols-[1.4fr_0.9fr_0.9fr_1fr] gap-12 pb-16 border-b border-line max-nav:grid-cols-2 max-nav:gap-10 max-cmp:grid-cols-1"
    >
      <!-- Brand -->
      <div>
        <Logo variant="header" />
        <p class="text-[14px] leading-relaxed text-muted mt-5 mb-6 max-w-[280px]">
          {site.blurb}
        </p>
        <div class="flex gap-[10px]">
          {
            site.social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="w-9 h-9 border border-line-strong rounded-full flex items-center justify-center text-muted transition-colors hover:border-brand hover:text-brand"
              >
                <Icon name={s.icon} size={15} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Link columns -->
      {
        footerColumns.map((col) => (
          <div>
            <h5 class="text-ink text-[13px] font-semibold tracking-[1.5px] uppercase mb-5">
              {col.title}
            </h5>
            <ul class="flex flex-col gap-[11px]">
              {col.links.map((link) => (
                <li class="text-[14px]">
                  <a
                    href={link.href}
                    class="transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Contact -->
      <div>
        <h5 class="text-ink text-[13px] font-semibold tracking-[1.5px] uppercase mb-5">
          Contact
        </h5>
        <ul class="flex flex-col gap-[11px] text-[14px]">
          <li>{site.address}</li>
          <li>
            <a href={site.phone.href} class="transition-colors hover:text-ink">
              {site.phone.display}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.email}`}
              class="transition-colors hover:text-ink"
            >
              {site.email}
            </a>
          </li>
          <li class="text-faint">{site.hours}</li>
        </ul>
      </div>
    </div>

    <div
      class="py-7 flex justify-between flex-wrap gap-[10px] text-[13px] text-faint max-xs:flex-col max-xs:items-start max-xs:gap-2"
    >
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span>{site.credit}</span>
    </div>
  </div>
</footer>
