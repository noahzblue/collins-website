---
/** Site-wide footer. */
import Logo from "./ui/Logo.astro";
import { site } from "../config/site";
import { footerColumns } from "../data/navigation";

const year = new Date().getFullYear();
---

<footer id="contact" class="bg-ink text-[#bdbdbd] pt-20 max-mob:pt-14">
  <div class="wrap">
    <div
      class="grid grid-cols-[1.3fr_0.8fr_0.8fr_1fr] gap-[44px] pb-[60px] border-b border-[#262626] max-nav:grid-cols-2 max-cmp:grid-cols-1"
    >
      <!-- Brand -->
      <div>
        <Logo variant="footer" />
        <p class="text-[13.5px] text-[#999] mt-4 mb-[22px] max-w-[280px]">
          {site.blurb}
        </p>
        <div class="flex gap-[10px]">
          {
            site.social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="w-9 h-9 border border-[#333] rounded-full flex items-center justify-center text-[13px] transition-colors hover:border-brand-bright hover:text-brand-bright"
              >
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Link columns -->
      {
        footerColumns.map((col) => (
          <div>
            <h5 class="relative text-white text-[13px] font-extrabold tracking-[1.5px] uppercase mb-2 pb-3 after:content-[''] after:absolute after:left-0 after:bottom-0 after:w-[28px] after:h-[2px] after:bg-brand-bright">
              {col.title}
            </h5>
            <ul class="mt-[14px]">
              {col.links.map((link) => (
                <li class="mb-[10px] text-[13.5px]">
                  <a href={link.href} class="transition-colors hover:text-brand-bright">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <!-- Contact -->
      <div>
        <h5 class="relative text-white text-[13px] font-extrabold tracking-[1.5px] uppercase mb-2 pb-3 after:content-[''] after:absolute after:left-0 after:bottom-0 after:w-[28px] after:h-[2px] after:bg-brand-bright">
          Contact
        </h5>
        <ul class="mt-[14px]">
          <li class="mb-[10px] text-[13.5px]">{site.address}</li>
          <li class="mb-[10px] text-[13.5px]">{site.phone.display}</li>
          <li class="mb-[10px] text-[13.5px]">{site.email}</li>
        </ul>
      </div>
    </div>

    <div
      class="py-6 flex justify-between flex-wrap gap-[10px] text-[12.5px] text-[#777] max-xs:flex-col max-xs:items-start max-xs:gap-2"
    >
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span>{site.credit}</span>
    </div>
  </div>
</footer>
