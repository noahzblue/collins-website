---
/**
 * "Buy it, or hire the same machine." — the company profile's clearest
 * statement of what the business is, which appeared nowhere on the site.
 * Worse, the hero used to imply the opposite order.
 *
 * **One block of markup, one behaviour: everything is open.**
 *
 * Side by side (≥ nav) the two modes are two columns split by a hairline.
 * That is the argument the section is making made visible: sales and rental
 * are the same fleet on two sets of terms, and you can read both answers at
 * once instead of trading one for the other. There is no photograph and no
 * dark band — the sentence "buy it, or hire the same machine" does not need
 * illustrating, and stripping the band back to the page white puts the two
 * words SALES and RENTAL at the top of the visual hierarchy where they belong.
 *
 * Stacked (< nav) the columns become rows and **stay open**. This used to
 * collapse into an auto-advancing accordion, on the theory that a phone could
 * not afford both answers at once. It could: the two panels are four lines of
 * copy and a link each. What the accordion actually bought was a section that
 * hid half of its own argument behind a tap, on a page whose entire point is
 * that the two halves belong together — and it spent a rotator, a progress
 * line, an 8s timer, a resize listener and the whole WAI-ARIA accordion
 * pattern to do it. Removed 2026-09-10 (~200px of extra height, and the
 * section says what it means on every screen).
 *
 * There is therefore nothing to press. The head is a plain `<h3>`, not a
 * `<button>` — a control that never controls anything is worse than no
 * control, and a keyboard user should not find one in the tab order.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { supplyModes } from "@/data/content";
---

{
  /* A hairline top edge: the section above it is also white, and without a
     boundary the two run together. */
}
<Section id="supply" class="border-t border-line">
  <div class="wrap">
    <Eyebrow class="mb-[16px]">{supplyModes.eyebrow}</Eyebrow>
    <h2
      class="max-w-[760px] text-h2 leading-[1.06] max-cmp:leading-[1.12]"
      data-reveal="lines"
      set:html={supplyModes.title.join("<br>")}
    />

    <div
      class="modes mt-[68px] max-mob:mt-[44px] max-cmp:mt-[26px]"
      data-reveal
    >
      {
        supplyModes.modes.map((mode, i) => (
          <div class="mode">
            <h3 class="mode-head relative flex items-center gap-7 py-[34px] max-mob:gap-5 max-mob:py-[26px] max-cmp:gap-4 max-cmp:py-[17px]">
              <span class="mode-num font-mono text-micro tracking-[2px]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="mode-label font-mono text-[clamp(28px,3.4vw,44px)] leading-[1] tracking-[-0.03em] uppercase max-cmp:text-[clamp(23px,6.6vw,28px)]">
                {mode.label}
              </span>

              {/* The rule under the head. Side by side it reaches back out
                  through the column padding to meet the divider, which is why
                  it is a positioned span and not a `border-b`. */}
              <span
                class="mode-rule absolute inset-x-0 bottom-0 h-px bg-line"
                aria-hidden="true"
              />
            </h3>

            <div class="max-w-[440px] pt-[30px] pb-[56px] max-mob:pt-[24px] max-mob:pb-[40px] max-cmp:pt-[15px] max-cmp:pb-[26px]">
              <span class="block font-mono text-label font-medium tracking-[2px] text-brand uppercase">
                {mode.lead}
              </span>
              <p class="mt-5 mb-0 text-lead-lg leading-relaxed text-muted max-cmp:mt-3">
                {mode.body}
              </p>
              <Button
                variant="outline"
                href={mode.cta.href}
                size="lg"
                class="press mt-9 max-cmp:mt-5"
              >
                {mode.cta.label}
                <Icon
                  name="arrow-right"
                  size={16}
                  class="max-cmp:h-[14px] max-cmp:w-[14px]"
                />
              </Button>
            </div>
          </div>
        ))
      }
    </div>

    <p
      class="mt-14 mb-0 max-w-[760px] border-t border-line pt-4 text-tag leading-relaxed text-muted uppercase max-mob:mt-9 max-mob:pt-7 max-cmp:mt-6 max-cmp:pt-4"
      data-reveal
    >
      {supplyModes.footnote}
    </p>
  </div>
</Section>

<style>
  /* ---- Stacked: two rows. Also the base state, so a viewport this component
     has no rule for gets the layout that works at any width. ---- */

  .mode-head {
    margin: 0;
  }
  .mode-num {
    color: var(--color-faint);
  }
  .mode-label {
    color: var(--color-ink);
  }

  /* ---- Side by side: two columns. ---- */
  @media (min-width: 981px) {
    .modes {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    /* The divider is a border on the second column rather than a gap, so it
       runs the full height of the taller of the two. */
    .mode:first-child {
      padding-right: 64px;
    }
    .mode + .mode {
      border-left: 1px solid var(--color-line);
      padding-left: 64px;
    }
    /* …and the rule under each label reaches back out through that padding to
       meet the divider, so the two halves read as one continuous line rather
       than as two rules that stop short at different places. */
    .mode:first-child .mode-rule {
      right: -64px;
    }
    .mode + .mode .mode-rule {
      left: -64px;
    }
  }
</style>
