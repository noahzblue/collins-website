---
/**
 * Equipment teaser — the six `featured` categories; the full twelve live on
 * /equipment. Reads the same collection as the hub and the category pages, so
 * the homepage can't drift from the catalogue.
 *
 * It is deliberately NOT six cards. Cards on a light background are the most
 * generic thing a marketing page can do: a border, a radius, a shadow, a
 * padded body and two badges, six times over. This is one block of
 * photography divided by hairlines — the machines are the content, and the
 * only chrome is the line between them.
 *
 * Two mechanics carry it:
 *
 * a) **The hairlines are the gap.** `gap: 1px` over a `--color-line`
 *    background paints every divider, interior and exterior, at exactly one
 *    device pixel with no double-borders to collapse and nothing to get out of
 *    step when a column count changes.
 *
 * b) **Hovering re-proportions the whole grid, not the tile.** The container
 *    animates `grid-template-columns` / `-rows`, so the pointed-at cell takes
 *    space FROM its neighbours instead of scaling on top of them. Nothing
 *    overlaps, nothing lifts, the outer block never changes size, and the
 *    photos re-crop as the cells breathe. `aspect-ratio` on the container is
 *    what makes the row half of that work: `fr` rows need a definite height,
 *    or growing one row would grow the section and shove the page down.
 *
 * Below the nav breakpoint the re-proportioning is dropped entirely — it is a
 * pointer effect, and a touch device would only ever see the resting state.
 */
import { getCollection } from "astro:content";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Icon from "@/components/ui/Icon.astro";
import BgImage from "@/components/ui/BgImage.astro";
import ViewAllBar from "@/components/ui/ViewAllBar.astro";
import { fleet } from "@/data/content";

const featured = (await getCollection("equipment"))
  .filter((category) => category.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const COLUMNS = 3;
---

<Section id="equipment" tone="gray">
  <div class="wrap">
    <SectionHeading
      eyebrow={fleet.eyebrow}
      title={fleet.title}
      intro={fleet.intro}
    />

    <div class="cat-grid" data-reveal>
      {
        featured.map((category, i) => (
          <a
            href={`/equipment/${category.id}`}
            class="tile group relative overflow-clip"
            data-col={i % COLUMNS}
            data-row={Math.floor(i / COLUMNS)}
          >
            {/* A category still waiting on a hero image gets the quiet
                neutral tile behind it rather than `url('undefined')`. */}
            {category.data.heroImage && (
              <BgImage src={category.data.heroImage} class="tile-photo" />
            )}

            {/* Dark at the base only — the name has to hold at any crop the
                cell settles into, and a full-tile scrim would grey out six
                photographs to protect two words. */}
            <span
              class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,20,0)_45%,rgba(6,10,20,0.34)_68%,rgba(6,10,20,0.82)_100%)]"
              aria-hidden="true"
            />

            <span class="absolute right-6 bottom-6 left-6 flex items-end justify-between gap-4 max-xs:right-5 max-xs:bottom-5 max-xs:left-5">
              <span class="font-mono text-subhead leading-[1.15] tracking-[-0.01em] text-white uppercase">
                {category.data.name}
              </span>
              <span class="tile-view flex shrink-0 items-center gap-[7px] font-mono text-tag tracking-[1.4px] text-white uppercase">
                View
                <Icon name="arrow-up-right" size={14} />
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <ViewAllBar
      href={fleet.viewAll.href}
      label={fleet.viewAll.label}
      class="mt-[64px] max-mob:mt-[40px]"
    />
  </div>
</Section>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    /* Six 4:3 cells in a 3 × 2 block. Definite height — see (b) above. */
    aspect-ratio: 2 / 1;

    /* The dividers. One background, one gap; no per-tile borders. */
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: clip;

    transition:
      grid-template-columns 680ms var(--ease-out-expo),
      grid-template-rows 680ms var(--ease-out-expo);
  }

  .tile {
    background: var(--color-surface-2);
  }
  /* `.tile-photo` is on <BgImage>'s root, which carries BgImage's OWN Astro
     scope id, not this file's — a bare `.tile-photo {}` here would compile to
     a selector that can never match. `:global()` nested under `.tile` (which
     this file does own) is the fix, and keeps the rule from leaking past this
     component. Same trap as the crossfade in TrustStrip. */
  .tile :global(.tile-photo) {
    transition: filter 520ms var(--ease-out-expo);
    filter: saturate(0.92);
  }
  .tile:hover :global(.tile-photo),
  .tile:focus-visible :global(.tile-photo) {
    filter: saturate(1.06);
  }

  .tile-view {
    opacity: 0;
    translate: -6px 0;
    transition:
      opacity 320ms var(--ease-out-expo),
      translate 320ms var(--ease-out-expo);
  }
  .tile:hover .tile-view,
  .tile:focus-visible .tile-view {
    opacity: 1;
    translate: 0 0;
  }

  /* The re-proportioning. Pointer devices on the full three-column layout
     only — the column/row maps below are written for that grid shape. */
  @media (min-width: 981px) and (hover: hover) and (pointer: fine) {
    .cat-grid {
      --grow: 1.26fr;
      --shrink: 0.87fr;
    }
    .cat-grid:has(.tile[data-col="0"]:hover) {
      grid-template-columns: var(--grow) var(--shrink) var(--shrink);
    }
    .cat-grid:has(.tile[data-col="1"]:hover) {
      grid-template-columns: var(--shrink) var(--grow) var(--shrink);
    }
    .cat-grid:has(.tile[data-col="2"]:hover) {
      grid-template-columns: var(--shrink) var(--shrink) var(--grow);
    }
    .cat-grid:has(.tile[data-row="0"]:hover) {
      grid-template-rows: var(--grow) var(--shrink);
    }
    .cat-grid:has(.tile[data-row="1"]:hover) {
      grid-template-rows: var(--shrink) var(--grow);
    }
  }

  @media (max-width: 980px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
      grid-auto-rows: auto;
      aspect-ratio: auto;
      transition: none;
    }
    .tile {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 600px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-grid,
    .tile-view,
    .tile :global(.tile-photo) {
      transition: none;
    }
  }
</style>
