---
/**
 * Equipment teaser — the six `featured` categories; the full twelve live on
 * /equipment. Reads the same collection as the hub and the category pages, so
 * the homepage can't drift from the catalogue.
 *
 * It is deliberately NOT six cards. Cards on a light background are the most
 * generic thing a marketing page can do: a border, a radius, a shadow, a
 * padded body and two badges, six times over. This is one block of
 * photography divided by hairlines — the machines are the content, and the
 * only chrome is the line between them.
 *
 * **The hairlines are the gap.** `gap: 1px` over a `--color-line` background
 * paints every divider, interior and exterior, at exactly one device pixel
 * with no double-borders to collapse and nothing to get out of step when a
 * column count changes.
 *
 * The grid does not react to the pointer. It used to re-proportion itself on
 * hover — the pointed-at cell taking space from its neighbours — which was
 * pretty and was also the block moving under the reader's cursor while they
 * were still reading it. Six photographs holding perfectly still is the
 * stronger version, and it is the same block on touch as on a mouse. Each
 * tile carries its "View" affordance permanently instead of revealing one:
 * a link that has to be hovered before it admits it is a link is a worse
 * link, not a subtler one.
 */
import { getCollection } from "astro:content";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Icon from "@/components/ui/Icon.astro";
import ParallaxImage from "@/components/ui/ParallaxImage.astro";
import ViewAllBar from "@/components/ui/ViewAllBar.astro";
import { fleet } from "@/data/content";

const featured = (await getCollection("equipment"))
  .filter((category) => category.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<Section id="equipment" tone="gray">
  <div class="wrap">
    <SectionHeading
      eyebrow={fleet.eyebrow}
      title={fleet.title}
      intro={fleet.intro}
    />

    <div class="cat-grid" data-reveal>
      {
        featured.map((category) => (
          <a
            href={`/equipment/${category.id}`}
            class="tile group relative overflow-clip"
          >
            {/* A category still waiting on a hero image gets the quiet
                neutral tile behind it rather than `url('undefined')`. */}
            {category.data.heroImage && (
              <ParallaxImage
                src={category.data.heroImage}
                class="absolute inset-0"
              />
            )}

            {/* Dark at the base only — the name has to hold at any crop the
                cell settles into, and a full-tile scrim would grey out six
                photographs to protect two words. */}
            <span
              class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,20,0)_45%,rgba(6,10,20,0.34)_68%,rgba(6,10,20,0.82)_100%)]"
              aria-hidden="true"
            />

            <span class="absolute right-6 bottom-6 left-6 flex items-end justify-between gap-4 max-cmp:right-4 max-cmp:bottom-4 max-cmp:left-4 max-cmp:gap-2">
              <span class="font-mono text-subhead leading-[1.15] tracking-[-0.01em] text-white uppercase">
                {category.data.name}
              </span>
              <span class="flex shrink-0 items-center gap-[7px] font-mono text-tag tracking-[1.4px] text-white/80 uppercase transition-all duration-200 ease-in-out group-hover:text-label group-hover:font-bold group-hover:text-brand-bright">
                View
                <Icon name="arrow-up-right" size={14} class="" />
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <ViewAllBar
      href={fleet.viewAll.href}
      label={fleet.viewAll.label}
      class="mt-[64px] max-mob:mt-[40px] max-cmp:mt-[26px]"
    />
  </div>
</Section>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    /* Six 4:3 cells in a 3 × 2 block. */
    aspect-ratio: 2 / 1;

    /* The dividers. One background, one gap; no per-tile borders. */
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: clip;
  }

  .tile {
    background: var(--color-surface-2);
  }

  @media (max-width: 980px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
      grid-auto-rows: auto;
      aspect-ratio: auto;
    }
    .tile {
      aspect-ratio: 4 / 3;
    }
  }
  /* On a phone the block turns on its side.
  
     Stacked one per row, six 4:3 photographs are 1,600px of column — five
     screens of scrolling to look at six words, and the reader has to spend all
     of it to find out there is a seventh screen underneath. Turned sideways it
     is one screen: the same block, the same hairlines, the same tiles, laid
     along the axis that has room instead of the one that doesn't.
  
     It stays a GRID rather than becoming a flex strip, because the hairlines
     here are the `gap` over a line-coloured background — the divider between
     tile 3 and tile 4 exists only as long as they are cells of one grid.
     `grid-auto-flow: column` keeps every one of them and costs one property.
  
     Tiles are 74% wide, so the next one is always half in frame: the overflow
     is the affordance and the rail needs no arrows, dots or instructions —
     the same argument /yard's fleet strip makes for the same shape.

     Square, not the 3:4 they started at. A portrait tile is right when tiles
     stack — it fills a column that has width to spare. In a rail the width is
     already spent and the height is pure cost, so the crop that was carrying
     its weight vertically is just making the band taller than the machine in
     it needs. 1:1 takes ~90px off the section and loses nothing: these are
     photographs of wide objects.
  
     `overscroll-behavior-x: contain` is what Lenis reads to stand off the
     horizontal axis while a vertical swipe over the rail still scrolls the
     page (scripts/scroll.ts, `allowNestedScroll`). Not `data-lenis-prevent` —
     that stops the page dead.
  
     The photos hold still in here. `ParallaxImage` resolves its drift against
     the nearest scroll container, which below this breakpoint is the rail
     rather than the page, so the timeline is inert — which is exactly what
     this grid wants anyway ("The grid does not react to the pointer"), and the
     zoom covers the parked crop either way. */
  @media (max-width: 600px) {
    .cat-grid {
      grid-template-columns: none;
      grid-template-rows: none;
      grid-auto-flow: column;
      grid-auto-columns: 74%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .cat-grid::-webkit-scrollbar {
      display: none;
    }
    .tile {
      aspect-ratio: 1 / 1;
      scroll-snap-align: start;
    }
  }
</style>
