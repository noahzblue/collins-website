---
/**
 * Equipment teaser — the six `featured` categories; the full twelve live on
 * /equipment. Reads the same collection as the hub and the category pages, so
 * the homepage can't drift from the catalogue.
 */
import { getCollection } from "astro:content";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import CategoryCard from "../equipment/CategoryCard.astro";
import { fleet } from "../../data/content";

const featured = (await getCollection("equipment"))
  .filter((category) => category.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<Section id="equipment" tone="gray">
  <div class="wrap">
    <SectionHeading
      eyebrow={fleet.eyebrow}
      title={fleet.title}
      intro={fleet.intro}
    />

    <div class="grid grid-cols-3 gap-5 max-nav:grid-cols-2 max-cmp:grid-cols-1">
      {
        featured.map((category) => (
          /* Number is the catalogue position out of twelve, matching the hub —
             so the sequence reads 01, 02, 03, 05, 09, 10 rather than 01–06. */
          <CategoryCard
            category={category}
            index={category.data.sortOrder}
            showCardLine={false}
          />
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href={fleet.viewAll.href}
        class="inline-flex items-center gap-2 text-[15px] font-semibold text-ink transition-colors hover:text-brand"
      >
        {fleet.viewAll.label}
        <Icon name="arrow-right" size={17} />
      </a>
    </div>
  </div>
</Section>
