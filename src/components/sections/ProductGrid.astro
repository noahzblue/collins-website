---
/** Product catalogue grid. Cards are full-bleed with a hover flip to dark. */
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { products } from "../../data/catalog";
import { fleet } from "../../data/content";
---

<Section id="products">
  <div class="wrap">
    <SectionHeading
      eyebrow={fleet.eyebrow}
      title={fleet.title}
      intro={fleet.intro}
    />
  </div>

  <div
    class="grid grid-cols-3 gap-[2px] bg-[#e7e7e7] max-nav:grid-cols-2 max-cmp:grid-cols-1"
  >
    {
      products.map((product) => (
        <a
          href={product.href}
          class="group relative flex flex-col justify-end overflow-hidden min-h-[230px] bg-white px-[30px] py-[38px] transition-[background] duration-200 hover:bg-ink max-xs:px-5 max-xs:py-[26px] max-xs:min-h-[170px]"
        >
          <span class="absolute top-[26px] right-[30px] font-display text-[15px] text-[#d8d8d8]">
            {product.num}
          </span>
          <span class="font-display text-[28px] tracking-[0.5px] mb-2 transition-colors duration-200 group-hover:text-white max-xs:text-[20px]">
            {product.title}
          </span>
          <span class="text-[13.5px] text-[#777] mb-5 transition-colors duration-200 group-hover:text-white">
            {product.sub}
          </span>
          <span class="flex items-center justify-center w-[38px] h-[38px] rounded-full border-2 border-ink text-[16px] transition-all duration-200 group-hover:bg-brand-bright group-hover:text-white group-hover:translate-x-1">
            →
          </span>
        </a>
      ))
    }
  </div>
</Section>
