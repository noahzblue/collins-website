---
/**
 * Contact CTA — the quote form's opening question, asked on the homepage.
 *
 * **This band used to carry a form of its own, and it was the wrong form.** It
 * asked for more and collected less: it required an email the real form
 * deliberately makes optional, split the name in two, never asked the size —
 * the single most useful fact for producing a quotation — and offered "Buy or
 * rent" where the site says *hire* and the form offers a third answer, because
 * customers move between the two. Its WhatsApp message was a different shape
 * as well, so the yard read two lead formats. Removed 2026-08-22; the real
 * form now lives in a dialog on every page and inline on /contact
 * (docs/site-expansion/14 §2).
 *
 * What replaced it is the form's own opening question. Buy or hire is the
 * site's core distinction and the cheapest possible thing to ask — one tap, no
 * thinking — which is exactly why the form opens with it (§3). Putting it here
 * means the closing band asks something rather than announcing something, and
 * the tap arrives at the machine picker with section 01 already half answered.
 *
 * The three options are `MODES`, not literals: the homepage cannot word the
 * question differently to the form it opens.
 *
 * **The band is written in the form's voice, not the homepage's.** Every other
 * section here heads itself with `ui/SectionHeading.astro` — sentence case,
 * display face, the editorial register. This one is the form's front door, so
 * it borrows /contact's: the same split head, but mono and uppercase, over
 * `.rule-brand` — the rule that starts brand and stops, which is what the
 * dialog and the inline mount both draw under their titles.
 *
 * **The three answers are one row, not three links in a column.** A hairline
 * between each is the whole separation — no surface, no lattice: they sit on
 * the section's own ground, which is what keeps a closing band from reading as
 * three cards bolted to the bottom of the page. (`.mesh` was tried and
 * rejected on review — it paints white, and a white panel on the grey band
 * turns three answers into three objects.)
 *
 * A column also has room for the line that says what the difference actually
 * is, which a chip at the top of the form does not — the hints come from
 * `MODES` so the two can't drift.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/config/site";
import { contactSection } from "@/data/content";
import { MODES } from "@/lib/quote/options";
---

<Section id="contact" tone="gray">
  <div class="wrap">
    {
      /* The head: `ui/SectionHeading.astro`'s split, redrawn here rather than
        imported, because the whole point is that this one is set in the mono
        structural face and that component is the editorial one. */
    }
    <div
      class="rule-brand mb-10 flex flex-wrap items-end justify-between gap-x-10 gap-y-6 pb-9 max-mob:pb-7"
    >
      <div>
        <Eyebrow class="mb-4">{contactSection.eyebrow}</Eyebrow>
        <h2 class="cta-title" set:html={contactSection.title.join("<br>")} />
      </div>
      <p class="mb-0 max-w-[430px] text-lead leading-relaxed text-muted">
        {contactSection.body}
      </p>
    </div>

    <!-- Instruction left, promise right — the dialog head's own arrangement,
         one scale down, sitting on the control it introduces. -->
    <!-- <div
      class="mt-9 mb-5 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2"
    >
      <Eyebrow>{contactSection.start}</Eyebrow>
      <p class="mb-0 text-detail text-muted">{site.quotePromise}</p>
    </div> -->

    {
      /* Links, not radios: choosing one is a navigation into the form, not an
        answer held on this page — and here it is a navigation in the plainest
        sense. The homepage does not open the dialog (`scripts/quote/dialog.ts`
        header), so these three are ordinary links to the page that is
        entirely the form, and the answer travels in the URL for /contact to
        pick up. No JavaScript is involved in any part of that, which is the
        other reason it is the right shape for the closing band. */
    }
    <ul class="grid grid-cols-3 max-nav:grid-cols-1">
      {
        MODES.map((option) => (
          <li class="mode-item flex">
            <a href={`/contact?mode=${option.value}#quote`} class="mode-cell">
              <span class="mode-top">
                <span class="mode-face">{option.label}</span>
                <span class="mode-arrow shrink-0">
                  <Icon name="arrow-right" size={20} />
                </span>
              </span>
              <span class="mode-hint">{option.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  /* /contact's headline treatment, on the homepage: mono, uppercase, tracked
     tight — the structural rung `h1` and `h4` occupy everywhere else on the
     site. It drops a rung on the smallest phones, where mono at 30px and a
     seventeen-character line do not both fit. */
  .cta-title {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.025em;
  }
  @media (max-width: 520px) {
    .cta-title {
      font-size: var(--text-h3);
    }
  }

  /* One column of the row. The anchor fills its `<li>` rather than sitting
     inside it, so the whole column is the target — on a phone these three are
     the largest tap targets on the page and it would be a waste to make the
     word the only live part of them.

     The inset is asymmetric on purpose. It belongs *after* the separator, not
     around the column, so the first label lines up with the eyebrow and the
     headline above it and the last one ends on the same margin as the rule
     over them both. A symmetric pad would push the whole row 40px in from a
     page that is otherwise flush. */
  .mode-item + .mode-item {
    border-left: 1px solid var(--color-line-strong);
  }
  .mode-cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 40px;
  }
  .mode-item + .mode-item .mode-cell {
    padding-left: 40px;
  }
  .mode-item:last-child .mode-cell {
    padding-right: 0;
  }

  .mode-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  /* The `display` face of `ui/ChipGroup.astro`, rule and all — with nothing
     filling behind it, that component's note applies exactly: at this size a
     wash reads as highlighted text rather than as a chosen answer, so the rule
     does all of it.

     One departure: ink rather than faint at rest. Faint is that component's
     "not yet answered" state, earned back by picking one; a link that never
     gets picked would just sit there looking disabled. */
  .mode-face {
    display: block;
    border-bottom: 2px solid transparent;
    padding-bottom: 7px;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    transition:
      color 200ms var(--ease-out-expo),
      border-color 200ms var(--ease-out-expo);
  }
  .mode-hint {
    font-size: var(--text-detail);
    line-height: 1.55;
    color: var(--color-muted);
  }

  /* The arrow sits there rather than arriving. It was hidden until hover on
     the first pass, on the argument that three permanent arrows read as a menu
     — but the version that reveals on hover is invisible on every phone, where
     nothing hovers, and that is most of the traffic. Drawn quietly at rest it
     says "these three navigate" before anyone touches them, which the label
     alone does not. */
  .mode-arrow {
    display: inline-flex;
    color: var(--color-muted);
    transition:
      color 200ms var(--ease-out-expo),
      translate 200ms var(--ease-out-expo);
  }

  /* The two halves of the hover are not symmetrical, on purpose. The arrow is
     drawn at rest because it says "this navigates" — a fact about the column
     that is true before you touch it. The rule says "this one" and is only
     ever true of one column at a time, so it stays transparent until the
     pointer makes it true. Three rules drawn at once would say it of all
     three. */
  .mode-cell:hover .mode-face,
  .mode-cell:focus-visible .mode-face {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
  .mode-cell:hover .mode-arrow,
  .mode-cell:focus-visible .mode-arrow {
    color: var(--color-brand);
  }
  /* The nudge is the only part that still needs a pointer to make sense, so it
     keeps the guard `.press` uses in global.css. */
  @media (hover: hover) and (pointer: fine) {
    .mode-cell:hover .mode-arrow,
    .mode-cell:focus-visible .mode-arrow {
      translate: 3px 0;
    }
  }

  /* Stacked, the separator turns with the layout: a rule between rows rather
     than between columns, and the inset that was after the divider becomes the
     space above it. */
  @media (max-width: 980px) {
    .mode-item + .mode-item {
      border-left: 0;
      border-top: 1px solid var(--color-line-strong);
    }
    .mode-cell,
    .mode-item + .mode-item .mode-cell {
      padding: 0 0 26px;
    }
    .mode-item + .mode-item .mode-cell {
      padding-top: 26px;
    }
    .mode-item:last-child .mode-cell {
      padding-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mode-face,
    .mode-arrow {
      transition-duration: 1ms;
    }
  }
</style>
