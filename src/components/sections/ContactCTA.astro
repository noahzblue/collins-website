---
/**
 * Contact CTA — contact methods beside a minimal quote form.
 * The form has no backend: submitting opens WhatsApp with the request
 * pre-filled (fields carry real name/required attrs so a POST endpoint
 * can be dropped in later without markup changes).
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { site, directionsHref } from "@/config/site";
import { contactSection } from "@/data/content";
import { getCollection } from "astro:content";

/* The dropdown mirrors the catalogue — same collection as /equipment. */
const equipmentCategoryNames = (await getCollection("equipment"))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((category) => category.data.name);

const { office, yard } = site.places;

/* Three numbers, not one. "Visit" offers both pins, because there are two
   places doing two different jobs. */
const methods = [
  {
    icon: "whatsapp" as const,
    label: "WhatsApp",
    value: "Chat with our team",
    href: site.whatsapp.href,
  },
  {
    icon: "mail" as const,
    label: "Email",
    value: site.email,
    href: `mailto:${site.email}`,
  },
];

const places = [office, yard];
---

<Section id="contact" tone="gray">
  <div class="wrap">
    <div
      class="grid grid-cols-[0.9fr_1.1fr] items-start gap-16 max-nav:grid-cols-1 max-nav:gap-10"
    >
      <!-- Left: pitch + contact methods -->
      <div>
        <Eyebrow class="mb-4">{contactSection.eyebrow}</Eyebrow>
        <h2
          class="mb-5 text-h2 leading-[1.06]"
          set:html={contactSection.title.join("<br>")}
        />
        <p class="mb-9 max-w-[440px] text-lead leading-relaxed text-muted">
          {contactSection.body}
        </p>

        <div class="flex flex-col gap-3">
          <!-- Three separate tel: rows. One number was three-thirds wrong. -->
          <div class="rounded-md border border-line bg-white p-4">
            <span class="flex items-center gap-4">
              <span
                class="flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-sm bg-brand-tint text-brand"
              >
                <Icon name="phone" size={20} />
              </span>
              <span class="text-caption text-faint">Call us</span>
            </span>
            <ul class="mt-3 flex flex-col">
              {
                site.phones.map((phone) => (
                  <li>
                    <a
                      href={phone.href}
                      class="block border-t border-line py-[9px] font-mono text-cell text-ink transition-colors hover:text-brand"
                    >
                      {phone.display}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            methods.map((m) => (
              <a
                href={m.href}
                target={m.href.startsWith("http") ? "_blank" : undefined}
                rel={m.href.startsWith("http") ? "noopener" : undefined}
                class="group flex items-center gap-4 rounded-md border border-line bg-white p-4 transition-all duration-200 hover:border-line-strong hover:shadow-[0_12px_30px_-20px_rgba(10,14,23,0.3)]"
              >
                <span class="flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-sm bg-brand-tint text-brand">
                  <Icon name={m.icon} size={20} />
                </span>
                <span>
                  <span class="block text-caption text-faint">{m.label}</span>
                  <span class="block text-base font-medium text-ink">
                    {m.value}
                  </span>
                </span>
              </a>
            ))
          }

          <!-- Visit: both pins. -->
          <div class="rounded-md border border-line bg-white p-4">
            <span class="flex items-center gap-4">
              <span
                class="flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-sm bg-brand-tint text-brand"
              >
                <Icon name="pin" size={20} />
              </span>
              <span class="text-caption text-faint">Visit</span>
            </span>
            <ul class="mt-3 flex flex-col">
              {
                places.map((place) => (
                  <li>
                    <a
                      href={directionsHref(place)}
                      target="_blank"
                      rel="noopener"
                      class="block border-t border-line py-[9px] transition-colors hover:text-brand"
                    >
                      <span class="font-mono text-micro tracking-[1.4px] text-faint uppercase">
                        {place.tag}
                      </span>
                      <span class="mt-0.5 block text-base font-medium text-ink">
                        {place.address}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <p class="mt-1 mb-0 flex items-center gap-3 text-note text-muted">
            <Icon name="clock" size={16} class="shrink-0 text-brand" />
            {site.hoursLong}
          </p>
        </div>
      </div>

      <!-- Right: quote form -->
      <form
        id="quote-form"
        data-wa={site.whatsapp.href}
        class="card p-9 shadow-[0_24px_60px_-36px_rgba(10,14,23,0.4)] max-xs:p-6"
      >
        <p class="mb-5 text-meta font-medium text-ink">
          Send us the machine, the duty and the dates — or just describe the job
          and we'll specify it for you.
        </p>
        <div class="grid grid-cols-2 gap-3 max-cmp:grid-cols-1">
          <input
            class="q-field"
            type="text"
            name="first_name"
            autocomplete="given-name"
            placeholder="First name"
            required
          />
          <input
            class="q-field"
            type="text"
            name="last_name"
            autocomplete="family-name"
            placeholder="Last name"
          />
        </div>
        <div class="grid grid-cols-2 gap-3 max-cmp:grid-cols-1">
          <input
            class="q-field"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email"
            required
          />
          <input
            class="q-field"
            type="tel"
            name="phone"
            autocomplete="tel"
            placeholder="Phone"
            required
          />
        </div>
        <select class="q-field" name="category" required>
          <option value="">Choose equipment category</option>
          {
            equipmentCategoryNames.map((category) => (
              <option>{category}</option>
            ))
          }
        </select>
        <div class="grid grid-cols-2 gap-3 max-cmp:grid-cols-1">
          <select class="q-field" name="mode">
            <option value="">Buy or rent</option>
            <option>Buy</option>
            <option>Rent</option>
          </select>
          <input
            class="q-field"
            type="text"
            name="duration"
            placeholder="Duration (if renting)"
          />
        </div>
        <textarea
          class="q-field"
          name="message"
          rows="3"
          placeholder="Tell us what you need"></textarea>
        <Button variant="primary" type="submit" class="press mt-2 w-full">
          Submit request
        </Button>
        <!-- A real commitment from the profile, and the single best thing
             that could sit next to a submit button. -->
        <p class="mt-4 mb-0 text-center text-base font-medium text-ink">
          {site.quotePromise}
        </p>
        <p class="mt-2 mb-0 text-center text-caption text-faint">
          Submitting opens WhatsApp with your request pre-filled. Need more
          fields? <a href="/contact" class="underline hover:text-ink">
            Use the full enquiry form
          </a>.
        </p>
      </form>
    </div>
  </div>
</Section>

<style>
  .q-field {
    width: 100%;
    background: #fff;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    padding: 12px 14px;
    font-size: 14px;
    font-family: inherit;
    margin-bottom: 12px;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .q-field::placeholder {
    color: var(--color-faint);
  }
  .q-field:focus {
    outline: none;
    border-color: var(--color-brand-bright);
    box-shadow: 0 0 0 3px rgba(47, 111, 255, 0.15);
  }
  select.q-field:invalid {
    color: var(--color-faint);
  }
</style>

<script>
  // Re-runs after every client-router navigation as well as on first load,
  // so the swapped-in DOM gets wired up.
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById(
      "quote-form",
    ) as HTMLFormElement | null;
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const get = (key: string) => String(data.get(key) ?? "").trim();

        const lines = [
          "New quote request — collinscouae.com",
          `Name: ${[get("first_name"), get("last_name")].filter(Boolean).join(" ")}`,
          `Email: ${get("email")}`,
          `Phone: ${get("phone")}`,
          `Equipment: ${get("category")}`,
          get("mode") &&
            `Buy or rent: ${get("mode")}${get("duration") ? ` · ${get("duration")}` : ""}`,
          get("message") && `Details: ${get("message")}`,
        ].filter(Boolean);

        window.open(
          `${form.dataset.wa}?text=${encodeURIComponent(lines.join("\n"))}`,
          "_blank",
        );
      });
    }
  });
</script>
