---
/** "What we do more" — dark section with outlined numerals. */
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { capabilities } from "../../data/catalog";
import { capabilitiesSection } from "../../data/content";
---

<Section tone="dark">
  <div class="wrap">
    <SectionHeading
      tone="dark"
      eyebrow={capabilitiesSection.eyebrow}
      title={capabilitiesSection.title}
    />
    <div
      class="grid grid-cols-3 gap-[44px] max-nav:grid-cols-1 max-nav:gap-[34px]"
    >
      {
        capabilities.map((item) => (
          <div>
            <div class="font-display text-[52px] text-transparent [-webkit-text-stroke:1.5px_#000]">
              {item.num}
            </div>
            <h3 class="text-[24px] mt-[14px] mb-[10px] text-white">
              {item.title}
            </h3>
            <p class="text-[14.5px] text-[#aaa]">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
