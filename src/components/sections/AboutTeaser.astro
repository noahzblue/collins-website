---
/**
 * About teaser — one statement, and the door to /about. Nothing else.
 *
 * It used to be a stat band plus a two-column locations card: eleven pieces of
 * information in a section whose whole job is to make you want to read the
 * about page. Both of those things survive where they belong — the two places
 * are in the footer AND in the contact band directly below this one, so the
 * card was the third telling on a single scroll, and the four numbers are the
 * spine of /about itself.
 *
 * What is left is the composition from the brief: eyebrow, then the claim at a
 * size that makes it the only thing in the section, then a long diagonal of
 * white space down to the supporting line and the link. The first line is
 * indented, which is the detail that stops a big uppercase block from reading
 * as a banner and makes it read as prose.
 *
 * Mono here is not a slip against "h2 is Geist". This is a statement, not a
 * section heading — the same structural voice the numbers, the eyebrows and
 * the accordion triggers already speak in, at the one size on the page where
 * it gets to be the subject rather than the label.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import { aboutSection } from "@/data/content";
---

<Section id="about">
  <div class="wrap">
    <Eyebrow class="mb-[72px] max-mob:mb-[44px]">{aboutSection.eyebrow}</Eyebrow
    >

    <h2
      class="statement max-w-[1080px] font-mono text-[clamp(26px,3.9vw,50px)] leading-[1.26] tracking-[-0.035em] text-ink uppercase"
      data-reveal
    >
      {aboutSection.title.join(" ")}
    </h2>

    <div
      class="mt-[140px] flex items-end justify-between gap-12 max-nav:mt-[80px] max-nav:flex-col max-nav:items-start max-nav:gap-9"
      data-reveal
    >
      <p class="mb-0 max-w-[520px] text-intro leading-relaxed text-muted">
        {aboutSection.body}
      </p>
      <Button
        variant="outline"
        size="lg"
        href={aboutSection.cta.href}
        class="press shrink-0"
      >
        {aboutSection.cta.label}
      </Button>
    </div>
  </div>
</Section>

<style>
  /* Four characters of indent on the first line only — a typesetting move, not
     a layout one, so it stays proportional to the fluid type size. */
  .statement {
    text-indent: 4ch;
    text-wrap: pretty;
  }
</style>
