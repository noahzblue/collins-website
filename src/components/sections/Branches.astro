---
/**
 * Branch locations — active vs. pending styling driven by `status`.
 * A lone branch gets a wide split card (map beside the details) instead of
 * a half-empty two-column grid; two or more fall back to the grid.
 */
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { branches } from "../../data/branches";
import { branchesSection } from "../../data/content";

const solo = branches.length === 1;
---

<Section id="branches" tone="gray">
  <div class="wrap">
    <SectionHeading
      eyebrow={branchesSection.eyebrow}
      title={branchesSection.title}
      intro={branchesSection.intro}
    />
    <div
      class:list={[
        "grid gap-[2px] bg-[#e7e7e7]",
        solo ? "grid-cols-1" : "grid-cols-2 max-nav:grid-cols-1",
      ]}
    >
      {
        branches.map((branch) => {
          const active = branch.status === "active";
          return (
            <div
              class:list={
                solo
                  ? "grid grid-cols-[1.05fr_1fr] gap-[2px] bg-[#e7e7e7] max-nav:grid-cols-1"
                  : "bg-white"
              }
            >
              <div
                class:list={[
                  "branch-map relative",
                  solo ? "min-h-[360px] max-nav:min-h-[240px]" : "h-[220px]",
                ]}
              >
                <Icon
                  name="pin"
                  size={34}
                  class={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-full ${active ? "text-brand" : "text-[#999]"}`}
                />
              </div>
              <div
                class:list={[
                  "bg-white",
                  solo
                    ? "flex flex-col justify-center p-[48px] max-mob:p-[30px]"
                    : "p-[30px]",
                ]}
              >
                <span
                  class:list={[
                    "self-start inline-block text-[11px] font-extrabold tracking-[1.5px] px-[10px] py-[5px] mb-[14px]",
                    active ? "bg-brand-bright text-white" : "bg-[#e5e5e5] text-[#888]",
                  ]}
                >
                  {branch.tag}
                </span>
                <h3 class:list={["mb-[14px]", solo ? "text-[34px]" : "text-[26px]"]}>
                  {branch.city}
                </h3>
                {(
                  [
                    { icon: "pin", text: branch.address },
                    { icon: "phone", text: branch.phone },
                    { icon: "clock", text: branch.hours },
                  ] as const
                ).map((row) => (
                  <div class="flex gap-[10px] items-center text-[14px] text-[#555] mb-2">
                    <Icon name={row.icon} size={16} class="text-brand shrink-0" />
                    <span>{row.text}</span>
                  </div>
                ))}
                <Button
                  variant="outline"
                  href={branch.directionsHref}
                  class={`mt-[18px] self-start ${active ? "" : "opacity-50 pointer-events-none"}`}
                >
                  Get Directions
                </Button>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Section>

<style>
  .branch-map {
    background:
      linear-gradient(#0000 0 0),
      repeating-linear-gradient(0deg, #dcdcdc 0 1px, transparent 1px 34px),
      repeating-linear-gradient(90deg, #dcdcdc 0 1px, transparent 1px 34px);
    background-color: #eef0ec;
  }
</style>
