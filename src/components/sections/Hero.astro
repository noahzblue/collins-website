---
/** Hero — full-bleed industrial photography, headline over a gradient scrim. */
import Button from "../ui/Button.astro";
import { hero, partnersLabel } from "../../data/content";
import { partners } from "../../data/catalog";
import { site } from "../../config/site";
---

<section
  class="hero relative overflow-hidden min-h-[640px] h-[100svh] flex items-end max-mob:h-auto max-mob:min-h-0"
  style="background-image:url('/images/hero-yard.jpg')"
>
  <!-- Ambient yard footage. The section's background-image is the same frame,
       so reduced-motion, small screens, and playback failure all degrade to it. -->
  <video
    class="hero-video absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/hero-yard.jpg"
    aria-hidden="true"
  >
    <source src="/videos/hero-yard.mp4" type="video/mp4" />
  </video>

  <div class="hero-scrim absolute inset-0 z-[1]" aria-hidden="true"></div>

  <div
    class="wrap relative z-[2] w-full pt-[220px] pb-[64px] max-mob:pt-[140px] max-mob:pb-[44px]"
  >
    <span
      class="reveal reveal-1 inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white px-[14px] py-[7px] text-[12px] font-semibold tracking-[1px] uppercase max-xs:text-[10.5px]"
    >
      <span class="status-dot relative w-[6px] h-[6px] rounded-full bg-brand-bright"></span>
      {hero.eyebrow}
    </span>

    <h1
      class="reveal reveal-2 mt-6 max-w-[820px] text-white text-[clamp(38px,5.6vw,68px)] leading-[1.05] tracking-[-0.03em] max-mob:mt-5"
    >
      {hero.title.lead}<span class="text-brand-bright">{hero.title.emphasis}</span
      >{hero.title.tail}
    </h1>

    <p
      class="reveal reveal-3 mt-5 max-w-[560px] text-pretty text-[18px] leading-relaxed text-white/75 max-mob:text-[16px] max-mob:mt-4"
    >
      {hero.sub}
    </p>

    <div
      class="reveal reveal-4 mt-10 flex gap-3 flex-wrap max-mob:mt-7 max-xs:flex-col max-xs:items-stretch"
    >
      {
        hero.ctas.map((cta) => (
          <Button
            variant={cta.variant === "outline" ? "outline-white" : cta.variant}
            href={cta.href}
            size="lg"
          >
            {cta.label}
          </Button>
        ))
      }
    </div>

    <!-- Base strip — survey-tag coordinates + manufacturer wordmarks. -->
    <div
      class="reveal reveal-5 mt-14 pt-6 border-t border-white/15 flex items-center justify-between flex-wrap gap-x-10 gap-y-4 max-mob:mt-10 max-mob:pt-5"
    >
      <span class="font-mono text-[12px] tracking-[0.5px] text-white/55">
        {site.geo.lat}º N&nbsp;&nbsp;{site.geo.lng}º E
      </span>
      <div
        class="flex items-center flex-wrap gap-x-8 gap-y-3 max-mob:gap-x-6"
        aria-label={partnersLabel}
      >
        {
          partners.map((name) => (
            <span class="font-display text-[13.5px] font-semibold tracking-[1.5px] text-white/45 max-xs:text-[11.5px]">
              {name}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Dark scrim: heaviest where the copy sits (bottom-left), clearing toward
     the frame's negative space so the crane and fleet on the right read. */
  .hero {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Video is an enhancement only — phones and reduced-motion users get the
     identical still frame via the section background, with no download cost. */
  @media (prefers-reduced-motion: reduce), (max-width: 900px) {
    .hero-video {
      display: none;
    }
  }
  .hero-scrim {
    background:
      linear-gradient(
        100deg,
        rgba(6, 10, 20, 0.88) 0%,
        rgba(6, 10, 20, 0.6) 35%,
        rgba(6, 10, 20, 0.18) 62%,
        rgba(6, 10, 20, 0.05) 100%
      ),
      linear-gradient(
        0deg,
        rgba(6, 10, 20, 0.65) 0%,
        rgba(6, 10, 20, 0.1) 45%,
        rgba(6, 10, 20, 0) 70%
      );
  }

  /* Entrance choreography — the hero reveals once, top to bottom, on load. */
  .reveal {
    animation-name: hero-rise-in;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: backwards;
  }
  .reveal-1 {
    animation-delay: 0s;
  }
  .reveal-2 {
    animation-delay: 0.09s;
  }
  .reveal-3 {
    animation-delay: 0.17s;
  }
  .reveal-4 {
    animation-delay: 0.25s;
  }
  .reveal-5 {
    animation-delay: 0.34s;
  }
  @keyframes hero-rise-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Status dot — the brand's "one indicator light," reading as live. */
  .status-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    background: var(--color-brand-bright);
    animation: status-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes status-ping {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .status-dot::after {
      animation: none;
      display: none;
    }
  }
</style>
