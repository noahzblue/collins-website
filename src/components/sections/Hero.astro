---
/** Hero — full-bleed industrial footage, headline over a gradient scrim, and a
 *  glass base panel carrying the manufacturer wordmarks. */
import Button from "@/components/ui/Button.astro";
import PartnerStrip from "@/components/ui/PartnerStrip.astro";
import { hero } from "@/data/content";
import { site } from "@/config/site";
---

<section
  class="hero relative flex h-[100svh] min-h-[640px] items-end overflow-hidden max-mob:h-auto max-mob:min-h-0"
>
  <!-- Ambient yard footage. The still underneath is the same frame, so
       reduced-motion, small screens, and playback failure all degrade to it. -->
  <div class="hero-media absolute inset-0" aria-hidden="true">
    <div
      class="hero-still absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image:url('/images/hero-yard.jpg')"
    >
    </div>
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-yard.jpg"
    >
      <source src="/videos/hero-yard.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="hero-scrim absolute inset-0 z-[1]" aria-hidden="true"></div>

  <!-- Depth-of-field ramp: three stacked backdrop blurs, each masked to start
       lower than the last, so the frame softens gradually toward the copy. -->
  <div
    class="hero-blur absolute inset-x-0 bottom-0 z-[1] h-[46%]"
    aria-hidden="true"
  >
    <span class="b1"></span>
    <span class="b2"></span>
    <span class="b3"></span>
  </div>

  <div
    class="wrap relative z-[2] w-full pt-[220px] pb-[64px] max-mob:pt-[140px] max-mob:pb-[44px]"
  >
    <span
      class="reveal reveal-1 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-[14px] py-[7px] font-mono text-label font-medium tracking-[1px] text-white uppercase backdrop-blur-sm max-xs:text-[10.5px]"
    >
      <span
        class="status-dot relative h-[6px] w-[6px] rounded-full bg-brand-bright"
      ></span>
      {hero.eyebrow}
    </span>

    <h1
      class="reveal reveal-2 mt-6 max-w-[820px] text-display leading-[1.05] text-white max-mob:mt-5"
    >
      {hero.title.lead}<span class="text-brand-bright"
        >{hero.title.emphasis}</span
      >{hero.title.tail}
    </h1>

    <p
      class="reveal reveal-3 mt-5 max-w-[560px] text-subhead leading-relaxed text-pretty text-white/75 max-mob:mt-4 max-mob:text-lead"
    >
      {hero.sub}
    </p>

    <div
      class="reveal reveal-4 mt-10 flex flex-wrap gap-3 max-mob:mt-7 max-xs:flex-col max-xs:items-stretch"
    >
      {
        hero.ctas.map((cta) => (
          <Button
            variant={cta.variant === "outline" ? "outline-white" : cta.variant}
            href={cta.href}
            size="lg"
          >
            {cta.label}
          </Button>
        ))
      }
    </div>

    <!-- Base panel — survey-tag coordinates + the drifting wordmarks. -->
    <div
      class="reveal reveal-5 mt-14 flex items-center gap-6 rounded-[14px] border border-white/12 bg-white/[0.06] px-6 py-4 backdrop-blur-sm max-mob:mt-10 max-cmp:flex-col max-cmp:items-start max-cmp:gap-3 max-cmp:px-5"
    >
      <span
        class="shrink-0 font-mono text-label tracking-[0.5px] text-white/55"
      >
        {site.geo.lat}º N&nbsp;&nbsp;{site.geo.lng}º E
      </span>
      <span
        class="h-4 w-px shrink-0 bg-white/15 max-cmp:hidden"
        aria-hidden="true"></span>
      <PartnerStrip
        variant="marquee"
        class="min-w-0 flex-1 max-cmp:w-full max-cmp:flex-none"
      />
    </div>
  </div>
</section>

<style>
  /* Video is an enhancement only — phones and reduced-motion users get the
     identical still frame underneath, with no download cost. */
  @media (prefers-reduced-motion: reduce), (max-width: 900px) {
    .hero-video {
      display: none;
    }
  }

  /* Dark scrim: heaviest where the copy sits (bottom-left), clearing toward
     the frame's negative space so the crane and fleet on the right read. */
  .hero-scrim {
    background:
      linear-gradient(
        100deg,
        rgba(6, 10, 20, 0.88) 0%,
        rgba(6, 10, 20, 0.6) 35%,
        rgba(6, 10, 20, 0.18) 62%,
        rgba(6, 10, 20, 0.05) 100%
      ),
      linear-gradient(
        0deg,
        rgba(6, 10, 20, 0.65) 0%,
        rgba(6, 10, 20, 0.1) 45%,
        rgba(6, 10, 20, 0) 70%
      );
  }

  /* Each layer blurs harder and starts lower; stacked, they read as one
     gradient of focus instead of a visible blur edge. */
  .hero-blur > span {
    position: absolute;
    inset: 0;
  }
  .hero-blur .b1 {
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 34%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 34%);
  }
  .hero-blur .b2 {
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    -webkit-mask-image: linear-gradient(180deg, transparent 30%, #000 66%);
    mask-image: linear-gradient(180deg, transparent 30%, #000 66%);
  }
  .hero-blur .b3 {
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    -webkit-mask-image: linear-gradient(180deg, transparent 62%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 62%, #000 100%);
  }

  /* Entrance choreography — the hero reveals once, top to bottom, on load. */
  .reveal {
    animation-name: hero-rise-in;
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    animation-fill-mode: backwards;
  }
  .reveal-1 {
    animation-delay: 0s;
  }
  .reveal-2 {
    animation-delay: 0.09s;
  }
  .reveal-3 {
    animation-delay: 0.17s;
  }
  .reveal-4 {
    animation-delay: 0.25s;
  }
  .reveal-5 {
    animation-delay: 0.34s;
  }
  @keyframes hero-rise-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Status dot — the brand's "one indicator light," reading as live. */
  .status-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    background: var(--color-brand-bright);
    animation: status-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes status-ping {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .status-dot::after {
      animation: none;
      display: none;
    }
  }
</style>
