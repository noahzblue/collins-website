---
/** Hero — full-bleed image + gradient background. */
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import { hero } from "../../data/content";
---

<section class="hero-bg relative overflow-hidden text-white">
  <div
    class="relative z-[2] max-w-[1240px] mx-auto px-8 pt-28 pb-24 max-mob:px-5 max-mob:pt-14 max-mob:pb-12 max-xs:px-4 max-xs:pt-[44px] max-xs:pb-10"
  >
    <Eyebrow kind="hero" class="mb-[22px]">{hero.eyebrow}</Eyebrow>
    <h1
      class="text-[clamp(44px,7vw,92px)] max-w-[820px] text-white max-mob:text-[clamp(34px,8vw,56px)] max-xs:text-[clamp(28px,9.5vw,42px)]"
    >
      {hero.title.lead}<em class="not-italic text-brand-bright"
        >{hero.title.emphasis}</em
      >{hero.title.tail}
    </h1>
    <p
      class="mt-[22px] text-[18px] max-w-[540px] text-[#d7d7d7] font-normal max-mob:text-[15px] max-mob:mt-4 max-xs:text-[14px]"
    >
      {hero.sub}
    </p>
    <div
      class="mt-10 flex gap-4 flex-wrap max-mob:mt-7 max-mob:gap-3 max-xs:flex-col max-xs:items-stretch"
    >
      {
        hero.ctas.map((cta) => (
          <Button
            variant={cta.variant}
            href={cta.href}
            class="max-mob:px-5 max-mob:py-3 max-mob:text-[12px]"
          >
            {cta.label}
          </Button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background:
      linear-gradient(
        180deg,
        rgba(0, 10, 30, 0.55) 0%,
        rgba(0, 10, 30, 0.72) 55%,
        #05070d 100%
      ),
      url("/images/hero-bg.jpg");
    background-size: cover;
    background-position: center 62%;
    background-repeat: no-repeat;
  }
  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.025) 0 2px,
      transparent 2px 60px
    );
    pointer-events: none;
  }
</style>
