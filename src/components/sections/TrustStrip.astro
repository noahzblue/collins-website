---
/**
 * "Why Collins" — big statement, then one wide dark photo card with a constant
 * headline, a mono counter, and four tabs along the base that swap the
 * photo + copy (siteassist.com pattern). Auto-advances every 6s, pauses
 * while hovered, and holds still for reduced-motion users.
 *
 * The card runs on the wide 1600px band rather than the 1200px text column,
 * and the four tab blocks are bottom-aligned so they sit on the base of the
 * photo whether their description is open or closed.
 *
 * The big counter top-right and the small number on each tab are the same
 * value. That repetition is the point: on its own, a 40px "03" in the opposite
 * corner from the tabs reads as decoration and nobody connects it to the third
 * block of copy. Numbering the tabs makes the counter legible as a position in
 * a set of four.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import ParallaxImage from "@/components/ui/ParallaxImage.astro";
import { trustFeatures } from "@/data/proof";
import { trust } from "@/data/content";
---

<Section id="why-collins">
  <div class="wrap wrap-wide">
    <Eyebrow class="mb-[16px]">{trust.eyebrow}</Eyebrow>
    <h2
      class="max-w-[820px] text-[clamp(28px,3.6vw,44px)] leading-[1.12] max-cmp:text-[clamp(22px,6vw,26px)] max-cmp:leading-[1.18]"
    >
      {trust.statement}
    </h2>

    <div
      id="why-card"
      class="relative mt-[56px] flex min-h-[620px] flex-col justify-between overflow-clip rounded-md bg-ink max-mob:mt-[36px] max-mob:min-h-0 max-cmp:mt-[26px] max-cmp:min-h-[500px]"
    >
      {
        /* The crossfade class lives on a wrapper THIS component owns, not on
           the <ParallaxImage> itself. Astro scopes `.tab-img` to this file's
           cid, and a child component's root element carries its OWN cid — so
           passed down as a prop the selector never matched, all four photos
           stayed at opacity 1, and the last one in the DOM was the only one
           anybody ever saw regardless of which tab was selected. */
        trustFeatures.map((f, i) => (
          <div
            class:list={["tab-img absolute inset-0", i === 0 && "is-active"]}
          >
            <ParallaxImage
              src={f.image}
              loading={i === 0 ? "eager" : "lazy"}
              class="absolute inset-0"
            />
          </div>
        ))
      }

      <!-- Scrim: headline zone up top, tab rail along the base. The lower
           half carries an extra stop at 62% because the tab copy starts well
           above the bottom edge — a two-stop ramp only reaches full strength
           under the last line, and the brighter photos in this set (a lit
           workshop, a midday site) washed the descriptions out. -->
      <div
        class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,20,0.55)_0%,rgba(6,10,20,0.08)_32%,rgba(6,10,20,0.60)_62%,rgba(6,10,20,0.92)_100%)]"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative flex items-start justify-between gap-6 p-10 max-cmp:gap-4 max-cmp:p-5"
      >
        <h3
          class="text-[clamp(26px,2.8vw,38px)] leading-[1.1] text-white max-cmp:text-[21px]"
          set:html={trust.cardTitle.join("<br>")}
        />
        <span
          id="why-num"
          class="mt-1 font-mono text-[clamp(28px,3vw,40px)] leading-none text-white/85 max-cmp:mt-0 max-cmp:text-[22px]"
        >
          <span class="digit">01</span>
        </span>
      </div>

      {
        /* Four tabs, two shapes.
    
           Wide, each tab is a block of copy and all four sit open along the
           base of the photo. On a phone that is four paragraphs stacked in a
           column — 530px of card spent on text nobody asked for three quarters
           of, before the picture gets a single pixel.
    
           So below `cmp` the tab and its copy come apart. The copy moves out
           into one slot that crossfades (the same move the four photographs
           already make, one layer up), and the tabs collapse to a rail of four
           numbered segments whose progress bars are the whole control: you can
           see there are four, which one you are on, and how long is left.
           ~140px instead of ~530px, and the photograph gets the card back.
    
           The tabs keep their titles and descriptions — `sr-only`, not
           `hidden`, so each one still announces "01 Readiness, Serviced,
           fuelled…" rather than "01". The visible copy is the presentation of
           whichever is selected, so it is `aria-hidden` and the tablist stays
           the single source of the semantics. */
      }
      <div class="relative">
        <div class="tab-copy hidden px-5 pb-4 max-cmp:grid" aria-hidden="true">
          {
            trustFeatures.map((f, i) => (
              <div class:list={["tab-copy-item", i === 0 && "is-active"]}>
                <span class="block text-subhead leading-snug font-medium text-white">
                  {f.title}
                </span>
                <span class="mt-[7px] block text-note leading-relaxed text-white/70">
                  {f.body}
                </span>
              </div>
            ))
          }
        </div>

        <div
          class="relative grid grid-cols-4 items-end gap-8 px-10 pt-16 pb-9 max-nav:grid-cols-2 max-nav:gap-6 max-cmp:grid-cols-4 max-cmp:gap-2 max-cmp:px-5 max-cmp:pt-0 max-cmp:pb-5"
          role="tablist"
          aria-label={trust.eyebrow}
        >
          {
            trustFeatures.map((f, i) => (
              <button
                type="button"
                role="tab"
                class="why-tab cursor-pointer text-left max-cmp:py-1"
                aria-selected={i === 0 ? "true" : "false"}
                data-index={i}
              >
                <span class="tab-num block font-mono text-micro tracking-[1.6px] transition-colors duration-300">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="tab-title mt-[10px] block text-lead-lg font-medium transition-colors duration-300 max-cmp:sr-only">
                  {f.title}
                </span>
                <span class="desc-wrap grid transition-[grid-template-rows] duration-500 ease-out max-cmp:sr-only">
                  <span class="block overflow-hidden">
                    <span class="block pt-2 text-note leading-relaxed text-white/70">
                      {f.body}
                    </span>
                  </span>
                </span>
                <span class="bar relative mt-4 block h-px overflow-hidden bg-white/25 transition-colors duration-300 max-cmp:mt-[7px]">
                  <span class="bar-fill absolute inset-y-0 left-0 w-full origin-left bg-brand-bright" />
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .tab-img {
    opacity: 0;
    transition: opacity 0.65s ease;
  }
  .tab-img.is-active {
    opacity: 1;
  }

  /* The phone copy slot. All four stack in ONE grid cell, so the block is as
     tall as the longest of them and the swap never moves the rail underneath
     it — a control that shifts under your thumb as it changes is the whole
     reason a crossfade is worth the extra element. */
  .tab-copy {
    grid-template-areas: "slot";
  }
  .tab-copy-item {
    grid-area: slot;
    opacity: 0;
    transition: opacity 0.45s var(--ease-out-expo);
  }
  .tab-copy-item.is-active {
    opacity: 1;
  }

  /* Three states, and the hover state has to beat the resting one on BOTH the
     selected and the unselected tab — hence `:hover` after the
     `[aria-selected]` rules rather than mixed in with them. */
  .tab-num {
    color: rgb(255 255 255 / 0.35);
  }
  .tab-title {
    color: rgb(255 255 255 / 0.65);
  }
  .why-tab[aria-selected="true"] .tab-num {
    color: rgb(255 255 255 / 0.8);
  }
  .why-tab[aria-selected="true"] .tab-title {
    color: #fff;
  }
  .why-tab:hover .tab-num,
  .why-tab:focus-visible .tab-num,
  .why-tab:hover .tab-title,
  .why-tab:focus-visible .tab-title {
    color: var(--color-brand-bright);
  }
  /* The rule under the tab is the other half of the affordance: the whole
     block lights, not just its label. */
  .why-tab:hover .bar,
  .why-tab:focus-visible .bar {
    background: color-mix(in srgb, var(--color-brand-bright) 45%, transparent);
  }

  .desc-wrap {
    grid-template-rows: 0fr;
  }
  .why-tab[aria-selected="true"] .desc-wrap {
    grid-template-rows: 1fr;
  }

  /* The progress line is driven by the rotator's own clock (`--t`, 0→1), not
     by a CSS animation on a duration that has to be kept in sync by hand. The
     bar and the switch therefore cannot drift, and a hover freezes the fill
     mid-travel instead of snapping it. */
  .bar-fill {
    transform: scaleX(var(--t, 0));
  }

  /* The counter rolls like an odometer: the outgoing digit leaves upward and
     the incoming one arrives from below, both clipped by the frame. */
  #why-num {
    position: relative;
    display: block;
    overflow: hidden;
    width: 2ch;
    height: 1em;
  }
  #why-num .digit {
    position: absolute;
    inset: 0;
    transition:
      transform 0.45s var(--ease-out-expo),
      opacity 0.45s var(--ease-out-expo);
  }
  #why-num .digit.is-out {
    transform: translateY(-100%);
    opacity: 0;
  }
  #why-num .digit.is-in {
    transform: translateY(100%);
    opacity: 0;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-img,
    .tab-copy-item,
    .desc-wrap {
      transition: none;
    }
    .bar-fill {
      transform: scaleX(1);
    }
    #why-num .digit {
      transition: none;
    }
  }
</style>

<script>
  import { createRotator } from "@/scripts/rotator";

  // Re-runs after every client-router navigation as well as on first load,
  // so the swapped-in DOM gets wired up.
  document.addEventListener("astro:page-load", () => {
    const card = document.getElementById("why-card");
    if (card) {
      const tabs = [...card.querySelectorAll<HTMLButtonElement>(".why-tab")];
      const imgs = [...card.querySelectorAll<HTMLElement>(".tab-img")];
      const copy = [...card.querySelectorAll<HTMLElement>(".tab-copy-item")];
      const num = card.querySelector<HTMLElement>("#why-num")!;

      const fills = [...card.querySelectorAll<HTMLElement>(".bar-fill")];

      /** Roll the counter: the old digit leaves upward, the new one arrives
       *  from below. Two elements for the length of one transition. */
      const roll = (i: number) => {
        const next = String(i + 1).padStart(2, "0");
        const current = num.querySelector<HTMLElement>(".digit:not(.is-out)");
        if (!current || current.textContent === next) return;

        const incoming = document.createElement("span");
        incoming.className = "digit is-in";
        incoming.textContent = next;
        num.append(incoming);

        current.classList.add("is-out");
        current.addEventListener("transitionend", () => current.remove(), {
          once: true,
        });
        // Next frame, so the browser paints the below-the-frame start state
        // before the class that animates away from it lands.
        requestAnimationFrame(() => incoming.classList.remove("is-in"));
      };

      const rotator = createRotator({
        root: card,
        count: tabs.length,
        interval: 6000,
        onSelect: (i) => {
          tabs.forEach((t, j) =>
            t.setAttribute("aria-selected", String(j === i)),
          );
          imgs.forEach((im, j) => im.classList.toggle("is-active", j === i));
          copy.forEach((c, j) => c.classList.toggle("is-active", j === i));
          roll(i);
        },
        // One clock for the switch and the bar, so they can't disagree.
        onProgress: (i, t) => {
          fills.forEach((fill, j) =>
            fill.style.setProperty("--t", String(j === i ? t : 0)),
          );
        },
      });
      tabs.forEach((t, i) =>
        t.addEventListener("click", () => rotator.select(i)),
      );
    }
  });
</script>
