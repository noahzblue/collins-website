---
/**
 * Services teaser — the six capabilities as a numbered follower list.
 *
 * It used to be a three-row accordion, which had two problems: the data only
 * held three services (two real revenue lines were invisible site-wide), and
 * six accordion rows would be a tall, dull column. The follower list keeps six
 * rows in roughly the height the three-row accordion took and still carries
 * photography.
 *
 * Every row deep-links into its block on /services. Reads from the same
 * services.ts as the hub, so the homepage can't drift from it.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import FollowerList from "@/components/ui/FollowerList.astro";
import ViewAllBar from "@/components/ui/ViewAllBar.astro";
import { services } from "@/data/services";
import { servicesSection } from "@/data/content";
---

<Section id="services">
  <div class="wrap">
    <div class="mb-[56px] flex flex-wrap items-end justify-between gap-8">
      <div>
        <Eyebrow class="mb-[16px]">{servicesSection.eyebrow}</Eyebrow>
        <h2
          class="text-h2 leading-[1.06] tracking-[-0.015em] uppercase"
          data-reveal="lines"
          set:html={servicesSection.title.join("<br>")}
        />
      </div>
      <p class="max-w-[430px] text-lead leading-relaxed text-muted">
        {servicesSection.intro}
      </p>
    </div>

    <FollowerList
      items={services.map((service) => ({
        label: service.title,
        blurb: service.lead,
        image: service.image,
        href: `/services#${service.slug}`,
        stat: service.stat,
      }))}
      ariaLabel={servicesSection.eyebrow}
    />

    <ViewAllBar
      href={servicesSection.viewAll.href}
      label={servicesSection.viewAll.label}
      class="mt-[80px] max-mob:mt-[40px]"
    />
  </div>
</Section>
