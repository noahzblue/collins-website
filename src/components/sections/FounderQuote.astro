---
/**
 * The proof band — one quote that doesn't move.
 *
 * This replaces three rotating "testimonials" attributed to "Site Manager ·
 * Construction · Dubai" and friends. They were written as placeholders and
 * marked as such in the data file, but nothing on the rendered page said so:
 * a visitor read them as three real customers. They are gone, not softened
 * with "representative" and not hidden behind a "coming soon".
 *
 * What stands there instead is real, named, attributed to a person with a
 * title, and better copy than any of the three. A single quote that doesn't
 * move reads as more confident than three that do.
 *
 * `Testimonials.astro` stays in the repo with its rotation logic intact: when
 * real client quotes exist, that comes back and this quote moves to /about.
 * See docs/site-expansion/10.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import ParallaxImage from "@/components/ui/ParallaxImage.astro";
import { founderQuote } from "@/data/proof";
import { quoteSection } from "@/data/content";
---

<Section tone="dark" class="relative overflow-clip">
  <ParallaxImage
    src="/images/testimonial-site.jpg"
    shift="35%"
    class="absolute inset-0"
    zoom={1}
  />

  <div class="wrap relative">
    <figure class="mx-auto max-w-[880px] text-center">
      <Eyebrow
        tone="brand-bright"
        bar={false}
        class="mb-9 justify-center text-center"
      >
        {quoteSection.eyebrow}
      </Eyebrow>

      <blockquote
        class="font-mono text-h3 leading-[1.3] tracking-[-0.02em] text-balance text-white"
        data-reveal
      >
        <span aria-hidden="true">“</span>{founderQuote.lead}<span
          class="text-brand-bright">{founderQuote.emphasis}</span
        >{founderQuote.tail}<span aria-hidden="true">”</span>
      </blockquote>

      <figcaption class="mt-10" data-reveal>
        <span
          class="block font-mono text-label tracking-[2px] text-white uppercase"
        >
          {founderQuote.name}
        </span>
        <span
          class="mt-2 block font-mono text-label tracking-[1.6px] text-white/50 uppercase"
        >
          {founderQuote.role}
        </span>
      </figcaption>
    </figure>
  </div>
</Section>
