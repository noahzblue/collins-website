---
/** Request-a-quote band — gradient background with an enquiry form. */
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import { site } from "../../config/site";
import { quoteBand } from "../../data/content";
import { equipmentCategories } from "../../data/catalog";
---

<section id="quote" class="quote-bg relative text-white">
  <div class="wrap">
    <div
      class="grid grid-cols-[1.1fr_0.9fr] gap-[60px] items-center py-[100px] max-nav:grid-cols-1 max-mob:py-14 max-mob:gap-8"
    >
      <div>
        <Eyebrow kind="hero" class="mb-[18px]">{quoteBand.eyebrow}</Eyebrow>
        <h2
          class="text-[clamp(30px,4vw,48px)] text-white mb-[18px]"
          set:html={quoteBand.title.join("<br>")}
        />
        <p class="text-[#eee] text-[15.5px] max-w-[440px] mb-[10px]">
          {quoteBand.body}
        </p>
        <p class="text-[#eee] text-[15.5px] max-w-[440px] mb-[10px] mt-[22px]">
          <strong class="text-white">{quoteBand.callPrompt}</strong> Call {
            site.phone.display
          }
        </p>
      </div>

      <form class="bg-black/55 border border-white/25 p-9 backdrop-blur-[4px]">
        <label
          class="block text-[11px] tracking-[1.5px] uppercase text-brand-bright font-bold mb-5"
          >{quoteBand.formLabel}</label
        >
        <div class="grid grid-cols-2 gap-3 max-cmp:grid-cols-1">
          <input class="q-field" type="text" placeholder="First Name" />
          <input class="q-field" type="text" placeholder="Last Name" />
        </div>
        <div class="grid grid-cols-2 gap-3 max-cmp:grid-cols-1">
          <input class="q-field" type="email" placeholder="Email" />
          <input class="q-field" type="tel" placeholder="Phone" />
        </div>
        <select class="q-field">
          <option>Choose Equipment Category</option>
          {equipmentCategories.map((category) => <option>{category}</option>)}
        </select>
        <div class="grid grid-cols-2 gap-3 max-cmp:grid-cols-1">
          <select class="q-field">
            <option>Buy or Rent</option>
            <option>Buy</option>
            <option>Rent</option>
          </select>
          <input class="q-field" type="text" placeholder="Duration (if renting)" />
        </div>
        <textarea class="q-field" rows="3" placeholder="Message"></textarea>
        <Button variant="primary" class="w-full mt-[6px]">
          Submit Quote Request
        </Button>
      </form>
    </div>
  </div>
</section>

<style>
  .quote-bg {
    background:
      linear-gradient(115deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.75)),
      linear-gradient(
        120deg,
        #3a1c5c 0%,
        #b23a63 35%,
        #df790d 68%,
        #ffb648 100%
      );
  }
  .q-field {
    width: 100%;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
    padding: 13px 14px;
    font-size: 14px;
    margin-bottom: 12px;
    font-family: inherit;
  }
  .q-field::placeholder {
    color: #c9c9c9;
  }
  select.q-field {
    color: #c9c9c9;
  }
</style>
