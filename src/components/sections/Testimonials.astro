---
/**
 * Testimonials — split layout: site photo one side, one large pull quote the
 * other. Quotes rotate (auto every 7s, dots for manual control); slides stack
 * in a single grid cell so the block keeps the height of the tallest quote.
 */
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Icon from "@/components/ui/Icon.astro";
import { testimonials } from "@/data/proof";
import { testimonialsSection } from "@/data/content";
---

<Section>
  <div class="wrap">
    <div
      id="quote-split"
      class="grid grid-cols-[0.85fr_1.15fr] items-stretch gap-16 max-nav:grid-cols-1 max-nav:gap-8"
    >
      <div
        class="min-h-[480px] rounded-[18px] bg-cover bg-center max-nav:aspect-[16/10] max-nav:min-h-0"
        style="background-image:url('/images/testimonial-site.jpg')"
        role="img"
        aria-label={testimonialsSection.imageAlt}
      >
      </div>

      <div class="flex flex-col justify-center py-4">
        <Eyebrow class="mb-7">{testimonialsSection.eyebrow}</Eyebrow>

        <div class="grid">
          {
            testimonials.map((t, i) => (
              <figure
                class:list={[
                  "quote-slide col-start-1 row-start-1",
                  i === 0 && "is-active",
                ]}
              >
                <div class="flex gap-[3px] text-brand">
                  {Array.from({ length: t.rating }).map(() => (
                    <Icon name="star" size={15} />
                  ))}
                </div>
                <blockquote class="mt-5 font-display text-[clamp(22px,2.5vw,31px)] leading-[1.32] font-medium tracking-[-0.015em] text-ink">
                  “{t.quote}”
                </blockquote>
                <figcaption class="mt-7">
                  <div class="text-base font-medium text-ink">{t.name}</div>
                  <div class="mt-0.5 text-note text-faint">{t.role}</div>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div
          class="mt-10 flex items-center gap-[7px]"
          aria-label="Choose testimonial"
        >
          {
            testimonials.map((_, i) => (
              <button
                type="button"
                class="quote-dot h-[7px] cursor-pointer rounded-full transition-all duration-300"
                aria-label={`Testimonial ${i + 1}`}
                aria-current={i === 0 ? "true" : "false"}
                data-index={i}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .quote-slide {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    pointer-events: none;
  }
  .quote-slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .quote-dot {
    width: 7px;
    background: var(--color-line-strong);
  }
  .quote-dot[aria-current="true"] {
    width: 22px;
    background: var(--color-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-slide {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import { createRotator } from "@/scripts/rotator";

  // Re-runs after every client-router navigation as well as on first load,
  // so the swapped-in DOM gets wired up.
  document.addEventListener("astro:page-load", () => {
    const block = document.getElementById("quote-split");
    if (block) {
      const slides = [...block.querySelectorAll<HTMLElement>(".quote-slide")];
      const dots = [...block.querySelectorAll<HTMLButtonElement>(".quote-dot")];

      const rotator = createRotator({
        root: block,
        count: slides.length,
        interval: 7000,
        onSelect: (i) => {
          slides.forEach((s, j) => s.classList.toggle("is-active", j === i));
          dots.forEach((d, j) =>
            d.setAttribute("aria-current", String(j === i)),
          );
        },
      });
      dots.forEach((d, i) =>
        d.addEventListener("click", () => rotator.select(i)),
      );
    }
  });
</script>
