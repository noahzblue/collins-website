---
/**
 * Industries — 8 portrait photo tiles, each linking to its own page, plus a
 * way through to the hub.
 *
 * Each tile carries two photographs of its sector and takes turns between
 * them: the one on screen is pushed off one of the four edges and drags the
 * other in behind it (`ui/ImageSwap.astro`). Direction and timing are random
 * per tile, so the grid is never doing one thing — at any moment one or two
 * of the eight are moving and the rest are still, which is what keeps a band
 * of eight animated tiles from reading as a slideshow.
 */
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Icon from "@/components/ui/Icon.astro";
import ViewAllBar from "@/components/ui/ViewAllBar.astro";
import ImageSwap from "@/components/ui/ImageSwap.astro";
import { industries } from "@/data/industries";
import { industriesSection } from "@/data/content";
---

<Section id="industries" tone="gray">
  <div class="wrap wrap-wide">
    <SectionHeading
      eyebrow={industriesSection.eyebrow}
      title={industriesSection.title}
      intro={industriesSection.intro}
      align="center"
    />

    {
      /* The wave travels by COLUMN, not by index, so it moves left to right
       across the grid rather than wrapping down the rows. The delay is set
       inline because `reveal.ts` leaves an already-set `--reveal-delay` alone
       — that is how a component overrides the default stagger. */
    }
    <div class="grid grid-cols-4 gap-5 max-nav:grid-cols-2 max-xs:grid-cols-1">
      {
        industries.map((ind, i) => (
          <a
            href={`/industries/${ind.slug}`}
            class="press group relative aspect-[3/4] overflow-clip rounded-md max-xs:aspect-[4/3]"
            style={`--reveal-delay:${(i % 4) * 70}ms`}
            data-reveal
          >
            {/* No hover scale. Eight tiles that each swell under the pointer
               is the single most-used interaction on the web; on a wide band
               of real photography it adds nothing, and the tiles already have
               a motion of their own.

               All eight are given the same interval on purpose: the spread
               belongs in the browser, not here. Anything random written at
               this point is baked into the built HTML and served identical to
               every visitor for the life of the deploy — `ImageSwap` rolls its
               own wait per tile per cycle instead. */}
            <ImageSwap
              images={[ind.image, ind.imageSwap]}
              interval={3500}
              class="absolute inset-0"
            />
            <span
              class="absolute inset-0 bg-[linear-gradient(180deg,rgba(6,10,20,0.05)_40%,rgba(6,10,20,0.72)_100%)]"
              aria-hidden="true"
            />
            <span class="absolute top-4 right-4 flex h-8 w-8 -translate-y-1 items-center justify-center rounded-full bg-white/15 text-white opacity-0 backdrop-blur-sm transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
              <Icon name="arrow-up-right" size={15} />
            </span>
            <span class="absolute right-5 bottom-5 left-5 text-subhead leading-snug font-medium text-white">
              {ind.name}
            </span>
          </a>
        ))
      }
    </div>

    <ViewAllBar
      href={industriesSection.viewAll.href}
      label={industriesSection.viewAll.label}
      class="mt-[64px] max-mob:mt-[40px]"
    />
  </div>
</Section>
