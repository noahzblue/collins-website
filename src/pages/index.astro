---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { name:'Generators', href:'/generators/', dwg:'GEN', spec:'10 – 1250 KVA', blurb:'Prime and standby diesel power for sites, plants and events.',
    icon:`<rect x="8" y="17" width="31" height="17" rx="2"/><path d="M12 21v9M15 21v9M18 21v9"/><rect x="25" y="21" width="10" height="9"/><circle cx="30" cy="25.5" r="2.2"/><path d="M8 34l-2 4M39 34l2 4M31 11l-3.5 4.5H32l-3.5 4.5"/>` },
  { name:'Forklifts', href:'/forklifts/', dwg:'FRK', spec:'1.4 – 15 tonne', blurb:'Diesel and electric — warehouse aisles to heavy yards.',
    icon:`<circle cx="15" cy="33" r="4"/><circle cx="27" cy="33" r="4"/><path d="M11 29V19h8l4 6v4"/><path d="M34 11v22M34 29h7M34 33h7"/>` },
  { name:'Air Compressors', href:'/air-compressors/', dwg:'CMP', spec:'135 – 1050 CFM', blurb:'Portable air for drilling, blasting and pneumatic tools.',
    icon:`<rect x="9" y="21" width="20" height="13" rx="6.5"/><path d="M9 27.5h20"/><circle cx="34" cy="16" r="4"/><path d="M34 16v-1.6M34 16l1.2 1.1M29 21v-3.5h5"/>` },
  { name:'Heavy Equipment', href:'/heavy-equipment/', dwg:'HVY', spec:'Telehandlers · Cranes · Excavators', blurb:'Earthmoving and material handling for every phase.',
    icon:`<path d="M8 34h19v-6H10z"/><circle cx="13" cy="36.5" r="1.8"/><circle cx="21" cy="36.5" r="1.8"/><path d="M22 28l7-11 9 3.5"/><path d="M38 20.5l-3.2 7.5-6.5-2.2"/>` },
  { name:'Tower Lights', href:'/tower-lights/', dwg:'LGT', spec:'Site & event lighting', blurb:'Bright, fuel-efficient towers built for night works.',
    icon:`<path d="M24 33V13"/><path d="M17 40h14"/><path d="M22 33l-3 7M26 33l3 7"/><rect x="13" y="7" width="8" height="6"/><rect x="27" y="7" width="8" height="6"/><path d="M21 10h6"/>` },
  { name:'Spare Parts', href:'/spare-parts/', dwg:'PRT', spec:'Genuine components', blurb:'OEM parts kept in stock — minimal machine downtime.',
    icon:`<circle cx="24" cy="24" r="7"/><circle cx="24" cy="24" r="2.4"/><path d="M24 12.5v3.5M24 32v3.5M12.5 24h3.5M32 24h3.5M16 16l2.4 2.4M29.6 29.6 32 32M32 16l-2.4 2.4M16 32l2.4-2.4"/>` },
];

const services = [
  ['General Trading & Rental','Buy outright or hire by the day, week or project — the same machines, your choice of terms.'],
  ['Equipment Sourcing',"Can't find it in our yard? We source specialist machines and brands to spec, worldwide."],
  ['Logistics & Export','Delivery across the UAE and export handling — loaded, documented and moved fast.'],
];

const branches = [
  { name:'Ras Al Khor 2', city:'Dubai, UAE', addr:'Ras Al Khor Industrial Area 2', phone:'+971 52 399 5373', hours:'Mon–Fri 8:00–18:30 · Sat–Sun closed', tbd:false },
  { name:'Second yard', city:'UAE', addr:'Address coming soon', phone:'—', hours:'Details to be confirmed', tbd:true },
];
---
<Base>
  <!-- ================= NAV ================= -->
  <header class="nav">
    <div class="nav__in wrap">
      <a href="/" class="logo" aria-label="Collins Equipments LLC — home">
        <svg class="logo__mark" viewBox="0 0 40 44" width="30" height="33" aria-hidden="true">
          <path d="M20 2 36 11.5v21L20 42 4 32.5v-21z" fill="none" stroke="#0050F0" stroke-width="2.4"/>
          <path d="M25 16a7.5 7.5 0 1 0 0 12" fill="none" stroke="#0050F0" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
        <span class="logo__txt">
          <span class="logo__word">COLLINS</span>
          <span class="logo__sub">Equipments LLC</span>
        </span>
      </a>

      <input type="checkbox" id="nav-toggle" class="nav__cbx" hidden />
      <nav class="nav__links" aria-label="Primary">
        <a href="/rental/">Rental</a>
        <a href="/trading/">Trading</a>
        <a href="/heavy-equipment/">Equipment</a>
        <a href="/about/">About</a>
        <a href="/services/">Services</a>
        <a href="/contact-us/">Contact</a>
        <a href="/request-a-quote/" class="btn btn--y nav__quote">Request a Quote</a>
      </nav>
      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Switch to dark theme" title="Switch theme">
        <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      </button>
      <label for="nav-toggle" class="nav__burger" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </label>
    </div>
  </header>

  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var root = document.documentElement, dark = root.getAttribute('data-theme') === 'dark';
        if (dark) root.removeAttribute('data-theme'); else root.setAttribute('data-theme', 'dark');
        try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
        btn.setAttribute('aria-label', dark ? 'Switch to dark theme' : 'Switch to light theme');
      });
    })();
  </script>

  <!-- ================= HERO ================= -->
  <main >
    <section class="hero blueprint">
      <div class="wrap hero__in">

        <div class="hero__copy">
          <h1 class="hero__h1">Heavy machinery,<br>drawn to spec.</h1>
          <p class="hero__sub">
            Generators to earthmovers — the UAE's full heavy-equipment range,
            to <b>buy or hire</b>, delivered fast from two Dubai yards.
          </p>
          <ul class="ticks">
            <li><svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h6m6 0h6M7 2v8M13 2v8" stroke="currentColor" fill="none"/></svg>Top international brands — Perkins, Kalmar, Deutz</li>
            <li><svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h6m6 0h6M7 2v8M13 2v8" stroke="currentColor" fill="none"/></svg>Flexible sale &amp; rental options</li>
            <li><svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h6m6 0h6M7 2v8M13 2v8" stroke="currentColor" fill="none"/></svg>Ready inventory, fast delivery</li>
          </ul>
        </div>

        <!-- ===== the working drawing ===== -->
        <figure class="hero__dwg">
          <svg class="draw" viewBox="0 0 700 520" role="img" aria-label="Dimensioned working drawing of a diesel generator, output 10 to 1250 KVA, from Collins Equipments.">
            <defs>
              <marker id="ah" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0 0l8 3-8 3z" fill="rgba(255,255,255,.62)"/></marker>
              <marker id="ahy" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0 0l8 3-8 3z" fill="#FFDD04"/></marker>
            </defs>

            <!-- s1 · skid + feet -->
            <g class="s1" stroke="rgba(255,255,255,.62)" stroke-width="1.4" fill="none">
              <rect x="70" y="350" width="560" height="26"/>
              <path d="M112 376h46v14h-46z M542 376h46v14h-46z"/>
              <path d="M118 376l-4 14M130 376l-4 14M142 376l-4 14M548 376l-4 14M560 376l-4 14M572 376l-4 14" stroke-width="1"/>
            </g>

            <!-- s2 · enclosure body, louvers, access door -->
            <g class="s2" stroke="rgba(255,255,255,.62)" stroke-width="1.4" fill="none">
              <rect x="100" y="150" width="500" height="200" rx="6"/>
              <line x1="100" y1="182" x2="600" y2="182" stroke="rgba(255,255,255,.32)"/>
              <g stroke="rgba(255,255,255,.32)" stroke-width="1.1">
                <line x1="128" y1="196" x2="128" y2="338"/><line x1="144" y1="196" x2="144" y2="338"/>
                <line x1="160" y1="196" x2="160" y2="338"/><line x1="176" y1="196" x2="176" y2="338"/>
                <line x1="192" y1="196" x2="192" y2="338"/><line x1="208" y1="196" x2="208" y2="338"/>
              </g>
              <rect x="250" y="196" width="150" height="142"/>
              <circle cx="386" cy="267" r="4"/>
              <line x1="250" y1="196" x2="250" y2="338" stroke="rgba(255,255,255,.32)"/>
            </g>

            <!-- s3 · control panel, exhaust, lifting eye -->
            <g class="s3" stroke="rgba(255,255,255,.62)" stroke-width="1.4" fill="none">
              <rect x="436" y="200" width="146" height="98"/>
              <circle cx="474" cy="232" r="15"/>
              <line x1="474" y1="232" x2="483" y2="223"/>
              <rect x="505" y="250" width="62" height="20"/>
              <circle cx="452" cy="278" r="4"/><circle cx="472" cy="278" r="4"/><circle cx="492" cy="278" r="4"/>
              <path d="M150 150v-30h20v30" />
              <ellipse cx="160" cy="120" rx="10" ry="4"/>
              <path d="M338 150v-14h20v14M348 136v-10" />
              <circle cx="348" cy="122" r="7"/>
            </g>

            <!-- s4 · dimension lines (overall length, height) -->
            <g class="s4" stroke="rgba(255,255,255,.62)" stroke-width="1" fill="none">
              <line x1="100" y1="150" x2="100" y2="98"/><line x1="600" y1="150" x2="600" y2="98"/>
              <line x1="100" y1="108" x2="600" y2="108" marker-start="url(#ah)" marker-end="url(#ah)"/>
              <line x1="600" y1="150" x2="662" y2="150"/><line x1="600" y1="376" x2="662" y2="376"/>
              <line x1="652" y1="150" x2="652" y2="376" marker-start="url(#ah)" marker-end="url(#ah)"/>
            </g>

            <!-- s5 · yellow OUTPUT bracket (the one accent) -->
            <g class="s5" stroke="#FFDD04" stroke-width="1.4" fill="none">
              <line x1="100" y1="398" x2="100" y2="418"/><line x1="600" y1="398" x2="600" y2="418"/>
              <line x1="100" y1="408" x2="600" y2="408" marker-start="url(#ahy)" marker-end="url(#ahy)"/>
            </g>

            <!-- text + title block (fades in) -->
            <g class="tg">
              <text x="350" y="90" text-anchor="middle" class="dt">OVERALL — 3 400 MM</text>
              <text x="678" y="267" text-anchor="middle" class="dt" transform="rotate(90 678 267)">2 050</text>
              <text x="350" y="432" text-anchor="middle" class="dt dt--y">OUTPUT — 10 TO 1250 KVA</text>

              <!-- title block, bottom-right -->
              <g transform="translate(398 452)">
                <rect x="0" y="0" width="292" height="60" fill="#0B0C0F" stroke="rgba(255,255,255,.62)" stroke-width="1.2"/>
                <line x1="176" y1="0" x2="176" y2="60" stroke="rgba(255,255,255,.32)"/>
                <text x="12" y="20" class="tb tb--strong">COLLINS EQUIPMENTS LLC</text>
                <text x="12" y="37" class="tb">DWG. GEN-01 · DIESEL GENERATOR</text>
                <text x="12" y="52" class="tb tb--dim">SCALE NTS · RAS AL KHOR, DUBAI</text>
                <text x="186" y="18" class="tb tb--dim">INTENT</text>
                <text x="234" y="46" text-anchor="middle" class="stamp stamp--buy" transform="rotate(-7 234 40)">BUY</text>
                <text x="234" y="46" text-anchor="middle" class="stamp stamp--hire" transform="rotate(5 234 40)">HIRE</text>
              </g>
            </g>
          </svg>
        </figure>
      </div>

      <!-- ===== title-block action bar ===== -->
      <div class="wrap">
        <div class="tbar">
          <fieldset class="intent">
            <legend class="lab">Intent</legend>
            <input type="radio" name="intent" id="intent-buy" checked />
            <label for="intent-buy">Buy</label>
            <input type="radio" name="intent" id="intent-hire" />
            <label for="intent-hire">Hire</label>
          </fieldset>

          <div class="tbar__cta">
            <a href="/request-a-quote/" class="btn btn--y">Request a Quote</a>
            <a href="/heavy-equipment/" class="btn btn--o">Browse Equipment</a>
          </div>

          <p class="tbar__meta mono">DWG GEN-01 · 10–1250 KVA · 2 UAE YARDS</p>
        </div>
      </div>
    </section>

    <!-- ========== CATALOG ========== -->
    <section class="cat">
      <div class="wrap">
        <header class="sec-head">
          <h2>The catalog</h2>
          <p>Every line is available to buy or hire. Open a sheet for specs and a one-tap enquiry.</p>
        </header>
        <div class="cat__grid">
          {categories.map((c) => (
            <a class="sheet" href={c.href}>
              <div class="sheet__top mono"><span>DWG. {c.dwg}-00</span><span>SHT 1/1</span></div>
              <svg class="sheet__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon}></svg>
              <h3>{c.name}</h3>
              <p class="sheet__spec mono">{c.spec}</p>
              <p class="sheet__blurb">{c.blurb}</p>
              <span class="sheet__cta mono">Buy / Hire <svg viewBox="0 0 20 8" width="20" height="8" fill="none" aria-hidden="true"><path d="M0 4h17m0 0-4-3m4 3-4 3" stroke="currentColor"/></svg></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ========== SERVICES ========== -->
    <section class="svc">
      <div class="wrap">
        <header class="sec-head"><h2>What we do</h2><p>One partner for buying, hiring, sourcing and moving heavy equipment.</p></header>
        <div class="svc__grid">
          {services.map(([t, d]) => (
            <div class="svc__item"><h3>{t}</h3><p>{d}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ========== PARTNERS ========== -->
    <section class="partners">
      <div class="wrap partners__in">
        <p class="lab">Built on the world's top brands</p>
        <div class="partners__row">
          <span class="plate">Perkins</span><span class="plate">Kalmar</span><span class="plate">Deutz</span><span class="plate--more mono">+ more</span>
        </div>
      </div>
    </section>

    <!-- ========== WE ARE COLLINS ========== -->
    <section class="about">
      <div class="wrap about__grid">
        <div class="about__copy">
          <h2>We are Collins Equipments</h2>
          <p>We proudly serve Power Generation, Construction, Oil &amp; Gas, Renewable Energy and more — and our expansion into the UAE marks an exciting new chapter.</p>
          <blockquote class="owner">
            <p>"We built Collins on one promise: reliable machines, delivered when you need them, backed by people who pick up the phone."</p>
            <cite>Rohan Robert — Managing Director</cite>
          </blockquote>
          <a class="btn btn--o" href="/about/">Read the owner's message</a>
        </div>
        <dl class="stats">
          <div><dt>Units delivered</dt><dd>4,000<span>+</span></dd></div>
          <div><dt>Years of service</dt><dd>3<span>+</span></dd></div>
          <div><dt>Industries served</dt><dd>50<span>+</span></dd></div>
        </dl>
      </div>
    </section>

    <!-- ========== BRANCHES ========== -->
    <section class="branches">
      <div class="wrap">
        <header class="sec-head"><h2>Two UAE yards</h2><p>Ready inventory and fast delivery from two Dubai locations.</p></header>
        <div class="branch__grid">
          {branches.map((b) => (
            <article class={`branch${b.tbd ? ' branch--tbd' : ''}`}>
              <div class="branch__map" aria-hidden="true">
                <svg viewBox="0 0 200 120" preserveAspectRatio="none"><path class="pin" d="M100 40c-9 0-15 6-15 15 0 11 15 25 15 25s15-14 15-25c0-9-6-15-15-15z"/><circle cx="100" cy="55" r="5"/></svg>
              </div>
              <div class="branch__info">
                <h3>{b.name}</h3>
                <p class="branch__addr">{b.addr}<br>{b.city}</p>
                <p class="mono branch__meta">{b.hours}</p>
                {b.tbd
                  ? <span class="branch__tag mono">Coming soon</span>
                  : <a class="branch__dir mono" href="https://maps.google.com/?q=Ras+Al+Khor+Industrial+Area+2+Dubai" target="_blank" rel="noopener">{b.phone} · Get directions →</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ========== LEAD FORM ========== -->
    <section class="lead" id="quote">
      <div class="wrap lead__grid">
        <div class="lead__copy">
          <h2>Get a quote</h2>
          <p>Tell us the equipment and whether you want to buy or hire. We'll come back fast with availability and pricing.</p>
          <ul class="lead__facts mono">
            <li>Ras Al Khor 2, Dubai, UAE</li>
            <li>Mon–Fri 8:00–18:30</li>
            <li>info@collinscouae.com</li>
          </ul>
        </div>
        <form class="lead__form" action="#" method="post">
          <fieldset class="intent intent--form">
            <legend class="lab">Intent</legend>
            <input type="radio" name="q-intent" id="q-buy" checked />
            <label for="q-buy">Buy</label>
            <input type="radio" name="q-intent" id="q-hire" />
            <label for="q-hire">Hire</label>
          </fieldset>
          <div class="field-row">
            <p class="field"><label for="fn">First name</label><input id="fn" name="first" type="text" autocomplete="given-name" required /></p>
            <p class="field"><label for="ln">Last name</label><input id="ln" name="last" type="text" autocomplete="family-name" required /></p>
          </div>
          <div class="field-row">
            <p class="field"><label for="em">Email</label><input id="em" name="email" type="email" autocomplete="email" required /></p>
            <p class="field"><label for="ph">Phone</label><input id="ph" name="phone" type="tel" autocomplete="tel" /></p>
          </div>
          <p class="field"><label for="msg">What do you need?</label><textarea id="msg" name="message" rows="3" placeholder="e.g. 250 KVA generator, 3-month hire, Dubai site"></textarea></p>
          <button type="submit" class="btn btn--y lead__submit">Request a Quote</button>
        </form>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ---------- NAV ---------- */
    .nav{position:sticky;top:0;z-index:50;background:var(--nav-bg);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
    .nav__in{display:flex;align-items:center;gap:24px;min-height:72px}
    .logo{display:flex;align-items:center;gap:10px;margin-right:auto}
    .logo__mark{flex:none}
    .logo__word{font-family:var(--f-display);font-size:1.7rem;line-height:.8;color:var(--blue);letter-spacing:.02em;display:block}
    .logo__sub{font-family:var(--f-mono);font-size:.56rem;letter-spacing:.34em;text-transform:uppercase;color:var(--fg-dim);display:block;margin-top:2px}
    .nav__links{display:flex;align-items:center;gap:26px}
    .nav__links a:not(.btn){font-size:.9rem;color:var(--fg-dim);transition:color .15s}
    .nav__links a:not(.btn):hover{color:var(--fg)}
    .nav__burger{display:none;color:var(--fg);padding:6px}
    .theme-btn{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--line-2);background:transparent;color:var(--fg-dim);cursor:pointer;transition:color .15s,border-color .15s}
    .theme-btn:hover{color:var(--fg);border-color:var(--fg-dim)}
    .theme-btn .i-sun{display:none}
    :root[data-theme='dark'] .theme-btn .i-moon{display:none}
    :root[data-theme='dark'] .theme-btn .i-sun{display:block}

    /* ---------- BUTTONS ---------- */
    .btn{display:inline-flex;align-items:center;justify-content:center;font-family:var(--f-mono);font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:13px 22px;border:1px solid transparent;white-space:nowrap;transition:transform .16s var(--ease),background .16s,color .16s}
    .btn--y{background:var(--yellow);color:var(--on-yellow)}
    .btn--y:hover{background:#ffe64a;transform:translateY(-2px)}
    .btn--o{background:transparent;color:var(--fg);border-color:var(--orange)}
    .btn--o:hover{background:var(--orange);color:#fff;transform:translateY(-2px)}
    .nav__quote{padding:10px 18px}

    /* ---------- HERO ---------- */
    .hero{position:relative;padding-block:clamp(28px,5vw,64px) clamp(20px,3vw,36px)}
    .hero.blueprint{background-image:
      linear-gradient(var(--line) 1px,transparent 1px),
      linear-gradient(90deg,var(--line) 1px,transparent 1px);
      background-size:34px 34px;background-position:center top}
    .hero::after{content:"";position:absolute;inset:0;pointer-events:none;
      background:radial-gradient(120% 90% at 72% 30%,rgba(0,80,240,.10),transparent 60%)}
    .hero__in{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(24px,4vw,56px);align-items:center;min-height:clamp(420px,60vh,600px)}

    .hero__h1{font-size:clamp(3.2rem,2rem + 6vw,6rem);color:var(--fg)}
    .hero__sub{max-width:44ch;margin-top:20px;font-size:var(--t-1);color:var(--fg-dim)}
    .hero__sub b{color:var(--fg);font-weight:600}
    .ticks{list-style:none;margin:26px 0 0;padding:0;display:grid;gap:12px}
    .ticks li{display:flex;align-items:center;gap:12px;font-family:var(--f-mono);font-size:.78rem;letter-spacing:.04em;color:var(--fg-dim)}
    .ticks svg{width:22px;height:13px;color:var(--accent-line);flex:none}
    .ticks path{stroke-width:1.3}

    .hero__dwg{margin:0}
    .hero__dwg svg{width:100%;height:auto;overflow:visible}
    .draw text{font-family:var(--f-mono)}
    .dt{fill:var(--fg-dim);font-size:12px;letter-spacing:.08em}
    .dt--y{fill:var(--accent-line);font-size:13px}
    .tb{fill:var(--fg-dim);font-size:9.5px;letter-spacing:.06em}
    .tb--strong{fill:var(--fg);font-size:10.5px;letter-spacing:.09em}
    .tb--dim{fill:var(--fg-faint)}
    .stamp{font-size:18px;letter-spacing:.06em;font-weight:600}
    .stamp--buy{fill:var(--orange)}
    .stamp--hire{fill:var(--fg);opacity:0}
    .hero:has(#intent-hire:checked) .stamp--buy{opacity:0}
    .hero:has(#intent-hire:checked) .stamp--hire{opacity:1}

    /* theme-aware drawing: CSS wins over the inline stroke/fill fallbacks */
    .draw g.s1 *,.draw g.s2 *,.draw g.s3 *,.draw g.s4 *{stroke:var(--draw-line)}
    .draw g.s5 line{stroke:var(--accent-line)}
    .draw #ah path{fill:var(--draw-line)}
    .draw #ahy path{fill:var(--accent-line)}
    .tg rect{fill:var(--draw-panel)}

    /* draw-on motion — the one authored moment */
    .draw g.s1 :is(rect,path,line,circle,ellipse),
    .draw g.s2 :is(rect,path,line,circle,ellipse),
    .draw g.s3 :is(rect,path,line,circle,ellipse),
    .draw g.s4 line,.draw g.s5 line{
      stroke-dasharray:2200;stroke-dashoffset:2200;animation:draw 1.1s var(--ease) forwards}
    .draw g.s2 :is(rect,path,line,circle,ellipse){animation-delay:.16s}
    .draw g.s3 :is(rect,path,line,circle,ellipse){animation-delay:.34s}
    .draw g.s4 line{animation-delay:.6s}
    .draw g.s5 line{animation-delay:.86s}
    .draw .tg{opacity:0;animation:fade .7s ease 1.05s forwards}
    @keyframes draw{to{stroke-dashoffset:0}}
    @keyframes fade{to{opacity:1}}

    /* ---------- title-block action bar ---------- */
    .tbar{margin-top:clamp(20px,3vw,34px);display:flex;flex-wrap:wrap;align-items:stretch;gap:0;border:1px solid var(--line-2);background:var(--ink-1)}
    .tbar>*{padding:16px 22px;border-right:1px solid var(--line);display:flex;align-items:center}
    .tbar>*:last-child{border-right:0}
    .intent{border:0;margin:0;gap:0;position:relative}
    .intent legend{position:absolute;top:6px;left:22px}
    .intent{padding-top:26px;padding-bottom:12px}
    .intent input{position:absolute;opacity:0;pointer-events:none}
    .intent label{font-family:var(--f-mono);font-size:.82rem;letter-spacing:.12em;text-transform:uppercase;padding:9px 20px;border:1px solid var(--line-2);color:var(--fg-dim);cursor:pointer;transition:.15s}
    .intent label[for=intent-buy]{border-right:0}
    #intent-buy:checked~label[for=intent-buy],
    #intent-hire:checked~label[for=intent-hire]{background:var(--yellow);color:var(--on-yellow);border-color:var(--yellow)}
    .intent label:hover{color:var(--fg)}
    .tbar__cta{gap:12px;flex-wrap:wrap;margin-right:auto}
    .tbar__meta{color:var(--fg-faint);font-size:.74rem;letter-spacing:.08em}

    /* ---------- RESPONSIVE ---------- */
    @media (max-width:900px){
      .nav__burger{display:inline-flex}
      .nav__links{position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:var(--ink-1);border-bottom:1px solid var(--line);padding:8px clamp(16px,4vw,44px) 20px;opacity:0;visibility:hidden;transform:translateY(-10px);transition:opacity .24s var(--ease),transform .24s var(--ease),visibility .24s}
      .nav__cbx:checked~.nav__links{opacity:1;visibility:visible;transform:translateY(0)}
      .nav__links a:not(.btn){padding:13px 0;border-bottom:1px solid var(--line)}
      .nav__quote{margin-top:14px}
      .hero__in{grid-template-columns:1fr;min-height:0}
      .hero__copy{order:1}
      .hero__dwg{order:2}
      .tbar>*{border-right:0;border-bottom:1px solid var(--line);width:100%}
      .tbar__cta .btn{flex:1}
    }
    @media (max-width:520px){
      .hero__h1{font-size:clamp(2.8rem,2rem + 9vw,4rem)}
      .tbar__cta{width:100%}
    }
    @media (prefers-reduced-motion:reduce){
      .draw *{animation:none!important;stroke-dashoffset:0!important;opacity:1!important}
      .btn,.intent label,.nav__links a{transition:none}
    }

    /* ============ SECTIONS ============ */
    .cat,.svc,.about,.branches,.lead{padding-block:clamp(56px,8vw,112px)}
    .sec-head{margin-bottom:clamp(28px,4vw,50px)}
    .sec-head h2{font-size:clamp(2.4rem,1.6rem + 3vw,3.6rem)}
    .sec-head p{margin-top:12px;color:var(--fg-dim);font-size:var(--t-1);max-width:48ch}

    /* catalog sheets */
    .cat__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
    .sheet{display:flex;flex-direction:column;gap:9px;padding:26px 24px;background:var(--ink-0);position:relative;outline:1px solid transparent;outline-offset:-1px;transition:background .18s,transform .18s var(--ease),box-shadow .18s,outline-color .18s}
    .sheet__top{display:flex;justify-content:space-between;font-size:.62rem;letter-spacing:.12em;color:var(--fg-faint);border-bottom:1px solid var(--line);padding-bottom:13px;margin-bottom:4px}
    .sheet__icon{width:54px;height:54px;color:var(--fg)}
    .sheet h3{font-size:1.75rem;margin-top:2px}
    .sheet__spec{color:var(--yellow);font-size:.8rem;letter-spacing:.05em}
    .sheet__blurb{color:var(--fg-dim);font-size:.9rem;flex:1}
    .sheet__cta{display:inline-flex;align-items:center;gap:9px;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--fg);margin-top:6px}
    .sheet__cta svg{color:var(--yellow)}
    .sheet:hover{background:var(--ink-1);transform:translateY(-3px);z-index:1;box-shadow:0 16px 40px rgba(0,0,0,.28);outline-color:var(--accent-line)}

    /* services */
    .svc__grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}
    .svc__item{padding:clamp(24px,3vw,38px);border-right:1px solid var(--line)}
    .svc__item:last-child{border-right:0}
    .svc__item h3{font-size:1.6rem;margin-bottom:12px}
    .svc__item p{color:var(--fg-dim)}

    /* partners */
    .partners{padding-block:clamp(26px,4vw,42px);border-block:1px solid var(--line);background:var(--ink-1)}
    .partners__in{display:flex;align-items:center;gap:clamp(18px,4vw,44px);flex-wrap:wrap;justify-content:center}
    .partners__row{display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:center}
    .plate{font-family:var(--f-display);font-size:1.5rem;letter-spacing:.04em;color:var(--fg-dim);border:1px solid var(--line-2);padding:6px 18px;transition:color .18s,border-color .18s}
    .plate:hover{color:var(--fg);border-color:var(--fg-dim)}
    .plate--more{font-family:var(--f-mono);font-size:.78rem;color:var(--fg-faint)}

    /* about + stats */
    .about__grid{display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(32px,5vw,72px);align-items:center}
    .about__copy h2{font-size:clamp(2.2rem,1.5rem + 2.6vw,3.2rem)}
    .about__copy > p{margin-top:16px;color:var(--fg-dim);font-size:var(--t-1);max-width:48ch}
    .owner{margin:26px 0;padding:20px 22px;border:1px solid var(--line-2);background:var(--ink-1)}
    .owner p{font-size:1.12rem;color:var(--fg)}
    .owner cite{display:block;margin-top:13px;font-family:var(--f-mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-line);font-style:normal}
    .stats{margin:0;border:1px solid var(--line)}
    .stats > div{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:20px 24px;border-bottom:1px solid var(--line)}
    .stats > div:last-child{border-bottom:0}
    .stats dt{color:var(--fg-dim);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;font-family:var(--f-mono)}
    .stats dd{margin:0;font-family:var(--f-display);font-size:3.4rem;line-height:.78;color:var(--fg)}
    .stats dd span{color:var(--accent-line)}

    /* branches */
    .branch__grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .branch{border:1px solid var(--line-2);display:flex;flex-direction:column;background:var(--ink-1)}
    .branch__map{aspect-ratio:16/6;background-color:var(--map-bg);background-image:linear-gradient(var(--map-grid) 1px,transparent 1px),linear-gradient(90deg,var(--map-grid) 1px,transparent 1px);background-size:24px 24px;border-bottom:1px solid var(--line-2);display:grid;place-items:center}
    .branch__map svg{width:64px;height:40px}
    .branch__map .pin{fill:none;stroke:var(--accent-line);stroke-width:2.4}
    .branch__map circle{fill:var(--map-bg);stroke:var(--accent-line);stroke-width:2.4}
    .branch__info{padding:24px}
    .branch__info h3{font-size:1.7rem}
    .branch__addr{margin-top:8px;color:var(--fg-dim)}
    .branch__meta{margin-top:12px;font-size:.72rem;color:var(--fg-faint);letter-spacing:.05em}
    .branch__dir{display:inline-block;margin-top:16px;color:var(--yellow);font-size:.76rem;letter-spacing:.05em}
    .branch--tbd{border-style:dashed;opacity:.72}
    .branch--tbd .branch__map{opacity:.5}
    .branch__tag{display:inline-block;margin-top:16px;padding:5px 12px;border:1px solid var(--line-2);color:var(--fg-faint);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase}

    /* lead form */
    .lead{background:var(--ink-1);border-top:1px solid var(--line)}
    .lead__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(32px,5vw,72px);align-items:start}
    .lead__copy h2{font-size:clamp(2.2rem,1.5rem + 2.6vw,3.2rem)}
    .lead__copy > p{margin-top:16px;color:var(--fg-dim);font-size:var(--t-1);max-width:40ch}
    .lead__facts{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:11px;color:var(--fg-dim);font-size:.8rem;letter-spacing:.03em}
    .lead__facts li{padding-left:20px;position:relative}
    .lead__facts li::before{content:"";position:absolute;left:0;top:.55em;width:10px;height:1px;background:var(--accent-line)}
    .lead__form{background:var(--ink-0);border:1px solid var(--line-2);padding:clamp(22px,3vw,32px);display:grid;gap:16px}
    .intent--form{margin-bottom:2px}
    #q-buy:checked~label[for=q-buy],#q-hire:checked~label[for=q-hire]{background:var(--yellow);color:var(--on-yellow);border-color:var(--yellow)}
    .intent label[for=q-buy]{border-right:0}
    .field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .field{display:flex;flex-direction:column;gap:7px;margin:0}
    .field label{font-family:var(--f-mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--fg-dim)}
    .field input,.field textarea{background:var(--ink-1);border:1px solid var(--line-2);color:var(--fg);font-family:var(--f-body);font-size:.95rem;padding:12px 14px}
    .field input:focus,.field textarea:focus{outline:none;border-color:var(--accent-line)}
    .field textarea{resize:vertical}
    .field ::placeholder{color:var(--fg-faint)}
    .lead__submit{justify-self:start;margin-top:2px}

    /* sections · responsive */
    @media (max-width:900px){
      .cat__grid{grid-template-columns:repeat(2,1fr)}
      .svc__grid{grid-template-columns:1fr}
      .svc__item{border-right:0;border-bottom:1px solid var(--line)}
      .svc__item:last-child{border-bottom:0}
      .about__grid,.lead__grid,.branch__grid{grid-template-columns:1fr}
    }
    @media (max-width:520px){
      .cat__grid{grid-template-columns:1fr}
      .field-row{grid-template-columns:1fr}
      .stats dd{font-size:2.9rem}
    }
    @media (prefers-reduced-motion:reduce){
      .sheet,.sheet::after,.plate,.branch{transition:none}
    }
  </style>
</Base>
