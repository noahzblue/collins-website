  /* ── B · strip ──────────────────────────────────────────────── */
  .b-top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .b-arrows {
    display: flex;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }
  .b-arrow {
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
  }
  .b-arrow:hover {
    background: var(--color-brand-tint);
    color: var(--color-brand);
  }
  .b-arrow:disabled {
    color: var(--color-line-strong);
    background: #fff;
    cursor: default;
  }
  .b-tabs {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--color-line);
  }
  .b-tab {
    flex: 0 0 auto;
    padding: 10px 0;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-note);
    color: var(--color-muted);
    white-space: nowrap;
  }
  .b-tab:hover {
    color: var(--color-ink);
  }
  .b-tab[aria-pressed="true"] {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
  .b-tab-n {
    margin-left: 4px;
    font-size: var(--text-micro);
    color: var(--color-faint);
  }
  .b-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, calc((100% - 3px) / 4.25));
    gap: 1px;
    margin-top: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: thin;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }
  .b-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    cursor: pointer;
    scroll-snap-align: start;
  }
  .b-card[hidden] {
    display: none;
  }
  .b-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    overflow: clip;
    background: var(--color-surface-2);
    color: var(--color-faint);
  }
  .b-photo img {
    filter: grayscale(1);
    transition:
      filter 300ms var(--ease-out-expo),
      scale 500ms var(--ease-out-expo);
  }
  .b-card:hover .b-photo img,
  .b-card:has(input:checked) .b-photo img {
    filter: none;
    scale: 1.03;
  }
  .b-text {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
  }
  .b-card:has(input:checked) {
    background: var(--color-brand-tint);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .b-name {
    font-size: var(--text-detail);
    font-weight: 500;
    color: var(--color-ink);
  }
  .b-meta {
    margin-top: 2px;
    font-size: var(--text-caption);
    line-height: 1.4;
    color: var(--color-muted);
  }
  @media (max-width: 600px) {
    .b-rail {
      grid-auto-columns: 72%;
    }
    .b-arrows {
      display: none;
    }
  }

  /* ── C · index ──────────────────────────────────────────────── */
  .c-grid {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 34%);
    gap: 0;
    border: 1px solid var(--color-line);
  }
  .c-index {
    columns: 2;
    column-gap: 0;
    column-rule: 1px solid var(--color-line);
  }
  .c-group {
    break-inside: avoid;
  }
  .c-family {
    margin: 0;
    padding: 9px 18px;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: 500;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .c-row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "thumb name" "thumb meta";
    column-gap: 0;
    padding: 11px 18px;
    border-bottom: 1px solid var(--color-line);
    cursor: pointer;
    transition: background-color 160ms var(--ease-out-expo);
  }
  .c-row:hover {
    background: var(--color-surface);
  }
  .c-row:has(input:checked) {
    background: var(--color-brand-tint);
    box-shadow: inset 2px 0 0 var(--color-brand);
  }
  .c-thumb {
    grid-area: thumb;
    display: none;
  }
  .c-name {
    grid-area: name;
    font-size: var(--text-detail);
    font-weight: 500;
    color: var(--color-ink);
  }
  .c-row:has(input:checked) .c-name {
    color: var(--color-brand);
  }
  .c-meta {
    grid-area: meta;
    margin-top: 2px;
    font-size: var(--text-caption);
    color: var(--color-muted);
  }
  .c-preview {
    position: sticky;
    top: var(--spacing-header-gap);
    align-self: start;
    border-left: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .c-preview-empty {
    display: flex;
    aspect-ratio: 4 / 3;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-faint);
  }
  .c-preview-empty[hidden],
  .c-figure[hidden] {
    display: none;
  }
  .c-figure {
    margin: 0;
  }
  .c-photo {
    aspect-ratio: 4 / 3;
    overflow: clip;
    background: var(--color-surface-2);
  }
  .c-figure:not([hidden]) .c-photo img {
    animation: v-in 380ms var(--ease-out-expo);
  }
  .c-caption {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px 18px 18px;
    background: #fff;
    border-top: 1px solid var(--color-line);
  }
  .c-cap-name {
    font-family: var(--font-mono);
    font-size: var(--text-subhead);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .c-cap-meta {
    font-size: var(--text-note);
    color: var(--color-muted);
  }
  @media (max-width: 980px) {
    .c-index {
      columns: 1;
    }
  }
  @media (max-width: 760px) {
    .c-grid {
      grid-template-columns: 1fr;
    }
    .c-preview {
      display: none;
    }
    .c-row {
      column-gap: 14px;
    }
    .c-thumb {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      aspect-ratio: 4 / 3;
      overflow: clip;
      background: var(--color-surface-2);
      color: var(--color-faint);
    }
    .c-row {
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer,
    .b-photo img,
    .v-row-photo img {
      transition-duration: 1ms;
    }
    .v-figure:not([hidden]) .v-photo img,
    .c-figure:not([hidden]) .c-photo img {
      animation: none;
    }
  }
</style>

<script>
  import { untilPageSwap } from "@/scripts/untilPageSwap";

  const readout = (form: HTMLFormElement) => {
    const value = new FormData(form).get("category");
    const out = form.querySelector<HTMLElement>("[data-readout]");
    if (out) out.textContent = `category = ${value ?? "(none)"}`;
  };

  /** A: the one-line field and its viewer. */
  const initViewer = (form: HTMLFormElement, signal: AbortSignal) => {
    const viewer = form.querySelector<HTMLDialogElement>("[data-viewer]");
    if (!viewer) return;
    const field = form.querySelector<HTMLElement>("[data-viewer-open]")!;
    const radios = [
      ...viewer.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    ];
    const figures = [
      ...viewer.querySelectorAll<HTMLElement>("[data-v-figure]"),
    ];
    const count = viewer.querySelector<HTMLElement>("[data-v-count]");
    const picked = viewer.querySelector<HTMLElement>("[data-v-picked]");
    let current = 0;

    const nameOf = (input: HTMLInputElement) =>
      input
        .closest("label")
        ?.querySelector(".v-row-name")
        ?.textContent?.trim() ?? input.value;

    /* The stage follows hover, focus and the arrows; selection is separate,
       so pointing at a machine never answers the question for you. */
    const showStage = (index: number) => {
      current = (index + radios.length) % radios.length;
      const id = radios[current].value;
      for (const figure of figures)
        figure.hidden = figure.dataset.vFigure !== id;
      for (const row of viewer.querySelectorAll<HTMLElement>("[data-v-row]"))
        row.toggleAttribute("data-current", row.dataset.vRow === id);
      if (count)
        count.textContent = `${String(current + 1).padStart(2, "0")} / ${String(radios.length).padStart(2, "0")}`;
    };

    const paintField = () => {
      const chosen = radios.find((r) => r.checked);
      const thumb = form.querySelector<HTMLImageElement>("[data-a-thumb]")!;
      const empty = form.querySelector<HTMLElement>("[data-a-thumb-empty]")!;
      const name = form.querySelector<HTMLElement>("[data-a-name]")!;
      const meta = form.querySelector<HTMLElement>("[data-a-meta]")!;
      const cta = form.querySelector<HTMLElement>("[data-a-cta]")!;
      field.toggleAttribute("data-picked", !!chosen);
      for (const chip of form.querySelectorAll<HTMLElement>("[data-quick]"))
        chip.setAttribute(
          "aria-pressed",
          String(chip.dataset.quick === chosen?.value),
        );
      if (!chosen) return;
      const row = chosen.closest("label")!;
      const img = row.querySelector<HTMLImageElement>("img");
      thumb.hidden = !img;
      empty.hidden = !!img;
      if (img) thumb.src = img.currentSrc || img.src;
      name.textContent = nameOf(chosen);
      meta.textContent =
        row.querySelector(".v-row-meta")?.textContent?.trim() ?? "";
      cta.textContent = "Change";
      if (picked) picked.textContent = `Picked: ${nameOf(chosen)}`;
    };

    field.addEventListener(
      "click",
      () => {
        const chosen = radios.findIndex((r) => r.checked);
        showStage(Math.max(chosen, 0));
        viewer.showModal();
        (radios[Math.max(chosen, 0)] as HTMLElement).focus({
          preventScroll: true,
        });
        radios[Math.max(chosen, 0)]
          .closest("label")
          ?.scrollIntoView({ block: "nearest" });
      },
      { signal },
    );

    for (const close of viewer.querySelectorAll("[data-viewer-close]"))
      close.addEventListener("click", () => viewer.close(), { signal });
    viewer.addEventListener(
      "click",
      (event) => {
        if (event.target === viewer) viewer.close();
      },
      { signal },
    );

    viewer.querySelectorAll<HTMLElement>("[data-v-row]").forEach((row) => {
      const index = radios.findIndex((r) => r.value === row.dataset.vRow);
      row.addEventListener("pointerenter", () => showStage(index), {
        signal,
      });
    });

    for (const radio of radios) {
      radio.addEventListener("focus", () => showStage(radios.indexOf(radio)), {
        signal,
      });
      // Double-click a row to pick and close in one gesture.
      radio
        .closest("label")
        ?.addEventListener("dblclick", () => viewer.close(), { signal });
    }

    for (const button of viewer.querySelectorAll<HTMLElement>("[data-v-step]"))
      button.addEventListener(
        "click",
        () => {
          const next =
            (current + Number(button.dataset.vStep) + radios.length) %
            radios.length;
          radios[next].checked = true;
          radios[next].dispatchEvent(new Event("change", { bubbles: true }));
          showStage(next);
          radios[next].closest("label")?.scrollIntoView({ block: "nearest" });
        },
        { signal },
      );

    for (const chip of form.querySelectorAll<HTMLElement>("[data-quick]"))
      chip.addEventListener(
        "click",
        () => {
          const radio = radios.find((r) => r.value === chip.dataset.quick);
          if (!radio) return;
          radio.checked = true;
          radio.dispatchEvent(new Event("change", { bubbles: true }));
        },
        { signal },
      );

    form.addEventListener(
      "change",
      () => {
        paintField();
        const chosen = radios.findIndex((r) => r.checked);
        if (chosen >= 0) showStage(chosen);
      },
      { signal },
    );
    paintField();
  };

  /** B: tabs filter the rail; arrows page it. */
  const initStrip = (form: HTMLFormElement, signal: AbortSignal) => {
    const rail = form.querySelector<HTMLElement>("[data-b-rail]");
    if (!rail) return;
    const tabs = [...form.querySelectorAll<HTMLElement>("[data-b-filter]")];
    const arrows = [
      ...form.querySelectorAll<HTMLButtonElement>("[data-b-step]"),
    ];

    const paintArrows = () => {
      const max = rail.scrollWidth - rail.clientWidth - 2;
      arrows[0].disabled = rail.scrollLeft <= 2;
      arrows[1].disabled = rail.scrollLeft >= max;
    };

    for (const tab of tabs)
      tab.addEventListener(
        "click",
        () => {
          const family = tab.dataset.bFilter ?? "";
          for (const t of tabs)
            t.setAttribute("aria-pressed", String(t === tab));
          for (const card of rail.querySelectorAll<HTMLElement>(".b-card"))
            card.hidden =
              !!family &&
              card.dataset.family !== family &&
              !card.querySelector("input:checked");
          rail.scrollTo({ left: 0 });
          requestAnimationFrame(paintArrows);
        },
        { signal },
      );

    for (const arrow of arrows)
      arrow.addEventListener(
        "click",
        () =>
          rail.scrollBy({
            left: Number(arrow.dataset.bStep) * rail.clientWidth * 0.75,
            behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth",
          }),
        { signal },
      );
    rail.addEventListener("scroll", paintArrows, { signal, passive: true });
    paintArrows();
  };

  /** C: the pinned photo follows the pointer, then falls back to the pick. */
  const initIndex = (form: HTMLFormElement, signal: AbortSignal) => {
    const figures = [...form.querySelectorAll<HTMLElement>("[data-c-figure]")];
    if (!figures.length) return;
    const empty = form.querySelector<HTMLElement>("[data-c-empty]");
    const show = (id: string | null) => {
      let matched = false;
      for (const figure of figures) {
        const on = figure.dataset.cFigure === id;
        figure.hidden = !on;
        matched ||= on;
      }
      if (empty) empty.hidden = matched;
    };
    const picked = () =>
      form.querySelector<HTMLInputElement>('input[name="category"]:checked')
        ?.value ?? null;

    for (const row of form.querySelectorAll<HTMLElement>("[data-c-row]")) {
      row.addEventListener("pointerenter", () => show(row.dataset.cRow!), {
        signal,
      });
      row.addEventListener("pointerleave", () => show(picked()), { signal });
      row
        .querySelector("input")
        ?.addEventListener("focus", () => show(row.dataset.cRow!), {
          signal,
        });
    }
    form.addEventListener("change", () => show(picked()), { signal });
  };

  document.addEventListener("astro:page-load", () => {
    const signal = untilPageSwap();
    for (const form of document.querySelectorAll<HTMLFormElement>(
      "[data-picker]",
    )) {
      form.addEventListener("submit", (e) => e.preventDefault(), { signal });
      form.addEventListener("change", () => readout(form), { signal });
      if (form.dataset.picker === "a") initViewer(form, signal);
      if (form.dataset.picker === "b") initStrip(form, signal);
      if (form.dataset.picker === "c") initIndex(form, signal);
    }
  });
</script>
