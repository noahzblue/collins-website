  /* Phone: no stage. The list itself becomes the photo reel. */
  @media (max-width: 900px) {
    .viewer {
      width: 100dvw;
      height: 100dvh;
    }
    .v-body {
      display: block;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .v-list {
      overflow: visible;
      border-right: 0;
    }
    .v-stage {
      display: none;
    }
    .v-row {
      flex-wrap: wrap;
      padding: 0 0 14px;
      gap: 0 14px;
    }
    .v-row-photo {
      order: -1;
      flex: 0 0 100%;
      width: 100%;
      aspect-ratio: 16 / 9;
