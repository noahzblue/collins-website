---
/**
 * /yard — "One yard. Ready stock."
 *
 * The only page that says where the machines physically are, what happens to
 * them before dispatch and how fast they leave. Everything else on the site is
 * a claim a competitor could also make.
 *
 * The photography here is placeholder — see the note at the top of
 * data/yard.ts. This page is only as credible as its pictures, so the Sajjah
 * shoot is the thing that finishes it.
 */
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import RailSections from "@/components/ui/RailSections.astro";
import StickyPoints from "@/components/ui/StickyPoints.astro";
import ParallaxImage from "@/components/ui/ParallaxImage.astro";
import PageCTA from "@/components/sections/PageCTA.astro";
import {
  fleetGroups,
  galleryIntro,
  mobilisation,
  yardBlocks,
  yardPage,
  yardPoints,
} from "@/data/yard";
---

<Base title={yardPage.seoTitle} description={yardPage.seoDescription}>
  <PageHeader
    image={yardPage.banner}
    trail={[{ label: "Home", href: "/" }]}
    current="The yard"
    title={yardPage.title}
  >
    <p
      class="mt-5 font-mono text-caption tracking-[1.6px] text-faint uppercase"
    >
      {yardPage.kicker}
    </p>
  </PageHeader>

  <Section>
    {
      /* `RailSections` gives the body `min-w-0`, which is load-bearing here: a
        grid item defaults to `min-width: auto`, so the horizontal fleet rail
        below (4 × 380px of snap cards) would otherwise set the column's
        minimum to its own content width and blow the page past the container. */
    }
    <RailSections items={yardBlocks} ariaLabel="On this page">
      <!-- 01 — the five points against one pinned photograph -->
      <article id="the-yard">
        <Eyebrow class="mb-[16px]">The yard</Eyebrow>
        <h2 class="mb-14 max-w-[640px] text-h2 leading-[1.06]" data-reveal>
          What happens here before anything leaves.
        </h2>
        <StickyPoints points={yardPoints} />
      </article>

      <hr class="my-[96px] border-0 border-t border-line max-mob:my-[64px]" />

      <!-- 02 — the fleet, feeding the catalogue rather than dead-ending -->
      <article id="the-fleet">
        <Eyebrow class="mb-[16px]">The fleet</Eyebrow>
        <h2 class="max-w-[560px] text-h2 leading-[1.06]" data-reveal>
          Leaving the Sajjah yard.
        </h2>
        <p
          class="mt-6 max-w-[620px] text-lead leading-relaxed text-muted"
          data-reveal
        >
          {galleryIntro}
        </p>

        {
          /* Snap rail on desktop; no arrows — the overflow itself is the
                affordance. `overscroll-x-contain` and nothing else: Lenis reads
                it to stand off the rail on the horizontal axis while a vertical
                wheel over it still scrolls the page (see IndexRail's note). */
        }
        <div
          class="-mx-1 mt-11 flex snap-x snap-mandatory gap-5 overflow-x-auto overscroll-x-contain px-1 pb-4 max-nav:grid max-nav:grid-cols-2 max-nav:gap-4 max-nav:overflow-visible max-xs:grid-cols-1"
        >
          {
            fleetGroups.map((group, i) => (
              <a
                href={group.href}
                class="group press w-[380px] shrink-0 snap-start max-nav:w-auto"
              >
                <div class="relative overflow-clip rounded-md bg-surface-2">
                  {/* The strip scrolls sideways, so the drift rides its
                          axis rather than the page's — see ParallaxImage's
                          note on `axis`. */}
                  <ParallaxImage
                    src={group.image}
                    alt={`${group.label} standing in the Collins yard at Sajjah, ${group.range}.`}
                    loading={i === 0 ? "eager" : "lazy"}
                    axis="inline"
                    class="aspect-[4/3] w-full transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                  />
                  <span class="absolute top-4 left-4 font-mono text-caption tracking-[0.5px] text-white/85">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <span class="mt-4 flex items-baseline justify-between gap-4">
                  <span class="text-subhead font-medium text-ink transition-colors group-hover:text-brand">
                    {group.label}
                  </span>
                  <Icon
                    name="arrow-up-right"
                    size={15}
                    class="shrink-0 text-faint transition-colors group-hover:text-brand"
                  />
                </span>
                <span class="mt-1 block font-mono text-caption tracking-[0.4px] text-muted">
                  {group.range}
                </span>
              </a>
            ))
          }
        </div>
      </article>

      <hr class="my-[96px] border-0 border-t border-line max-mob:my-[64px]" />

      <!-- 03 — what happens when you call -->
      <article id="mobilisation">
        <Eyebrow class="mb-[16px]">Mobilisation</Eyebrow>
        <h2 class="max-w-[560px] text-h2 leading-[1.06]" data-reveal>
          From your call to the gate.
        </h2>

        <ol
          class="mt-12 grid grid-cols-4 border-t border-line-strong max-nav:grid-cols-2 max-xs:grid-cols-1"
          data-reveal
          data-reveal-stagger
        >
          {
            mobilisation.map((step, i) => (
              <li
                class:list={[
                  "pt-7 pr-6 max-xs:pr-0",
                  i > 0 &&
                    "border-l border-line pl-6 max-xs:border-l-0 max-xs:pl-0",
                ]}
              >
                <span class="font-mono text-caption tracking-[0.5px] text-brand">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-3 font-mono text-tag tracking-[1.6px] text-ink uppercase">
                  {step.label}
                </h3>
                <p class="mt-3 mb-8 text-detail leading-relaxed text-muted">
                  {step.body}
                </p>
              </li>
            ))
          }
        </ol>
      </article>
    </RailSections>
  </Section>

  <PageCTA />
</Base>
