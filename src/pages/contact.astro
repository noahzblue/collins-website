---
/**
 * /contact — three numbers, two locations, real hours, and the quote form.
 *
 * Deliberately NO PageBanner. Every other new page opens on a full-bleed
 * photo; opening straight into content signals "this is the functional one"
 * and puts the form higher up the page. It should feel like a desk, not a
 * brochure.
 *
 * **The form here is the same component the dialog mounts** — one form, two
 * mounts (docs/site-expansion/14 §2). A form that only exists behind a click
 * is invisible to search and to anyone who arrived specifically to enquire,
 * and this page is where that person lands.
 *
 * The consequence the doc named has landed with it: `.q-field` is gone. Two
 * visually different forms on one site is worse than either style, so the
 * boxed 14px fields retire in favour of the underline ones every other part of
 * the form uses (§14.3a).
 *
 * **One width, and one skeleton, for the whole page.** Every band here sits in
 * `wrap-wide`, because the form does and a page that changes its column width
 * halfway down reads as two pages stapled together. Widening the rest was not
 * enough on its own: a 1600px band with an 820px headline in the top-left of
 * it is emptier than the narrow column it replaced. So each band is now built
 * the way the form already is above 1240px — **the thing itself on the left, a
 * hairline rail of supporting facts on the right** (`.mast` + `.rail` below).
 * The masthead runs the headline against the ways in; the closing band runs
 * the two addresses against the licence details. The form between them is
 * untouched and needs no special case, because it was the pattern.
 *
 * That also retires the old full-width contact strip. The three ways in used
 * to be a band across the top that everything else had to step over; beside
 * the headline they are read at the same moment as it, and the form starts
 * higher up the page than it did.
 *
 * Almost no motion, on purpose: one reveal on the header and that is it. A
 * contact page that animates while you fill it in is a contact page that
 * annoys people.
 */
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import QuoteForm from "@/components/quote/QuoteForm.astro";
import { site, directionsHref } from "@/config/site";
import { contactPage } from "@/data/content";
import { DIALOG } from "@/lib/quote/options";

const { office, yard } = site.places;

/** The licence facts, as rail rows. Data, not markup — the closing rail and
 *  the masthead rail are the same three elements with different contents. */
const registration = [
  { label: "Registered name", value: site.legalName },
  { label: "Trade register", value: site.register },
  { label: "Licensed by", value: site.licensingAuthority },
  { label: "Working hours", value: site.hoursLong },
];
---

<Base title={contactPage.seoTitle} description={contactPage.seoDescription}>
  {
    /* 1. The masthead — what the page says, and the ways in, at one glance.
      The breadcrumb sits on `.rule-brand`: the rule that marks the top of a
      block which ASKS something. The form's own head draws it too, so the
      page opens and re-opens on the same device. */
  }
  <header class="pt-[150px] pb-[76px] max-mob:pt-[120px] max-mob:pb-[52px]">
    <div class="wrap wrap-wide">
      <div class="rule-brand pb-5">
        <Breadcrumb trail={[{ label: "Home", href: "/" }]} current="Contact" />
      </div>

      <div class="mast mt-14 max-mob:mt-10">
        <div>
          <Eyebrow class="mb-[16px]">{contactPage.eyebrow}</Eyebrow>
          <h1
            class="max-w-[21ch] text-h1 leading-[1.05] tracking-[-0.025em]"
            data-reveal
          >
            {contactPage.title}
          </h1>
          <p class="mt-6 max-w-[60ch] text-intro leading-relaxed text-muted">
            {contactPage.body}{" "}
            <strong class="font-normal text-ink">{site.quotePromise}</strong>
          </p>
        </div>

        {
          /* The rail. Two of these three are faster than any form, and
            pretending otherwise would be dishonest — so they are read
            alongside the headline rather than after it.

            WhatsApp is the enquiry channel in the UAE plant trade, not a
            fallback, but it earns that by leading the rail rather than by
            being a green block. The solid `bg-whatsapp` fill was the one
            surface on the site painted in a third party's brand colour and
            it read as an ad dropped into the page; the token is still
            correct for the floating bubble in `layout/FloatingButtons`. */
        }
        <aside class="rail" aria-label="Direct lines">
          <a
            href={site.whatsapp.href}
            target="_blank"
            rel="noopener"
            class="rail-row group flex items-start gap-3"
          >
            <Icon
              name="whatsapp"
              size={17}
              class="mt-[3px] shrink-0 text-brand transition-transform duration-200 group-hover:-translate-y-[1px]"
            />
            <span class="min-w-0">
              <span class="rail-label">WhatsApp</span>
              <span
                class="rail-value flex items-center gap-[6px] font-medium transition-colors group-hover:text-brand"
              >
                Message the yard
                <Icon
                  name="arrow-up-right"
                  size={14}
                  class="shrink-0 text-faint transition-transform duration-200 group-hover:translate-x-[2px] group-hover:-translate-y-[2px] group-hover:text-brand"
                />
              </span>
            </span>
          </a>

          <!-- Three separate tel: rows, not a dropdown. -->
          <div class="rail-row flex items-start gap-3">
            <Icon name="phone" size={17} class="mt-[3px] shrink-0 text-brand" />
            <span class="min-w-0">
              <span class="rail-label">Call us</span>
              <ul class="mt-[6px] flex flex-col">
                {
                  site.phones.map((phone) => (
                    <li>
                      <a href={phone.href} class="rail-num">
                        {phone.display}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </span>
          </div>

          <div class="rail-row flex items-start gap-3">
            <Icon name="mail" size={17} class="mt-[3px] shrink-0 text-brand" />
            <span class="min-w-0">
              <span class="rail-label">Email</span>
              <a
                href={`mailto:${site.email}`}
                class="rail-value block truncate font-medium transition-colors hover:text-brand"
              >
                {site.email}
              </a>
            </span>
          </div>

          <div class="rail-row flex items-start gap-3">
            <Icon name="clock" size={17} class="mt-[3px] shrink-0 text-brand" />
            <span class="min-w-0">
              <span class="rail-label">Working hours</span>
              <span class="rail-value font-medium">{site.hoursLong}</span>
            </span>
          </div>
        </aside>
      </div>
    </div>
  </header>

  <!-- 2. The form. `id` is what every quote CTA on this page scrolls to
       instead of opening the dialog (docs 14 §2).

       The wide band, not the 1200px text column: the form is a four-column
       picker and a two-column rating table beside a 340px summary rail, and
       inside `.wrap` the steps column was left with about 750px of that. On
       `wrap-wide` the steps get more room than a full-width page section
       would give them, and the rail stops eating the difference. -->
  <Section id="quote" class="pt-[72px] max-mob:pt-[48px]">
    <div class="wrap wrap-wide">
      <div class="q-inline-head rule-brand">
        <h2 class="q-inline-title">{DIALOG.title}</h2>
      </div>
      <div class="border-b border-line-strong">
        <QuoteForm instance="q-inline" variant="inline" />
      </div>
    </div>
  </Section>

  {
    /* 3. Two locations doing two different jobs, against the licence.
      The same `.mast` split as the header: the places are the content, the
      registration is marginalia and is finally shaped like it — it used to
      be a tracked mono strip stranded under the cards, which is where copy
      goes when a layout has run out of places to put it. */
  }
  <Section tone="gray">
    <div class="wrap wrap-wide">
      <div class="mast">
        <div>
          <h2 class="mb-10 text-h3 leading-[1.12] max-mob:mb-7">
            Where to find us
          </h2>
          <div class="grid grid-cols-2 gap-6 max-cmp:grid-cols-1">
            {
              [office, yard].map((place) => (
                <div class="card flex flex-col p-9 max-xs:p-7">
                  <span class="font-mono text-micro tracking-[1.6px] text-brand uppercase">
                    {place.tag}
                  </span>
                  <h3 class="mt-3 text-h3 leading-[1.1]">{place.city}</h3>
                  <p class="mt-3 mb-0 text-lead text-body">{place.address}</p>
                  <p class="mt-2 mb-0 text-base text-muted">{place.role}</p>
                  <div class="mt-auto flex flex-wrap gap-3 pt-7">
                    <Button
                      variant="outline"
                      href={directionsHref(place)}
                      target="_blank"
                      rel="noopener"
                      class="press"
                    >
                      <Icon name="pin" size={16} />
                      Directions
                    </Button>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <aside class="rail" aria-label="Registration">
          {
            registration.map((row) => (
              <div class="rail-row">
                <span class="rail-label">{row.label}</span>
                <span class="rail-value">{row.value}</span>
              </div>
            ))
          }
        </aside>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* ── The page's one layout ──────────────────────────────────────
     The thing itself on the left, a hairline rail of supporting facts on
     the right. It is not a new arrangement — it is the shape the quote
     form between these two bands already has above 1240px, where its
     steps run against its summary rail. Reusing it is what lets the whole
     page sit in `wrap-wide` without the wide band reading as empty: at
     1600px a headline alone leaves half the row unused, and the three
     ways in are exactly the thing worth putting there.

     The rail is a fixed width rather than a fraction so it stays a rail.
     As a fraction it would grow into a second column of content at the
     top of the range, and the left side would lose the width this whole
     change was made to give it. */
  .mast {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    column-gap: 80px;
    align-items: start;
  }
  @media (max-width: 1240px) {
    .mast {
      grid-template-columns: minmax(0, 1fr) 300px;
      column-gap: 48px;
    }
  }
  /* `nav` is where every other two-column split on the site collapses, and
     the rail has to stop being a margin before the page gets narrow enough
     for 300px of it to squeeze the headline. */
  @media (max-width: 980px) {
    .mast {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }
  }

  /* A margin, drawn as one: a hairline down its inner edge and a hairline
     between each fact. No surface and no card — `.card` is for a panel you
     are meant to look at, and this is a column you are meant to scan. */
  .rail {
    border-left: 1px solid var(--color-line);
    padding-left: 40px;
  }
  @media (max-width: 1240px) {
    .rail {
      padding-left: 28px;
    }
  }
  /* Stacked, the separator turns with the layout — the rule that was down
     the rail's inner edge becomes the rule above it. */
  @media (max-width: 980px) {
    .rail {
      border-top: 1px solid var(--color-line-strong);
      border-left: 0;
      padding-left: 0;
    }
  }

  .rail-row {
    padding-block: 20px;
  }
  .rail-row + .rail-row {
    border-top: 1px solid var(--color-line);
  }
  /* Beside the headline the first row starts flush, so the rail's top edge
     lines up with the eyebrow rather than hanging below it. Stacked there
     is a rule above it to clear, so the padding comes back. */
  .rail-row:first-child {
    padding-top: 0;
  }
  @media (max-width: 980px) {
    .rail-row:first-child {
      padding-top: 20px;
    }
  }

  .rail-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .rail-value {
    display: block;
    margin-top: 8px;
    font-size: var(--text-cell);
    line-height: 1.5;
    color: var(--color-ink);
  }
  .rail-num {
    display: block;
    padding-block: 5px;
    font-family: var(--font-mono);
    font-size: var(--text-cell);
    color: var(--color-ink);
    transition: color 200ms var(--ease-out-expo);
  }
  .rail-num:hover {
    color: var(--color-brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-num {
      transition-duration: 1ms;
    }
  }

  /* `.rule-brand` (global.css) is the same device the dialog's head draws, so
     the inline mount and the modal read as one thing seen twice rather than
     two arrangements of the same fields. Nothing is inset here — there is no
     panel, so the rule starts where the title does. */
  .q-inline-head {
    padding-bottom: 20px;
  }
  .q-inline-title {
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
</style>

<script>
  import { untilPageSwap } from "@/scripts/untilPageSwap";
  import { initQuoteForm } from "@/scripts/quote/form";

  /**
   * The inline mount. Same call the dialog makes — the only difference is
   * which element it is handed (docs/site-expansion/14 §2).
   *
   * The dialog is still mounted from `Base` on this page, so two instances of
   * this form coexist in one document. That is the case every generated id and
   * every root-scoped query exists for, and this is the page that proves it.
   */
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>(
      "[data-quote-root]:not(dialog [data-quote-root])",
    );
    if (!root) return;
    const quote = initQuoteForm(root, { signal: untilPageSwap() });

    /**
     * What the arriving link already answered.
     *
     * The homepage's closing band asks buy-or-hire and then sends people
     * here rather than opening the dialog, so the answer arrives as `?mode=`
     * — the same parameter name the dialog puts on the URL when it opens
     * (`scripts/quote/dialog.ts`). Without this the answers would land on one
     * blank form and the question would have been for nothing.
     *
     * `prefill` drops anything it does not recognise in silence, so a hand-
     * edited parameter is a no-op rather than an error state (docs 14 §9).
     *
     * Only `mode`. The other two parameters the dialog understands — the
     * category and its rating — are never sent here: a link that knows the
     * machine comes from a page that keeps you on it, and the dialog answers
     * it in place. Reading them would also mean racing the dialog's own
     * `?quote=` handling, which strips the URL as it scrolls to this form.
     */
    const mode = new URL(location.href).searchParams.get("mode");
    if (mode) quote?.prefill({ mode });
  });
</script>
