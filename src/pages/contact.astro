---
/**
 * /contact — three numbers, two locations, real hours, and the quote form.
 *
 * Deliberately NO PageBanner. Every other new page opens on a full-bleed
 * photo; opening straight into content signals "this is the functional one"
 * and puts the form higher up the page. It should feel like a desk, not a
 * brochure.
 *
 * **The form here is the same component the dialog mounts** — one form, two
 * mounts (docs/site-expansion/14 §2). A form that only exists behind a click
 * is invisible to search and to anyone who arrived specifically to enquire,
 * and this page is where that person lands.
 *
 * The consequence the doc named has landed with it: `.q-field` is gone. Two
 * visually different forms on one site is worse than either style, so the
 * boxed 14px fields retire in favour of the underline ones every other part of
 * the form uses (§14.3a).
 *
 * The contact methods moved from a sticky left column to a band across the
 * top, because the form now needs the full width — below 1240px its summary
 * flattens into a bar, and above it the rail is a real second column that
 * cannot share the page with a sidebar.
 *
 * Almost no motion, on purpose: one reveal on the header and that is it. A
 * contact page that animates while you fill it in is a contact page that
 * annoys people.
 */
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import QuoteForm from "@/components/quote/QuoteForm.astro";
import { site, directionsHref } from "@/config/site";
import { contactPage } from "@/data/content";
import { DIALOG } from "@/lib/quote/options";

const { office, yard } = site.places;
---

<Base title={contactPage.seoTitle} description={contactPage.seoDescription}>
  <!-- 1. Header — straight into content -->
  <header class="pt-[150px] pb-[48px] max-mob:pt-[120px] max-mob:pb-[36px]">
    <div class="wrap">
      <Breadcrumb
        trail={[{ label: "Home", href: "/" }]}
        current="Contact"
        class="mb-5"
      />
      <Eyebrow class="mb-[16px]">{contactPage.eyebrow}</Eyebrow>
      <h1
        class="max-w-[820px] text-h1 leading-[1.05] tracking-[-0.025em]"
        data-reveal
      >
        {contactPage.title}
      </h1>
      <p class="mt-6 max-w-[620px] text-intro leading-relaxed text-muted">
        {contactPage.body}
        <strong class="font-normal text-ink">{site.quotePromise}</strong>
      </p>
    </div>
  </header>

  <!-- 2. The three ways in, before the form — because two of them are faster
       than any form and pretending otherwise would be dishonest. -->
  <div class="wrap">
    <div class="grid grid-cols-3 items-stretch gap-4 max-nav:grid-cols-1">
      <!-- WhatsApp gets the most visual weight: in the UAE plant trade it is
           the enquiry channel, not a fallback. -->
      <a
        href={site.whatsapp.href}
        target="_blank"
        rel="noopener"
        class="press flex items-center gap-4 rounded-md bg-whatsapp p-5 text-white transition-transform duration-200 hover:-translate-y-[2px]"
      >
        <span
          class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-sm bg-white/20"
        >
          <Icon name="whatsapp" size={24} />
        </span>
        <span>
          <span class="block text-caption text-white/75">WhatsApp</span>
          <span class="block text-subhead font-medium">Message the yard</span>
        </span>
        <Icon name="arrow-up-right" size={18} class="ml-auto" />
      </a>

      <!-- Three separate tel: rows, not a dropdown. -->
      <div class="rounded-md border border-line bg-white p-5">
        <span class="flex items-center gap-3">
          <span
            class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-sm bg-brand-tint text-brand"
          >
            <Icon name="phone" size={18} />
          </span>
          <span class="text-caption text-faint">Call us</span>
        </span>
        <ul class="mt-3 flex flex-col">
          {
            site.phones.map((phone) => (
              <li>
                <a
                  href={phone.href}
                  class="block border-t border-line py-[9px] font-mono text-cell text-ink transition-colors hover:text-brand"
                >
                  {phone.display}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="flex flex-col gap-4 rounded-md border border-line bg-white p-5"
      >
        {
          [
            {
              icon: "mail" as const,
              label: "Email",
              value: site.email,
              href: `mailto:${site.email}`,
            },
            {
              icon: "clock" as const,
              label: "Working hours",
              value: site.hoursLong,
              href: undefined,
            },
          ].map((row) => (
            <div class="flex items-center gap-4">
              <span class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-sm bg-brand-tint text-brand">
                <Icon name={row.icon} size={18} />
              </span>
              <span class="min-w-0">
                <span class="block text-caption text-faint">{row.label}</span>
                {row.href ? (
                  <a
                    href={row.href}
                    class="block truncate text-base font-medium text-ink transition-colors hover:text-brand"
                  >
                    {row.value}
                  </a>
                ) : (
                  <span class="block text-base font-medium text-ink">
                    {row.value}
                  </span>
                )}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- 3. The form. `id` is what every quote CTA on this page scrolls to
       instead of opening the dialog (docs 14 §2). -->
  <Section id="quote" class="pt-[72px] max-mob:pt-[48px]">
    <div class="wrap">
      <div class="q-inline-head">
        <h2 class="q-inline-title">{DIALOG.title}</h2>
      </div>
      <div class="border-b border-line-strong">
        <QuoteForm instance="q-inline" variant="inline" />
      </div>
    </div>
  </Section>

  <!-- 4. Two locations, doing two different jobs -->
  <Section tone="gray">
    <div class="wrap">
      <h2 class="mb-10 text-h3 leading-[1.12]">Where to find us</h2>
      <div class="grid grid-cols-2 gap-6 max-nav:grid-cols-1">
        {
          [office, yard].map((place) => (
            <div class="card flex flex-col p-9 max-xs:p-7">
              <span class="font-mono text-micro tracking-[1.6px] text-brand uppercase">
                {place.tag}
              </span>
              <h3 class="mt-3 text-h3 leading-[1.1]">{place.city}</h3>
              <p class="mt-3 mb-0 text-lead text-body">{place.address}</p>
              <p class="mt-2 mb-0 text-base text-muted">{place.role}</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <Button
                  variant="outline"
                  href={directionsHref(place)}
                  target="_blank"
                  rel="noopener"
                  class="press"
                >
                  <Icon name="pin" size={16} />
                  Directions
                </Button>
              </div>
            </div>
          ))
        }
      </div>

      <!-- 5. Hours + legal -->
      <div class="mt-12 border-t border-line-strong pt-8">
        <p
          class="mb-0 font-mono text-caption leading-[1.9] tracking-[1.3px] text-faint uppercase"
        >
          {site.hoursLong}<br />
          {site.legalName} · Register {site.register}<br />
          Licensed by the {site.licensingAuthority}
        </p>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* The same device the dialog's head draws: a rule that starts brand and
     stops, so the inline mount and the modal read as one thing seen twice
     rather than two arrangements of the same fields. */
  .q-inline-head {
    position: relative;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }
  .q-inline-head::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--color-brand) 0 88px,
      transparent 88px
    );
  }
  .q-inline-title {
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
</style>

<script>
  import { untilPageSwap } from "@/scripts/untilPageSwap";
  import { initQuoteForm } from "@/scripts/quote/form";

  /**
   * The inline mount. Same call the dialog makes — the only difference is
   * which element it is handed (docs/site-expansion/14 §2).
   *
   * The dialog is still mounted from `Base` on this page, so two instances of
   * this form coexist in one document. That is the case every generated id and
   * every root-scoped query exists for, and this is the page that proves it.
   */
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>(
      "[data-quote-root]:not(dialog [data-quote-root])",
    );
    if (root) initQuoteForm(root, { signal: untilPageSwap() });
  });
</script>
