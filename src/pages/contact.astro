---
/**
 * /contact — three numbers, two locations, real hours, and the quote form.
 *
 * Deliberately NO PageBanner. Every other new page opens on a full-bleed
 * photo; opening straight into content signals "this is the functional one"
 * and puts the form higher up the page. It should feel like a desk, not a
 * brochure.
 *
 * **The form here is the same component the dialog mounts** — one form, two
 * mounts (docs/site-expansion/14 §2). A form that only exists behind a click
 * is invisible to search and to anyone who arrived specifically to enquire,
 * and this page is where that person lands.
 *
 * The consequence the doc named has landed with it: `.q-field` is gone. Two
 * visually different forms on one site is worse than either style, so the
 * boxed 14px fields retire in favour of the underline ones every other part of
 * the form uses (§14.3a).
 *
 * The contact methods moved from a sticky left column to a band across the
 * top, because the form now needs the full width — below 1240px its summary
 * flattens into a bar, and above it the rail is a real second column that
 * cannot share the page with a sidebar.
 *
 * Almost no motion, on purpose: one reveal on the header and that is it. A
 * contact page that animates while you fill it in is a contact page that
 * annoys people.
 */
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import QuoteForm from "@/components/quote/QuoteForm.astro";
import { site, directionsHref } from "@/config/site";
import { contactPage } from "@/data/content";
import { DIALOG } from "@/lib/quote/options";

const { office, yard } = site.places;
---

<Base title={contactPage.seoTitle} description={contactPage.seoDescription}>
  <!-- 1. Header — straight into content -->
  <header class="pt-[150px] pb-[48px] max-mob:pt-[120px] max-mob:pb-[36px]">
    <div class="wrap">
      <Breadcrumb
        trail={[{ label: "Home", href: "/" }]}
        current="Contact"
        class="mb-5"
      />
      <Eyebrow class="mb-[16px]">{contactPage.eyebrow}</Eyebrow>
      <h1
        class="max-w-[820px] text-h1 leading-[1.05] tracking-[-0.025em]"
        data-reveal
      >
        {contactPage.title}
      </h1>
      <p class="mt-6 max-w-[620px] text-intro leading-relaxed text-muted">
        {contactPage.body}{" "}
        <strong class="font-normal text-ink">{site.quotePromise}</strong>
      </p>
    </div>
  </header>

  <!-- 2. The three ways in, before the form — because two of them are faster
       than any form and pretending otherwise would be dishonest. -->
  <div class="wrap">
    {
      /* A hairline rail, not three cards. Three bordered boxes sitting on
        white made the block read as a widget bolted above the form; the rail
        is the same structure the mobilisation row on /yard is built from, so
        it reads as part of the page instead. It is also about a third of the
        height, which is what matters here — everything below it is the form,
        and this block's job is to be passed, not admired.

        `items-start`, because the three columns carry different numbers of
        rows: stretching them would put the hairlines back to work holding up
        empty space, which is the thing the cards were doing wrong. */
    }
    <div
      class="grid grid-cols-3 items-start border-t border-line-strong max-nav:grid-cols-1 max-nav:border-t-0"
    >
      {
        /* WhatsApp is the enquiry channel in the UAE plant trade, not a
          fallback — but it earns that by leading the rail, not by being a
          green block. The solid `bg-whatsapp` fill was the one surface on the
          site painted in a third party's brand colour, and it read as an ad
          dropped into the page. The token still exists and is still correct
          for the floating bubble in `layout/FloatingButtons`. */
      }
      <a
        href={site.whatsapp.href}
        target="_blank"
        rel="noopener"
        class="group flex items-start gap-3 pt-7 pr-6 pb-7 transition-colors max-nav:border-t max-nav:border-line max-nav:pr-0"
      >
        <Icon
          name="whatsapp"
          size={17}
          class="mt-[3px] shrink-0 text-brand transition-transform duration-200 group-hover:-translate-y-[1px]"
        />
        <span class="min-w-0">
          <span
            class="block font-mono text-tag tracking-[1.6px] text-faint uppercase"
          >
            WhatsApp
          </span>
          <span
            class="mt-2 flex items-center gap-[6px] text-cell font-medium text-ink transition-colors group-hover:text-brand"
          >
            Message the yard
            <Icon
              name="arrow-up-right"
              size={14}
              class="shrink-0 text-faint transition-transform duration-200 group-hover:translate-x-[2px] group-hover:-translate-y-[2px] group-hover:text-brand"
            />
          </span>
        </span>
      </a>

      <!-- Three separate tel: rows, not a dropdown. -->
      <div
        class="flex items-start gap-3 border-l border-line pt-7 pr-6 pb-7 pl-6 max-nav:border-t max-nav:border-l-0 max-nav:pr-0 max-nav:pl-0"
      >
        <Icon name="phone" size={17} class="mt-[3px] shrink-0 text-brand" />
        <span class="min-w-0">
          <span
            class="block font-mono text-tag tracking-[1.6px] text-faint uppercase"
          >
            Call us
          </span>
          <ul class="mt-1 flex flex-col">
            {
              site.phones.map((phone) => (
                <li>
                  <a
                    href={phone.href}
                    class="block py-[5px] font-mono text-cell text-ink transition-colors hover:text-brand"
                  >
                    {phone.display}
                  </a>
                </li>
              ))
            }
          </ul>
        </span>
      </div>

      <div
        class="flex flex-col gap-6 border-l border-line pt-7 pb-7 pl-6 max-nav:gap-5 max-nav:border-t max-nav:border-l-0 max-nav:pl-0"
      >
        {
          [
            {
              icon: "mail" as const,
              label: "Email",
              value: site.email,
              href: `mailto:${site.email}`,
            },
            {
              icon: "clock" as const,
              label: "Working hours",
              value: site.hoursLong,
              href: undefined,
            },
          ].map((row) => (
            <div class="flex items-start gap-3">
              <Icon
                name={row.icon}
                size={17}
                class="mt-[3px] shrink-0 text-brand"
              />
              <span class="min-w-0">
                <span class="block font-mono text-tag tracking-[1.6px] text-faint uppercase">
                  {row.label}
                </span>
                {row.href ? (
                  <a
                    href={row.href}
                    class="mt-2 block truncate text-cell font-medium text-ink transition-colors hover:text-brand"
                  >
                    {row.value}
                  </a>
                ) : (
                  <span class="mt-2 block text-cell font-medium text-ink">
                    {row.value}
                  </span>
                )}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- 3. The form. `id` is what every quote CTA on this page scrolls to
       instead of opening the dialog (docs 14 §2).

       The wide band, not the 1200px text column: the form is a four-column
       picker and a two-column rating table beside a 340px summary rail, and
       inside `.wrap` the steps column was left with about 750px of that. On
       `wrap-wide` the steps get more room than a full-width page section
       would give them, and the rail stops eating the difference. -->
  <Section id="quote" class="pt-[72px] max-mob:pt-[48px]">
    <div class="wrap wrap-wide">
      <div class="q-inline-head rule-brand">
        <h2 class="q-inline-title">{DIALOG.title}</h2>
      </div>
      <div class="border-b border-line-strong">
        <QuoteForm instance="q-inline" variant="inline" />
      </div>
    </div>
  </Section>

  <!-- 4. Two locations, doing two different jobs -->
  <Section tone="gray">
    <div class="wrap">
      <h2 class="mb-10 text-h3 leading-[1.12]">Where to find us</h2>
      <div class="grid grid-cols-2 gap-6 max-nav:grid-cols-1">
        {
          [office, yard].map((place) => (
            <div class="card flex flex-col p-9 max-xs:p-7">
              <span class="font-mono text-micro tracking-[1.6px] text-brand uppercase">
                {place.tag}
              </span>
              <h3 class="mt-3 text-h3 leading-[1.1]">{place.city}</h3>
              <p class="mt-3 mb-0 text-lead text-body">{place.address}</p>
              <p class="mt-2 mb-0 text-base text-muted">{place.role}</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <Button
                  variant="outline"
                  href={directionsHref(place)}
                  target="_blank"
                  rel="noopener"
                  class="press"
                >
                  <Icon name="pin" size={16} />
                  Directions
                </Button>
              </div>
            </div>
          ))
        }
      </div>

      <!-- 5. Hours + legal -->
      <div class="mt-12 border-t border-line-strong pt-8">
        <p
          class="mb-0 font-mono text-caption leading-[1.9] tracking-[1.3px] text-faint uppercase"
        >
          {site.hoursLong}<br />
          {site.legalName} · Register {site.register}<br />
          Licensed by the {site.licensingAuthority}
        </p>
      </div>
    </div>
  </Section>
</Base>

<style>
  /* `.rule-brand` (global.css) is the same device the dialog's head draws, so
     the inline mount and the modal read as one thing seen twice rather than
     two arrangements of the same fields. Nothing is inset here — there is no
     panel, so the rule starts where the title does. */
  .q-inline-head {
    padding-bottom: 20px;
  }
  .q-inline-title {
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
</style>

<script>
  import { untilPageSwap } from "@/scripts/untilPageSwap";
  import { initQuoteForm } from "@/scripts/quote/form";

  /**
   * The inline mount. Same call the dialog makes — the only difference is
   * which element it is handed (docs/site-expansion/14 §2).
   *
   * The dialog is still mounted from `Base` on this page, so two instances of
   * this form coexist in one document. That is the case every generated id and
   * every root-scoped query exists for, and this is the page that proves it.
   */
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>(
      "[data-quote-root]:not(dialog [data-quote-root])",
    );
    if (!root) return;
    const quote = initQuoteForm(root, { signal: untilPageSwap() });

    /**
     * What the arriving link already answered.
     *
     * The homepage's closing band asks buy-or-hire and then sends people
     * here rather than opening the dialog, so the answer arrives as `?mode=`
     * — the same parameter name the dialog puts on the URL when it opens
     * (`scripts/quote/dialog.ts`). Without this the three answers would land
     * on one blank form and the question would have been for nothing.
     *
     * `prefill` drops anything it does not recognise in silence, so a hand-
     * edited parameter is a no-op rather than an error state (docs 14 §9).
     *
     * Only `mode`. The other two parameters the dialog understands — the
     * category and its rating — are never sent here: a link that knows the
     * machine comes from a page that keeps you on it, and the dialog answers
     * it in place. Reading them would also mean racing the dialog's own
     * `?quote=` handling, which strips the URL as it scrolls to this form.
     */
    const mode = new URL(location.href).searchParams.get("mode");
    if (mode) quote?.prefill({ mode });
  });
</script>
