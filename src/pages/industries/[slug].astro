---
/**
 * Per-industry page — banner photo, how we help, commonly supplied
 * equipment and a quote CTA. Pages are generated from data/industries.ts.
 */
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import PageBanner from "@/components/ui/PageBanner.astro";
import { industries } from "@/data/industries";
import { site } from "@/config/site";

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
---

<Base
  title={`${industry.name} | ${site.name}`}
  description={`${industry.tagline} Equipment sales & rental for ${industry.name.toLowerCase()} across the UAE.`}
>
  <PageBanner
    image={industry.image}
    trail={[{ label: "Industries", href: "/#industries" }]}
    current={industry.name}
    title={industry.name}
  >
    <p class="mt-4 max-w-[560px] text-intro leading-relaxed text-white/80">
      {industry.tagline}
    </p>
  </PageBanner>

  <Section>
    <div class="wrap">
      <div
        class="grid grid-cols-[1.15fr_0.85fr] items-start gap-16 max-nav:grid-cols-1 max-nav:gap-10"
      >
        <div>
          <h2 class="mb-6 text-h3 leading-[1.12]">
            How we support {industry.name.toLowerCase()} teams
          </h2>
          <p class="max-w-[600px] text-lead-lg leading-relaxed text-body">
            {industry.body}
          </p>
        </div>

        <div class="card p-8 max-xs:p-6">
          <h3 class="mb-5 text-[19px] font-semibold">Commonly supplied</h3>
          <ul class="mb-8 flex flex-col gap-[12px]">
            {
              industry.equipment.map((item) => (
                <li>
                  <a
                    href="/#equipment"
                    class="flex items-center gap-3 text-base text-body transition-colors hover:text-brand"
                  >
                    <Icon name="check" size={16} class="shrink-0 text-brand" />
                    {item}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="flex flex-wrap gap-3">
            <Button variant="primary" href="/#contact">Request a quote</Button>
            <Button variant="outline" href={site.whatsapp.href}>
              WhatsApp us
            </Button>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Base>
