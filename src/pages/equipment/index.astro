---
/**
 * Equipment hub — /equipment.
 *
 * Level 1 of the IA: every category, grouped by family, each card linking to
 * its own page. Pulls straight from the `equipment` collection, so adding a
 * category to categories.json puts it here, in the right group, in order.
 */
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import Section from "../../components/ui/Section.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";
import CategoryCard from "../../components/equipment/CategoryCard.astro";
import { FAMILIES, FAMILY_LINE, familyId } from "../../lib/equipment";
import { equipmentHub } from "../../data/content";
import { site } from "../../config/site";

const all = (await getCollection("equipment")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

/* Families keep their canonical order rather than the order they happen to
   appear in the JSON. An empty family renders nothing at all. */
const byFamily = FAMILIES.map((family) => ({
  family,
  items: all.filter((category) => category.data.family === family),
})).filter((group) => group.items.length > 0);
---

<Base title={equipmentHub.seoTitle} description={equipmentHub.seoDescription}>
  <!-- Page header -->
  <header class="pt-[150px] pb-[64px] max-mob:pt-[120px] max-mob:pb-[48px]">
    <div class="wrap">
      <nav class="text-[13px] text-faint mb-5" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-brand">Home</a>
        <span class="mx-2">/</span>
        <span class="text-muted">Equipment</span>
      </nav>

      <Eyebrow class="mb-[16px]">{equipmentHub.eyebrow}</Eyebrow>
      <h1
        class="text-[clamp(34px,5vw,56px)] leading-[1.05] tracking-[-0.025em]"
        set:html={equipmentHub.title.join("<br>")}
      />
      <p class="text-[17px] leading-relaxed text-muted max-w-[620px] mt-6">
        {equipmentHub.intro}
      </p>

      <!-- Jump to a family -->
      <nav class="flex flex-wrap gap-[10px] mt-9" aria-label="Equipment families">
        {
          byFamily.map(({ family, items }) => (
            <a
              href={`#${familyId(family)}`}
              class="inline-flex items-center gap-[8px] rounded-full border border-line-strong px-[15px] py-[8px] text-[13.5px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
            >
              {family}
              <span class="text-faint">{items.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <!-- The twelve, grouped by family -->
  <Section class="pt-0">
    <div class="wrap flex flex-col gap-[72px] max-mob:gap-[52px]">
      {
        byFamily.map(({ family, items }) => (
          <section aria-labelledby={familyId(family)}>
            <div class="pb-5 mb-8 border-b border-line">
              <div>
                <h2
                  id={familyId(family)}
                  class="text-[clamp(22px,2.4vw,28px)] leading-[1.1] scroll-mt-[110px]"
                >
                  {family}
                </h2>
                <p class="text-[14.5px] text-muted mt-[6px]">
                  {FAMILY_LINE[family]}
                </p>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-5 max-nav:grid-cols-2 max-cmp:grid-cols-1">
              {items.map((category) => (
                <CategoryCard
                  category={category}
                  index={category.data.sortOrder}
                />
              ))}
            </div>
          </section>
        ))
      }

      <!-- Closing enquiry -->
      <div
        class="card flex justify-between items-center gap-8 p-9 flex-wrap max-xs:p-7"
      >
        <div>
          <h2 class="text-[22px] font-semibold mb-2">
            {equipmentHub.closing.title}
          </h2>
          <p class="text-[15px] leading-relaxed text-muted max-w-[520px]">
            {equipmentHub.closing.body}
          </p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <Button variant="primary" href="/#contact">Request a quote</Button>
          <Button
            variant="outline"
            href={site.whatsapp.href}
            target="_blank"
            rel="noopener"
          >
            WhatsApp us
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <Footer />
</Base>
