---
/**
 * Equipment hub — /equipment.
 *
 * Level 1 of the IA. Every category gets a full-width row rather than a card:
 * photo one side, pitch the other, sides alternating down the page. A sticky
 * rail keeps the twelve navigable. Pulls straight from the `equipment`
 * collection in `sortOrder`, so adding a category to categories.json puts it
 * here, numbered, in the rail.
 */
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Button from "@/components/ui/Button.astro";
import CategoryRow from "@/components/equipment/CategoryRow.astro";
import CategoryIndex from "@/components/equipment/CategoryIndex.astro";
import { equipmentHub } from "@/data/content";
import { site } from "@/config/site";

const all = (await getCollection("equipment")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
---

<Base title={equipmentHub.seoTitle} description={equipmentHub.seoDescription}>
  <!-- Page header -->
  <header class="pt-[150px] pb-[64px] max-mob:pt-[120px] max-mob:pb-[48px]">
    <div class="wrap">
      <Breadcrumb
        trail={[{ label: "Home", href: "/" }]}
        current="Equipment"
        class="mb-5"
      />

      <Eyebrow class="mb-[16px]">{equipmentHub.eyebrow}</Eyebrow>
      <h1
        class="text-h1 leading-[1.05] tracking-[-0.025em]"
        set:html={equipmentHub.title.join("<br>")}
      />
      <p class="mt-6 max-w-[620px] text-intro leading-relaxed text-muted">
        {equipmentHub.intro}
      </p>
    </div>
  </header>

  <!-- The twelve -->
  <Section class="pt-0">
    <div class="wrap">
      <div
        class="grid grid-cols-[180px_1fr] gap-[72px] max-nav:grid-cols-1 max-nav:gap-0"
      >
        <CategoryIndex categories={all} />

        <div class="flex flex-col">
          {
            all.map((category, i) => (
              <>
                {i > 0 && (
                  <hr class="my-[80px] border-0 border-t border-line max-mob:my-[56px]" />
                )}
                <CategoryRow category={category} flip={i % 2 === 1} />
              </>
            ))
          }
        </div>
      </div>

      <!-- Closing enquiry -->
      <div
        class="card mt-[96px] flex flex-wrap items-center justify-between gap-8 p-9 max-mob:mt-[64px] max-xs:p-7"
      >
        <div>
          <h2 class="mb-2 text-[22px]">
            {equipmentHub.closing.title}
          </h2>
          <p class="max-w-[520px] text-base leading-relaxed text-muted">
            {equipmentHub.closing.body}
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button variant="primary" href="/#contact">Request a quote</Button>
          <Button
            variant="outline"
            href={site.whatsapp.href}
            target="_blank"
            rel="noopener"
          >
            WhatsApp us
          </Button>
        </div>
      </div>
    </div>
  </Section>
</Base>
