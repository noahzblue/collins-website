---
/**
 * Equipment hub — /equipment.
 *
 * Level 1 of the IA. Every category gets a full-width row rather than a card:
 * photo one side, pitch the other, sides alternating down the page. A sticky
 * rail keeps the twelve navigable. Pulls straight from the `equipment`
 * collection, so adding a category to categories.json puts it here, numbered,
 * in the right family group in the rail.
 */
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import Section from "../../components/ui/Section.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";
import CategoryRow from "../../components/equipment/CategoryRow.astro";
import CategoryIndex from "../../components/equipment/CategoryIndex.astro";
import { FAMILIES } from "../../lib/equipment";
import { equipmentHub } from "../../data/content";
import { site } from "../../config/site";

const all = (await getCollection("equipment")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);

/* Rows run as one flat sequence so the left/right alternation is unbroken —
   families do the grouping in the rail instead. An empty family renders
   nothing at all. */
const byFamily = FAMILIES.map((family) => ({
  family,
  items: all.filter((category) => category.data.family === family),
})).filter((group) => group.items.length > 0);
---

<Base title={equipmentHub.seoTitle} description={equipmentHub.seoDescription}>
  <!-- Page header -->
  <header class="pt-[150px] pb-[64px] max-mob:pt-[120px] max-mob:pb-[48px]">
    <div class="wrap">
      <nav class="text-[13px] text-faint mb-5" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-brand">Home</a>
        <span class="mx-2">/</span>
        <span class="text-muted">Equipment</span>
      </nav>

      <Eyebrow class="mb-[16px]">{equipmentHub.eyebrow}</Eyebrow>
      <h1
        class="text-[clamp(34px,5vw,56px)] leading-[1.05] tracking-[-0.025em]"
        set:html={equipmentHub.title.join("<br>")}
      />
      <p class="text-[17px] leading-relaxed text-muted max-w-[620px] mt-6">
        {equipmentHub.intro}
      </p>

      <!-- Jump to a family. Targets the family's first category, since the rows
           below are a flat sequence with no group headings to land on. Mobile
           only — on desktop the sticky rail is the same affordance, and both at
           once puts two category lists in one viewport. -->
      <nav
        class="flex flex-wrap gap-[10px] mt-9 nav:hidden"
        aria-label="Equipment families"
      >
        {
          byFamily.map(({ family, items }) => (
            <a
              href={`#${items[0].id}`}
              class="inline-flex items-center gap-[8px] rounded-full border border-line-strong px-[15px] py-[8px] text-[13.5px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
            >
              {family}
              <span class="text-faint">{items.length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <!-- The twelve -->
  <Section class="pt-0">
    <div class="wrap">
      <div
        class="grid grid-cols-[180px_1fr] gap-[72px] max-nav:grid-cols-1 max-nav:gap-0"
      >
        <CategoryIndex groups={byFamily} />

        <div class="flex flex-col">
          {
            all.map((category, i) => (
              <>
                {i > 0 && (
                  <hr class="border-0 border-t border-line my-[80px] max-mob:my-[56px]" />
                )}
                <CategoryRow category={category} flip={i % 2 === 1} />
              </>
            ))
          }
        </div>
      </div>

      <!-- Closing enquiry -->
      <div
        class="card flex justify-between items-center gap-8 p-9 flex-wrap mt-[96px] max-mob:mt-[64px] max-xs:p-7"
      >
        <div>
          <h2 class="text-[22px] font-semibold mb-2">
            {equipmentHub.closing.title}
          </h2>
          <p class="text-[15px] leading-relaxed text-muted max-w-[520px]">
            {equipmentHub.closing.body}
          </p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <Button variant="primary" href="/#contact">Request a quote</Button>
          <Button
            variant="outline"
            href={site.whatsapp.href}
            target="_blank"
            rel="noopener"
          >
            WhatsApp us
          </Button>
        </div>
      </div>
    </div>
  </Section>

  <Footer />
</Base>
