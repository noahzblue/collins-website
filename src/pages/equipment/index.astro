---
/**
 * Equipment hub — /equipment.
 *
 * Level 1 of the IA. Every category gets a full-width row rather than a card:
 * photo one side, pitch the other, sides alternating down the page. A sticky
 * rail keeps the twelve navigable. Pulls straight from the `equipment`
 * collection in `sortOrder`, so adding a category to categories.json puts it
 * here, numbered, in the rail.
 */
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Button from "@/components/ui/Button.astro";
import CategoryRow from "@/components/equipment/CategoryRow.astro";
import RailSections from "@/components/ui/RailSections.astro";
import ClosingNote from "@/components/sections/ClosingNote.astro";
import { equipmentHub } from "@/data/content";
import { site } from "@/config/site";

const all = (await getCollection("equipment")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder,
);
---

<Base title={equipmentHub.seoTitle} description={equipmentHub.seoDescription}>
  <!-- Page header -->
  <header class="pt-[150px] pb-[64px] max-mob:pt-[120px] max-mob:pb-[48px]">
    <div class="wrap">
      <Breadcrumb
        trail={[{ label: "Home", href: "/" }]}
        current="Equipment"
        class="mb-5"
      />

      <Eyebrow class="mb-[16px]">{equipmentHub.eyebrow}</Eyebrow>
      <h1
        class="text-h1 leading-[1.05] tracking-[-0.025em]"
        set:html={equipmentHub.title.join("<br>")}
      />
      <p class="mt-6 max-w-[620px] text-intro leading-relaxed text-muted">
        {equipmentHub.intro}
      </p>
    </div>
  </header>

  <!-- The twelve -->
  <Section class="pt-0">
    <RailSections
      items={all.map((c) => ({ id: c.id, label: c.data.name }))}
      ariaLabel="Equipment categories"
    >
      {
        all.map((category, i) => (
          <>
            {i > 0 && (
              <hr class="my-[80px] border-0 border-t border-line max-mob:my-[56px]" />
            )}
            <CategoryRow category={category} flip={i % 2 === 1} />
          </>
        ))
      }
    </RailSections>

    {
      /* Closing enquiry. This is the only CTA the hub has — there is no
        `PageCTA` under it — so it keeps real buttons rather than the band's
        default arrow link. */
    }
    <div class="wrap">
      <ClosingNote
        title={equipmentHub.closing.title}
        body={equipmentHub.closing.body}
        class="mt-[96px] max-mob:mt-[64px]"
      >
        <Fragment slot="actions">
          <Button
            variant="primary"
            href="/contact"
            data-quote-open
            class="press"
          >
            Request a quote
          </Button>
          <Button
            variant="outline"
            href={site.whatsapp.href}
            target="_blank"
            rel="noopener"
            class="press"
          >
            WhatsApp us
          </Button>
        </Fragment>
      </ClosingNote>
    </div>
  </Section>
</Base>
