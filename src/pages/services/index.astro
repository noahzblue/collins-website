---
/**
 * /services — the six capabilities, replacing the /#services anchor.
 *
 * This was the biggest content gap on the site: `services.ts` shipped three
 * items, two real revenue lines (transport & haulage, maintenance & spares)
 * appeared nowhere, and "equipment sales" — the stated core of the business —
 * was folded into "general trading".
 *
 * Five beats: banner, the follower list, the six blocks, the cross-sell back
 * to the catalogue, the shared closer.
 *
 * The blocks carry no `scroll-mt`: `scroll-padding-top` on <html> is the one
 * place the header offset lives, and Lenis reads it too (scripts/scroll.ts).
 */
import Base from "@/layouts/Base.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import RailSections from "@/components/ui/RailSections.astro";
import AlternatingRow from "@/components/ui/AlternatingRow.astro";
import FollowerList from "@/components/ui/FollowerList.astro";
import ClosingNote from "@/components/sections/ClosingNote.astro";
import PageCTA from "@/components/sections/PageCTA.astro";
import { services } from "@/data/services";
import { servicesSection } from "@/data/content";
import { site } from "@/config/site";

/** Nested template literals confuse the compiler's frontmatter scan — build
 *  the message first, then the URL. */
const enquire = (title: string) => {
  const text = `Hi Collins, I'd like to talk about ${title.toLowerCase()}.`;
  return `${site.whatsapp.href}?text=${encodeURIComponent(text)}`;
};
---

<Base
  title={servicesSection.seoTitle}
  description={servicesSection.seoDescription}
>
  <PageHeader
    image="/images/service-logistics.jpg"
    trail={[{ label: "Home", href: "/" }]}
    current="Services"
    title="Services"
    intro={servicesSection.intro}
  />

  <!-- Beat 2 — the six at a glance -->
  <Section class="pb-[80px] max-mob:pb-[56px]">
    <div class="wrap">
      <FollowerList
        items={services.map((s) => ({
          label: s.title,
          blurb: s.lead,
          image: s.image,
          href: `#${s.slug}`,
          stat: s.stat,
        }))}
        ariaLabel="Services"
      />
    </div>
  </Section>

  <!-- Beat 3 — the six blocks, sides alternating, siblings of /equipment's rows -->
  <Section tone="gray" class="pt-0">
    <RailSections
      items={services.map((s) => ({ id: s.slug, label: s.title }))}
      ariaLabel="Services"
      class="pt-[110px] max-mob:pt-[72px]"
    >
      {
        services.map((service, i) => (
          <>
            {i > 0 && (
              <hr class="my-[80px] border-0 border-t border-line-strong max-mob:my-[56px]" />
            )}
            <AlternatingRow
              id={service.slug}
              title={service.title}
              image={service.image}
              flip={i % 2 === 1}
            >
              <Fragment slot="meta">
                <div class="flex items-center gap-[14px]">
                  <span class="flex h-[30px] w-[30px] items-center justify-center rounded-sm bg-brand-tint text-brand">
                    <Icon name={service.icon} size={16} />
                  </span>
                  <span class="font-mono text-caption tracking-[0.5px] text-brand">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
              </Fragment>

              <p class="mt-5 text-lead leading-relaxed text-body">
                {service.body}
              </p>

              <ul class="mt-7 grid grid-cols-2 gap-x-6 gap-y-[9px] max-cmp:grid-cols-1">
                {service.points.map((point) => (
                  <li class="flex gap-[11px] text-detail leading-[1.45] font-medium text-body">
                    <Icon
                      name="check"
                      size={15}
                      class="mt-[4px] shrink-0 text-brand"
                    />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <Fragment slot="actions">
                {/* Four of the six services are not equipment supply, so this
                    opens the form at section 01 rather than pre-answering it —
                    the machine is not known here (docs 14 §10c). */}
                <Button
                  variant="primary"
                  href="/contact"
                  data-quote-open
                  class="press"
                >
                  {service.cta}
                </Button>
                <Button
                  variant="outline"
                  href={enquire(service.title)}
                  target="_blank"
                  rel="noopener"
                  class="press"
                >
                  <Icon name="whatsapp" size={16} />
                  WhatsApp
                </Button>
              </Fragment>
            </AlternatingRow>
          </>
        ))
      }
    </RailSections>
  </Section>

  <!-- Beat 4 — the internal link that stops /services and /equipment
       competing for the same intent and makes them reinforce each other. -->
  <Section class="py-[80px] max-mob:py-[56px]">
    <div class="wrap">
      <ClosingNote
        body={servicesSection.crossSell.body}
        cta={servicesSection.crossSell.cta}
      />
    </div>
  </Section>

  <PageCTA />
</Base>
