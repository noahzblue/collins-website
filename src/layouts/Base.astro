---
/**
 * The page shell every route renders inside: <head>, the sticky header, the
 * page body, the footer and the floating quick-contact buttons.
 *
 * Pages supply only their own content — chrome is never imported per page, so
 * a new route cannot ship without a header or footer.
 */
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import FloatingButtons from "@/components/layout/FloatingButtons.astro";
import QuoteDialog from "@/components/quote/QuoteDialog.astro";
// PAUSED — the logo onboarding sequence is switched off for now. Restore by
// un-commenting this import, the `isHome` const and the <Intro /> below;
// nothing else depends on it (Hero's hold is keyed off `html[data-intro]`,
// which simply never appears while this is off).
// import Intro from "@/components/layout/Intro.astro";
import { site } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  /** Keep this route out of the index. Dev-only pages set it (see
   *  `pages/lab/`), which pairs with the sitemap filter in astro.config.mjs —
   *  a static build emits the HTML whether or not anything links to it. */
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

/* The logo intro is a title card, not a signpost — a visitor who landed on
   /equipment/generators from a search wants the generators. Homepage only. */
// const isHome = Astro.url.pathname === "/";

/**
 * LocalBusiness JSON-LD, built entirely from config/site.ts. This is what puts
 * the hours, the phone numbers and both locations into Google's local panel —
 * everything it needs is already the single source of truth, so it can't drift
 * from what the pages say.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  description: site.seo.description,
  url: site.url,
  email: site.email,
  telephone: site.phones.map((p) => p.display),
  address: {
    "@type": "PostalAddress",
    streetAddress: "Ras Al Khor 2",
    addressLocality: "Dubai",
    addressCountry: "AE",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.places.office.geo.lat,
    longitude: site.places.office.geo.lng,
  },
  openingHours: site.hoursSchema,
  areaServed: "United Arab Emirates",
  identifier: {
    "@type": "PropertyValue",
    name: `Trade licence register — ${site.licensingAuthority}`,
    value: site.register,
  },
  // The yard is a second real place doing a different job, not a duplicate.
  location: {
    "@type": "Place",
    name: `${site.name} — yard`,
    address: {
      "@type": "PostalAddress",
      streetAddress: "Sajjah",
      addressLocality: "Sharjah",
      addressCountry: "AE",
    },
  },
  sameAs: site.social.filter((s) => s.href !== "#").map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
    <!-- Client-side routing: the next page swaps in without a reload, so the
         header, hero video and marquee never flash or restart on navigation.
         Scripts that touch the DOM carry `data-astro-rerun`. The swap itself
         is animated by the view-transition rules in styles/global.css. -->
    <ClientRouter />

    <!-- Smooth scroll. Deliberately NOT `data-astro-rerun`: this script runs
         once per document, so a page swap can't stack a second Lenis (and a
         second rAF loop) on top of the first. See docs/site-expansion/02. -->
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const lenis = new Lenis({
        autoRaf: true,
        // Anchor jumps land 104px down — `--spacing-header-gap`, the token the
        // floating header occupies. Lenis does its own scrolling and never
        // reads `scroll-padding-top`, so the bare `anchors: true` would put the
        // target underneath the header.
        anchors: { offset: -104 },
        // Start/stop with the wrapper's `overflow`, so `overflow: hidden` on
        // <body> (mobile nav, any modal) freezes the page without a manual
        // stop()/start() pair that can get stuck.
        autoToggle: true,
        allowNestedScroll: true,
        stopInertiaOnNavigate: true,
        // Higher = less smoothing. Library default is 0.1, which reads as lag
        // on a site that gets scanned for spec ranges.
        lerp: 0.55,
        // `respectReducedMotion` defaults to true — do not turn it off.
      });

      // The client router replaces the body and restores scroll itself. Re-measure
      // the new page, and adopt whatever position the router set so Lenis doesn't
      // animate a slide from the old one.
      document.addEventListener("astro:after-swap", () => {
        lenis.resize();
        lenis.scrollTo(window.scrollY, { immediate: true, force: true });
      });
    </script>
  </head>
  <body>
    {/* {isHome && <Intro />} */}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingButtons />
    {
      /* Mounted once per document, beside the floating buttons and for the
        same reason: it is chrome that belongs to every page rather than to
        any one of them. Anything carrying `data-quote-open` opens it, and so
        does `?quote=1` on any URL — which is what replaces the route the form
        deliberately does not have (docs/site-expansion/14 §2, §9). */
    }
    <QuoteDialog />
  </body>
</html>
