---
/**
 * The page shell every route renders inside: <head>, the sticky header, the
 * page body, the footer and the floating quick-contact buttons.
 *
 * Pages supply only their own content — chrome is never imported per page, so
 * a new route cannot ship without a header or footer.
 */
import "@/styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import FloatingButtons from "@/components/layout/FloatingButtons.astro";
import { site } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingButtons />
  </body>
</html>
