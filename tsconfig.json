{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // Import from anywhere as "@/…" instead of counting "../../".
    // Astro/Vite read these paths directly — no extra plugin needed.
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
