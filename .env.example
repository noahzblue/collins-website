# Copy to `.env` for local work. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.

# ── Email (required for the quote form to send) ─────────────────────
# The mailbox the website sends from: GoDaddy Professional Email.
SMTP_USER=website@collinscouae.com
SMTP_PASSWORD=

# Optional. These are GoDaddy's defaults, so leave them out unless the
# mailbox moves to another provider.
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465

# Optional. Where quote requests are delivered. Comma-separated for more
# than one. Left out, they go to info@collinscouae.com.
QUOTE_TO_EMAIL=info@collinscouae.com

# ── Database (optional, recommended) ────────────────────────────────
# Postgres connection string. Every quote request is saved here before it
# is emailed, with whether the email went out. Create the table once with
# `bun run db:migrate`. Left out, requests are emailed but not kept.
#
# Local: start the container with `docker compose -f db/compose.yml up -d`.
# This URL works from inside devbox (where bun runs):
DATABASE_URL=postgres://collins:collins_local@collins-pg:5432/collins
#
# Production (Vercel): the Neon pooled URL, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
